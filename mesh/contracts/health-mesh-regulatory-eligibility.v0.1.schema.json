{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axiom:contract:health-mesh-regulatory-eligibility:v0.1",
  "title": "AXIOM Health Mesh Regulatory Eligibility v0.1",
  "description": "Planning-only envelope for externally sourced jurisdiction/credential/facility/device/workflow eligibility evidence. AXIOM does not create legal or clinical authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assertion_id",
    "jurisdiction",
    "assertion_class",
    "authority_level",
    "subject",
    "action_scope",
    "eligibility_state",
    "evidence_refs",
    "effective_at",
    "absence_behavior",
    "axiom_may_expand_scope",
    "runtime_authority_granted",
    "regulatory_truth_claimed_by_axiom"
  ],
  "properties": {
    "schema": {"const": "axiom-health-mesh-regulatory-eligibility.v0.1"},
    "assertion_id": {"type": "string", "pattern": "^health-reg:[a-z0-9._-]+$"},
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "region"],
      "properties": {
        "country": {"type": "string", "minLength": 2, "maxLength": 3},
        "region": {"type": "string", "minLength": 1},
        "locality": {"type": ["string", "null"]}
      }
    },
    "assertion_class": {
      "type": "string",
      "enum": [
        "RESEARCH_ONLY",
        "REGULATORY_GUIDANCE",
        "LICENSE_OR_CERTIFICATION",
        "PROFESSIONAL_CREDENTIAL",
        "FACILITY_AUTHORIZATION",
        "DEVICE_AUTHORIZATION",
        "WORKFLOW_AUTHORIZATION"
      ]
    },
    "authority_level": {
      "type": "string",
      "enum": ["NON_AUTHORITATIVE_RESEARCH", "AUTHORITATIVE_SOURCE", "VERIFIED_AUTHORIZATION"]
    },
    "issuer": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["issuer_id", "issuer_type"],
      "properties": {
        "issuer_id": {"type": "string", "minLength": 1},
        "issuer_type": {"type": "string", "enum": ["REGULATOR", "LICENSING_BODY", "PROFESSIONAL_COLLEGE", "HEALTH_SYSTEM", "ORGANIZATION", "RESEARCH_PROCESS"]},
        "verification_ref": {"type": ["string", "null"]}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_type", "subject_id"],
      "properties": {
        "subject_type": {"type": "string", "enum": ["HUMAN", "ORGANIZATION", "FACILITY", "DEVICE", "MODEL", "WORKFLOW", "COMPOSITE"]},
        "subject_id": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]}
      }
    },
    "action_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_actions", "prohibited_actions"],
      "properties": {
        "allowed_actions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "prohibited_actions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "eligibility_state": {
      "type": "string",
      "enum": ["ESTABLISHED", "CONDITIONAL", "INTERPRETATION_REQUIRED", "NOT_ESTABLISHED", "SUSPENDED", "EXPIRED"]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "locator", "digest_or_version"],
        "properties": {
          "kind": {"type": "string", "enum": ["STATUTE", "REGULATION", "GUIDANCE", "LICENSE", "CREDENTIAL", "CERTIFICATE", "POLICY", "OTHER"]},
          "locator": {"type": "string", "minLength": 1},
          "digest_or_version": {"type": "string", "minLength": 1}
        }
      }
    },
    "effective_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "revocation_ref": {"type": ["string", "null"]},
    "required_autonomy_ceiling": {"type": ["string", "null"], "enum": ["H0", "H1", "H2", "H3", "H4", "H5", null]},
    "absence_behavior": {"const": "DENY_CONSEQUENTIAL"},
    "axiom_may_expand_scope": {"const": false},
    "runtime_authority_granted": {"const": false},
    "regulatory_truth_claimed_by_axiom": {"const": false},
    "non_claims": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
