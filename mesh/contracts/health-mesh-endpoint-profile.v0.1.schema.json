{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axiom:contract:health-mesh-endpoint-profile:v0.1",
  "title": "AXIOM Health Mesh Endpoint Profile v0.1",
  "description": "Planning-only identity, module, data-class, calibration and safety profile for a clinical endpoint such as a health booth. Registration grants no clinical or runtime authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "endpoint_id",
    "endpoint_class",
    "jurisdiction",
    "operator",
    "modules",
    "data_governance",
    "local_safety",
    "emergency_interface",
    "registration_grants_authority",
    "runtime_authority_granted",
    "clinical_authorization_claimed"
  ],
  "properties": {
    "schema": {"const": "axiom-health-mesh-endpoint-profile.v0.1"},
    "endpoint_id": {"type": "string", "pattern": "^health-endpoint:[a-z0-9._-]+$"},
    "endpoint_class": {
      "type": "string",
      "enum": ["HEALTH_BOOTH", "IMAGING_SITE", "LABORATORY_ENDPOINT", "HOME_ENDPOINT", "MOBILE_CLINICAL_ENDPOINT", "OTHER"]
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "region"],
      "properties": {
        "country": {"type": "string", "minLength": 2, "maxLength": 3},
        "region": {"type": "string", "minLength": 1},
        "locality": {"type": ["string", "null"]}
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator_id", "operator_class"],
      "properties": {
        "operator_id": {"type": "string", "minLength": 1},
        "operator_class": {"type": "string", "enum": ["HEALTH_SYSTEM", "LICENSED_FACILITY", "PUBLIC_AGENCY", "RESEARCH_OPERATOR", "OTHER"]},
        "facility_authorization_ref": {"type": ["string", "null"]}
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module_id",
          "module_class",
          "hardware_identity",
          "software_identity",
          "data_classes",
          "planning_autonomy_ceiling",
          "regulatory_eligibility_refs",
          "calibration_or_qc",
          "runnable_clinical_action_granted"
        ],
        "properties": {
          "module_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
          "module_class": {
            "type": "string",
            "enum": [
              "IDENTITY_INTERFACE",
              "CONVERSATIONAL_INTERFACE",
              "VITAL_SIGNS",
              "ECG",
              "VISION_ACUITY",
              "RETINAL_CAMERA",
              "GENERAL_CAMERA",
              "AUDIO_HEARING",
              "OTOSCOPE",
              "SPIROMETRY",
              "POINT_OF_CARE_ANALYZER",
              "CAPILLARY_COLLECTION",
              "VEIN_LOCALIZATION",
              "VENIPUNCTURE_ROBOT",
              "SPECIMEN_HANDLER",
              "SAFETY_MONITOR",
              "GUIDANCE_INTERFACE",
              "OTHER"
            ]
          },
          "hardware_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["manufacturer", "model", "hardware_version", "serial_or_asset_ref"],
            "properties": {
              "manufacturer": {"type": "string", "minLength": 1},
              "model": {"type": "string", "minLength": 1},
              "hardware_version": {"type": "string", "minLength": 1},
              "serial_or_asset_ref": {"type": "string", "minLength": 1}
            }
          },
          "software_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["software_id", "version", "digest"],
            "properties": {
              "software_id": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "model_id": {"type": ["string", "null"]},
              "model_version": {"type": ["string", "null"]}
            }
          },
          "data_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "IDENTITY",
                "STRUCTURED_HEALTH_DATA",
                "PHYSIOLOGICAL_SIGNAL",
                "CLINICAL_IMAGE",
                "TRANSIENT_SENSITIVE_VIDEO",
                "TRANSIENT_SENSITIVE_AUDIO",
                "SPECIMEN_METADATA",
                "DEVICE_TELEMETRY",
                "SAFETY_EVENT"
              ]
            }
          },
          "planning_autonomy_ceiling": {"type": "string", "enum": ["H0", "H1", "H2", "H3", "H4", "H5"]},
          "intended_use": {"type": ["string", "null"]},
          "regulatory_eligibility_refs": {
            "type": "array",
            "items": {"type": "string", "pattern": "^health-reg:[a-z0-9._-]+$"},
            "uniqueItems": true
          },
          "calibration_or_qc": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "state", "last_verified_at"],
            "properties": {
              "required": {"type": "boolean"},
              "state": {"type": "string", "enum": ["VERIFIED", "DUE", "FAILED", "NOT_APPLICABLE", "UNKNOWN"]},
              "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
              "evidence_ref": {"type": ["string", "null"]}
            }
          },
          "planned_action_identifiers": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "runnable_clinical_action_granted": {"const": false}
        }
      }
    },
    "data_governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_necessary", "transient_media_default", "raw_media_export_default", "patient_identity_separation"],
      "properties": {
        "minimum_necessary": {"const": true},
        "transient_media_default": {"type": "string", "enum": ["LOCAL_EPHEMERAL", "PURPOSE_BOUND_BUFFER"]},
        "raw_media_export_default": {"const": "DENY"},
        "patient_identity_separation": {"const": true},
        "retention_policy_ref": {"type": ["string", "null"]}
      }
    },
    "local_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_independent_stop", "physical_fail_safe", "supervision_loss_state"],
      "properties": {
        "model_independent_stop": {"const": true},
        "physical_fail_safe": {"const": true},
        "supervision_loss_state": {"type": "string", "enum": ["HALT_BEFORE_NEXT_EFFECT", "SAFE_LOCAL_STATE"]},
        "safety_controller_identity": {"type": ["string", "null"]}
      }
    },
    "emergency_interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_request_help", "may_directly_dispatch_resources", "minimum_necessary_payload"],
      "properties": {
        "may_request_help": {"type": "boolean"},
        "may_directly_dispatch_resources": {"const": false},
        "minimum_necessary_payload": {"const": true},
        "request_capability_identifier": {"type": ["string", "null"]}
      }
    },
    "registration_grants_authority": {"const": false},
    "runtime_authority_granted": {"const": false},
    "clinical_authorization_claimed": {"const": false},
    "secret_material_included": {"const": false},
    "non_claims": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
