{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axiom:contract:health-mesh-workflow:v0.1",
  "title": "AXIOM Health Mesh Workflow v0.1",
  "description": "Planning-only contract for bounded clinical workflows; it grants no runtime or medical authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workflow_id", "workflow_class", "jurisdiction", "maximum_autonomy_level", "steps", "escalation_policy", "evidence_requirements", "runtime_authority_granted", "clinical_authorization_claimed"],
  "properties": {
    "schema": {"const": "axiom-health-mesh-workflow.v0.1"},
    "workflow_id": {"type": "string", "pattern": "^health:[a-z0-9._-]+$"},
    "workflow_class": {"type": "string", "enum": ["NON_INVASIVE_ASSESSMENT", "SPECIMEN_COLLECTION", "POST_PROCEDURE_OBSERVATION", "DIAGNOSTIC_ROUTING", "EMERGENCY_ESCALATION", "OTHER"]},
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "region", "regulatory_profile"],
      "properties": {
        "country": {"type": "string", "minLength": 2, "maxLength": 3},
        "region": {"type": "string", "minLength": 1},
        "regulatory_profile": {"type": "string", "minLength": 1}
      }
    },
    "maximum_autonomy_level": {"type": "string", "enum": ["H0", "H1", "H2", "H3", "H4", "H5"]},
    "subject_binding_required": {"const": true},
    "encounter_binding_required": {"const": true},
    "consent_required": {"const": true},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "kind", "autonomy_level", "effect_class", "required_inputs", "required_evidence", "failure_behavior"],
        "properties": {
          "step_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
          "kind": {"type": "string", "enum": ["IDENTITY", "CONSENT", "INTERVIEW", "SENSOR_CAPTURE", "MODEL_ANALYSIS", "HUMAN_REVIEW", "DEVICE_POSITIONING", "INVASIVE_COLLECTION", "SPECIMEN_HANDOFF", "OBSERVATION", "PATIENT_PROMPT", "REMOTE_ESCALATION", "EMERGENCY_REQUEST", "RECORD_WRITE", "HALT"]},
          "autonomy_level": {"type": "string", "enum": ["H0", "H1", "H2", "H3", "H4", "H5"]},
          "effect_class": {"type": "string", "enum": ["NO_EFFECT", "INFORMATIONAL", "CLINICAL_DATA_CAPTURE", "PHYSICAL_NON_INVASIVE", "PHYSICAL_INVASIVE", "EXTERNAL_CLINICAL", "EMERGENCY_EXTERNAL"]},
          "required_inputs": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "required_capabilities": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "required_supervision": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["mode", "credential_class", "loss_behavior"],
            "properties": {
              "mode": {"type": "string", "enum": ["ONSITE", "REMOTE_SYNCHRONOUS", "REMOTE_AVAILABLE"]},
              "credential_class": {"type": "string", "minLength": 1},
              "loss_behavior": {"type": "string", "enum": ["HALT_BEFORE_NEXT_EFFECT", "COMPLETE_CURRENT_ATOMIC_STEP_THEN_HALT", "SAFE_LOCAL_SHUTDOWN"]}
            }
          },
          "required_evidence": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "success_next": {"type": ["string", "null"]},
          "failure_next": {"type": ["string", "null"]},
          "failure_behavior": {"type": "string", "enum": ["HALT", "SAFE_LOCAL_STATE", "REQUIRE_HUMAN", "REQUIRE_REMOTE_CLINICIAN", "REQUEST_EMERGENCY_EVALUATION"]},
          "retry_policy": {"type": "string", "enum": ["NO_RETRY", "IDEMPOTENT_ONLY", "EXPLICIT_HUMAN_REAUTHORIZE"]}
        }
      }
    },
    "escalation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supervision_loss_cannot_raise_autonomy", "emergency_authority_is_separate", "uncertain_physical_effects_are_not_retried"],
      "properties": {
        "supervision_loss_cannot_raise_autonomy": {"const": true},
        "emergency_authority_is_separate": {"const": true},
        "uncertain_physical_effects_are_not_retried": {"const": true},
        "ordinary_escalation_target": {"type": ["string", "null"]},
        "emergency_capability_class": {"type": ["string", "null"]}
      }
    },
    "evidence_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bind_subject", "bind_encounter", "bind_device", "bind_model", "bind_policy", "bind_result", "record_uncertainty"],
      "properties": {
        "bind_subject": {"const": true},
        "bind_encounter": {"const": true},
        "bind_device": {"const": true},
        "bind_model": {"const": true},
        "bind_policy": {"const": true},
        "bind_result": {"const": true},
        "record_uncertainty": {"const": true},
        "raw_sensitive_media_retention": {"type": "string", "enum": ["PROHIBITED_BY_DEFAULT", "PURPOSE_BOUND", "JURISDICTION_POLICY"]}
      }
    },
    "runtime_authority_granted": {"const": false},
    "clinical_authorization_claimed": {"const": false},
    "non_claims": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
