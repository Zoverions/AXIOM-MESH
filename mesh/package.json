{
  "name": "@axiom-mesh/kernel",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "bootstrap": "node src/bootstrap.mjs",
    "dev": "node src/dev.mjs",
    "provision:production": "node src/provision-production.mjs",
    "rotate:production": "node src/rotate-production.mjs",
    "rotate:data-key": "node src/rotate-data-key.mjs",
    "backup:maintain": "node src/backup-maintenance.mjs",
    "backup-lifecycle:drill": "node src/backup-lifecycle-drill.mjs",
    "credential-history:audit": "node src/credential-history-audit.mjs verify",
    "credential-rotation:drill": "node src/credential-rotation-drill.mjs",
    "data-key-rotation:drill": "node src/data-key-rotation-drill.mjs",
    "recovery:drill": "node src/recovery-drill.mjs",
    "slo:drill": "node src/slo-drill.mjs",
    "start:production": "node src/supervisor.mjs",
    "verify-export": "node src/verify-export.mjs",
    "verify-sync": "node src/verify-sync.mjs",
    "check-registry": "node src/check-registry.mjs",
    "docs:check": "node src/check-docs.mjs",
    "status:generate": "node src/status.mjs --write",
    "status:check": "node src/status.mjs",
    "release:verify": "node src/release.mjs",
    "release:evidence": "npm run check && node src/release.mjs --write",
    "test": "node --test --test-reporter=spec",
    "check": "node src/check-registry.mjs && node src/status.mjs && node src/check-docs.mjs && node --test --test-reporter=spec"
  }
}
