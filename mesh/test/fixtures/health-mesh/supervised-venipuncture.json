{
  "schema": "axiom-health-mesh-workflow.v0.1",
  "workflow_id": "health:booth.supervised-venipuncture.v0.1",
  "workflow_class": "SPECIMEN_COLLECTION",
  "jurisdiction": {
    "country": "CA",
    "region": "ON",
    "regulatory_profile": "planning-only-ontario-v0.1"
  },
  "maximum_autonomy_level": "H3",
  "subject_binding_required": true,
  "encounter_binding_required": true,
  "consent_required": true,
  "steps": [
    {
      "step_id": "identity",
      "kind": "IDENTITY",
      "autonomy_level": "H1",
      "effect_class": "INFORMATIONAL",
      "required_inputs": ["presented_identity"],
      "required_evidence": ["subject_binding"],
      "failure_behavior": "HALT",
      "retry_policy": "IDEMPOTENT_ONLY",
      "success_next": "consent",
      "failure_next": "halt"
    },
    {
      "step_id": "consent",
      "kind": "CONSENT",
      "autonomy_level": "H1",
      "effect_class": "INFORMATIONAL",
      "required_inputs": ["procedure", "risks", "data_scope"],
      "required_evidence": ["consent_record", "procedure_binding"],
      "failure_behavior": "HALT",
      "retry_policy": "NO_RETRY",
      "success_next": "supervision-check",
      "failure_next": "halt"
    },
    {
      "step_id": "supervision-check",
      "kind": "HUMAN_REVIEW",
      "autonomy_level": "H2",
      "effect_class": "INFORMATIONAL",
      "required_inputs": ["supervisor_presence", "supervisor_credential"],
      "required_evidence": ["supervisor_identity", "credential_validation", "live_session_binding"],
      "failure_behavior": "HALT",
      "retry_policy": "IDEMPOTENT_ONLY",
      "success_next": "position",
      "failure_next": "halt"
    },
    {
      "step_id": "position",
      "kind": "DEVICE_POSITIONING",
      "autonomy_level": "H3",
      "effect_class": "PHYSICAL_NON_INVASIVE",
      "required_inputs": ["approved_collection_device", "vein_localization_input"],
      "required_capabilities": ["health.specimen.position.supervised"],
      "required_supervision": {
        "mode": "REMOTE_SYNCHRONOUS",
        "credential_class": "authorized-phlebotomy-supervisor",
        "loss_behavior": "HALT_BEFORE_NEXT_EFFECT"
      },
      "required_evidence": ["device_identity", "device_state", "supervision_binding", "positioning_result"],
      "failure_behavior": "REQUIRE_HUMAN",
      "retry_policy": "EXPLICIT_HUMAN_REAUTHORIZE",
      "success_next": "collect",
      "failure_next": "human-takeover"
    },
    {
      "step_id": "collect",
      "kind": "INVASIVE_COLLECTION",
      "autonomy_level": "H3",
      "effect_class": "PHYSICAL_INVASIVE",
      "required_inputs": ["approved_collection_plan", "target_confirmation", "supervision_binding"],
      "required_capabilities": ["health.specimen.venipuncture.supervised"],
      "required_supervision": {
        "mode": "REMOTE_SYNCHRONOUS",
        "credential_class": "authorized-phlebotomy-supervisor",
        "loss_behavior": "COMPLETE_CURRENT_ATOMIC_STEP_THEN_HALT"
      },
      "required_evidence": ["device_identity", "supervision_binding", "collection_start", "collection_terminal_state", "sample_identity"],
      "failure_behavior": "REQUIRE_HUMAN",
      "retry_policy": "EXPLICIT_HUMAN_REAUTHORIZE",
      "success_next": "handoff",
      "failure_next": "human-takeover"
    },
    {
      "step_id": "handoff",
      "kind": "SPECIMEN_HANDOFF",
      "autonomy_level": "H2",
      "effect_class": "CLINICAL_DATA_CAPTURE",
      "required_inputs": ["sample_identity", "ordered_tests"],
      "required_evidence": ["sample_label_binding", "chain_of_custody_receipt", "collection_quality_state"],
      "failure_behavior": "REQUIRE_HUMAN",
      "retry_policy": "NO_RETRY",
      "success_next": "observe",
      "failure_next": "human-takeover"
    },
    {
      "step_id": "observe",
      "kind": "OBSERVATION",
      "autonomy_level": "H2",
      "effect_class": "CLINICAL_DATA_CAPTURE",
      "required_inputs": ["post_collection_sensor_set"],
      "required_evidence": ["observation_start", "vital_signs_binding", "observation_terminal_state"],
      "failure_behavior": "REQUIRE_REMOTE_CLINICIAN",
      "retry_policy": "IDEMPOTENT_ONLY",
      "success_next": null,
      "failure_next": "human-takeover"
    },
    {
      "step_id": "human-takeover",
      "kind": "HUMAN_REVIEW",
      "autonomy_level": "H1",
      "effect_class": "INFORMATIONAL",
      "required_inputs": ["exception_context"],
      "required_evidence": ["reviewer_identity", "takeover_disposition"],
      "failure_behavior": "HALT",
      "retry_policy": "NO_RETRY",
      "success_next": null,
      "failure_next": "halt"
    },
    {
      "step_id": "halt",
      "kind": "HALT",
      "autonomy_level": "H0",
      "effect_class": "NO_EFFECT",
      "required_inputs": [],
      "required_evidence": ["halt_reason"],
      "failure_behavior": "HALT",
      "retry_policy": "NO_RETRY",
      "success_next": null,
      "failure_next": null
    }
  ],
  "escalation_policy": {
    "supervision_loss_cannot_raise_autonomy": true,
    "emergency_authority_is_separate": true,
    "uncertain_physical_effects_are_not_retried": true,
    "ordinary_escalation_target": "authorized-phlebotomy-supervisor",
    "emergency_capability_class": "health.emergency.request.v0"
  },
  "evidence_requirements": {
    "bind_subject": true,
    "bind_encounter": true,
    "bind_device": true,
    "bind_model": true,
    "bind_policy": true,
    "bind_result": true,
    "record_uncertainty": true,
    "raw_sensitive_media_retention": "PURPOSE_BOUND"
  },
  "runtime_authority_granted": false,
  "clinical_authorization_claimed": false,
  "non_claims": [
    "No autonomous invasive procedure is enabled.",
    "No regulatory authorization is claimed.",
    "The named capabilities are planning identifiers and are not present in production policy."
  ]
}
