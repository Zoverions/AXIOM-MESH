{
  "catalog": [
    {
      "name": "installation-authority",
      "expected_error": "install authority",
      "changes": [
        {"path": ["requested_access", "install_grants_authority"], "value": true}
      ]
    },
    {
      "name": "mutable-source-ref",
      "expected_error": "mutable source",
      "changes": [
        {"path": ["provenance", "mutable_ref_allowed"], "value": true}
      ]
    },
    {
      "name": "missing-source-commit",
      "expected_error": "requires repository and immutable commit",
      "changes": [
        {"path": ["provenance", "source_commit"], "remove": true}
      ]
    },
    {
      "name": "noncanonical-source-commit-length",
      "expected_error": "source_commit is invalid",
      "changes": [
        {"path": ["provenance", "source_commit"], "value": "11111111111111111111111111111111111111111"}
      ]
    },
    {
      "name": "silent-permission-widening",
      "expected_error": "silent permission widening",
      "changes": [
        {"path": ["lifecycle", "silent_permission_widening_allowed"], "value": true}
      ]
    },
    {
      "name": "catalog-cannot-self-assert-review-or-promotion-label",
      "expected_error": "unsupported field review_state",
      "changes": [
        {"path": ["subject", "review_state"], "value": "promoted"}
      ]
    },
    {
      "name": "community-curation-is-not-assurance",
      "expected_error": "claim_type",
      "changes": [
        {
          "path": ["assurance", "observations"],
          "value": [
            {
              "claim_type": "community-curation",
              "observer_id": "observer:test",
              "subject_ref": "runtime:synthetic-reference",
              "observed_at": "2026-08-21T23:31:00Z",
              "result": "pass",
              "evidence_uri": "https://example.invalid/evidence/curation"
            }
          ]
        }
      ]
    },
    {
      "name": "assurance-observation-requires-evidence-reference",
      "expected_error": "requires an evidence digest or URI",
      "changes": [
        {
          "path": ["assurance", "observations"],
          "value": [
            {
              "claim_type": "source-review",
              "observer_id": "observer:test",
              "subject_ref": "runtime:synthetic-reference",
              "observed_at": "2026-08-21T23:31:00Z",
              "result": "pass"
            }
          ]
        }
      ]
    },
    {
      "name": "malformed-evidence-digest",
      "expected_error": "evidence_sha256",
      "changes": [
        {
          "path": ["assurance", "observations"],
          "value": [
            {
              "claim_type": "source-review",
              "observer_id": "observer:test",
              "subject_ref": "runtime:synthetic-reference",
              "observed_at": "2026-08-21T23:31:00Z",
              "result": "pass",
              "evidence_sha256": "not-a-digest"
            }
          ]
        }
      ]
    },
    {
      "name": "malformed-evidence-uri",
      "expected_error": "must be a URI",
      "changes": [
        {
          "path": ["assurance", "observations"],
          "value": [
            {
              "claim_type": "source-review",
              "observer_id": "observer:test",
              "subject_ref": "runtime:synthetic-reference",
              "observed_at": "2026-08-21T23:31:00Z",
              "result": "pass",
              "evidence_uri": "not a uri"
            }
          ]
        }
      ]
    },
    {
      "name": "evidence-freshness-cannot-precede-observation",
      "expected_error": "fresh_until precedes observed_at",
      "changes": [
        {
          "path": ["assurance", "observations"],
          "value": [
            {
              "claim_type": "source-review",
              "observer_id": "observer:test",
              "subject_ref": "runtime:synthetic-reference",
              "observed_at": "2026-08-21T23:31:00Z",
              "fresh_until": "2026-08-20T23:31:00Z",
              "result": "pass",
              "evidence_uri": "https://example.invalid/evidence/source-review"
            }
          ]
        }
      ]
    },
    {
      "name": "no-network-profile-cannot-list-destinations",
      "expected_error": "no-network integration",
      "changes": [
        {"path": ["requested_access", "network_destinations"], "value": ["https://example.invalid"]}
      ]
    },
    {
      "name": "network-required-profile-needs-explicit-destination",
      "expected_error": "needs explicit destinations",
      "changes": [
        {"path": ["requested_access", "network_required"], "value": true},
        {"path": ["requested_access", "network_destinations"], "value": []}
      ]
    },
    {
      "name": "catalog-cost-needs-explicit-currency",
      "expected_error": "currency",
      "changes": [
        {
          "path": ["requested_access", "resource_bounds"],
          "value": {
            "cost_ceiling": {
              "amount_minor_units": 100,
              "currency": "usd"
            }
          }
        }
      ]
    }
  ],
