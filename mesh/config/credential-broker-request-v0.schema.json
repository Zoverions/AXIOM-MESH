{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schema/credential-broker-request-v0.schema.json",
  "title": "AXIOM Credential Broker Request v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "request_id",
    "principal_id",
    "provider_id",
    "credential_ref",
    "credential_class",
    "exact_action",
    "purpose",
    "exact_destination",
    "prepared_effect_digest",
    "issued_at",
    "expires_at",
    "single_use",
    "requires_human_approval",
    "authority_effect",
    "network_effect",
    "broker_invocation"
  ],
  "properties": {
    "schema": { "const": "axiom-credential-broker-request.v0" },
    "version": { "const": 0 },
    "status": { "const": "inert-contract-laboratory" },
    "request_id": { "$ref": "#/$defs/identifier" },
    "principal_id": { "$ref": "#/$defs/identifier" },
    "provider_id": { "$ref": "#/$defs/identifier" },
    "credential_ref": { "$ref": "#/$defs/identifier" },
    "credential_class": {
      "enum": ["password", "passkey", "totp", "oauth-token", "api-key", "client-certificate", "session", "signing-key", "other"]
    },
    "exact_action": { "$ref": "#/$defs/identifier" },
    "purpose": { "$ref": "#/$defs/identifier" },
    "exact_destination": { "type": "string", "pattern": "^https://", "maxLength": 512 },
    "prepared_effect_digest": { "$ref": "#/$defs/digest" },
    "issued_at": { "type": "string", "format": "date-time", "maxLength": 64 },
    "expires_at": { "type": "string", "format": "date-time", "maxLength": 64 },
    "single_use": { "const": true },
    "requires_human_approval": { "const": true },
    "authority_effect": { "const": "none" },
    "network_effect": { "const": "none" },
    "broker_invocation": { "const": false }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "x-axiom-semantic-validator": "mesh/src/lib/credential-broker-contract.mjs",
  "x-axiom-non-claims": [
    "credential-release",
    "credential-retrieval",
    "broker-invocation",
    "browser-automation",
    "network-egress",
    "authority-grant",
    "replay-ledger"
  ]
}
