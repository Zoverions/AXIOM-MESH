  "threats": [
    {
      "id": "charter-digest-substitution",
      "mitigations": [
        "charter-digest-recomputed",
        "stored-charter-digest-must-match-canonical-charter"
      ],
      "residual_limit": "digest binding proves consistency of the represented record but does not prove who legitimately authored or approved it"
    },
    {
      "id": "parallel-charter-heads-or-history-fork",
      "mitigations": [
        "single-ordered-entry-sequence",
        "one-exact-predecessor-digest",
        "current-circle-charter-equals-final-head"
      ],
      "residual_limit": "v0 represents one locally accepted history and does not provide distributed fork choice or consensus"
    },
    {
      "id": "version-skip-or-rollback",
      "mitigations": [
        "genesis-version-one",
        "contiguous-version-sequence",
        "unique-charter-digests"
      ],
      "residual_limit": "contiguous local versions prevent structural rollback in this lifecycle but do not prove external parties observed every amendment"
    },
    {
      "id": "retroactive-or-backdated-activation",
      "mitigations": [
        "recorded-at-not-after-effective-from",
        "strict-effective-time-increase",
        "activation-time-equals-charter-effective-from",
        "record-and-effective-time-not-before-circle-creation"
      ],
      "residual_limit": "canonical chronology does not independently attest trusted real-world time or prevent a trusted recorder from lying before admission"
    },
    {
      "id": "future-charter-misrepresented-as-active",
      "mitigations": [
        "activated-entries-only",
        "future-activation-rejected",
        "historical-resolution-cannot-project-into-future"
      ],
      "residual_limit": "scheduled future amendment semantics are intentionally absent rather than inferred from activated history"
    },
    {
      "id": "stale-charter-applied-to-historical-action",
      "mitigations": [
        "historical-resolution-by-effective-time",
        "resolved-charter-digest-returned",
        "lifecycle-digest-bound-to-resolution",
        "resolved-charter-deeply-frozen"
      ],
      "residual_limit": "future action and decision records must explicitly bind this resolved digest; this inert resolver does not mutate or revalidate existing records"
    },
    {
      "id": "activation-evidence-authority-laundering",
      "mitigations": [
        "activation-evidence-reference-required",
        "activation-evidence-reference-canonicalized",
        "activation-record-creates-runtime-authority-false",
        "authority-effect-none"
      ],
      "residual_limit": "an evidence reference records provenance only and does not establish truth, legitimacy, quorum, consent, or authorization"
    },
    {
      "id": "cross-circle-charter-confusion",
      "mitigations": [
        "exact-circle-id-on-lifecycle-entry-and-activation",
        "historical-charter-validated-against-circle-descriptor"
      ],
      "residual_limit": "no cross-Circle charter recognition, treaty inheritance, or federated constitutional authority is implemented"
    },
    {
      "id": "role-or-runtime-authority-confusion",
      "mitigations": [
        "historical-charters-revalidated-through-circle-core",
        "historical-role-execution-authority-false",
        "charter-history-runtime-authority-false"
      ],
      "residual_limit": "a valid historical role declaration describes Circle rules but cannot itself grant Sandbox, Grid, repository, legal, or coercive authority"
    },
    {
      "id": "activation-clock-trust",
      "mitigations": [
        "canonical-utc-timestamps",
        "strict-local-time-ordering",
        "future-resolution-rejected",
        "circle-creation-time-lower-bound"
      ],
      "residual_limit": "timestamp syntax and ordering are local validation properties and do not prove secure or independently witnessed clock time"
    }
