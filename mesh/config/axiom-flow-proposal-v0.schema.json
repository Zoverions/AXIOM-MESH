{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/axiom-flow-proposal-v0.schema.json",
  "title": "AXIOM Flow Proposal v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "flow_id",
    "task_digest",
    "purpose_digest",
    "completion",
    "budget",
    "steps",
    "authority_effect",
    "execution_effect",
    "network_effect",
    "persistence_effect",
    "credential_visibility",
    "runtime_activation"
  ],
  "properties": {
    "schema": { "const": "axiom-flow-proposal.v0" },
    "version": { "const": 0 },
    "status": { "const": "inert-flow-proposal" },
    "flow_id": { "$ref": "#/$defs/identifier" },
    "task_digest": { "$ref": "#/$defs/sha256" },
    "purpose_digest": { "$ref": "#/$defs/sha256" },
    "completion": { "$ref": "#/$defs/completion" },
    "budget": { "$ref": "#/$defs/budget" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/step" }
    },
    "authority_effect": { "const": "none" },
    "execution_effect": { "const": "none" },
    "network_effect": { "const": "none" },
    "persistence_effect": { "const": "none" },
    "credential_visibility": { "const": "none" },
    "runtime_activation": { "const": false }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identifierArray": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "digestArray": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "backoff_ms",
        "idempotency_mode",
        "idempotency_scope"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "backoff_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "idempotency_mode": {
          "type": "string",
          "enum": ["none", "intrinsic", "keyed"]
        },
        "idempotency_scope": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "enum": ["step", "effect"] }
          ]
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on_failure",
        "on_uncertain_completion"
      ],
      "properties": {
        "on_failure": {
          "type": "string",
          "enum": ["stop", "continue", "escalate"]
        },
        "on_uncertain_completion": {
          "type": "string",
          "enum": ["not-applicable", "stop-and-escalate"]
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "operation_id",
        "operation_manifest_digest",
        "depends_on",
        "required_capability_ids",
        "input_schema_digest",
        "output_schema_digest",
        "semantic_evidence_digests",
        "effect_class",
        "effect_scope",
        "network",
        "persistence",
        "retry",
        "failure"
      ],
      "properties": {
        "step_id": { "$ref": "#/$defs/identifier" },
        "operation_id": { "$ref": "#/$defs/identifier" },
        "operation_manifest_digest": { "$ref": "#/$defs/sha256" },
        "depends_on": { "$ref": "#/$defs/identifierArray" },
        "required_capability_ids": { "$ref": "#/$defs/identifierArray" },
        "input_schema_digest": { "$ref": "#/$defs/sha256" },
        "output_schema_digest": { "$ref": "#/$defs/sha256" },
        "semantic_evidence_digests": { "$ref": "#/$defs/digestArray" },
        "effect_class": {
          "type": "string",
          "enum": ["pure", "read", "mutation"]
        },
        "effect_scope": {
          "type": "string",
          "enum": ["local", "external"]
        },
        "network": {
          "type": "string",
          "enum": ["none", "required"]
        },
        "persistence": {
          "type": "string",
          "enum": ["none", "read", "write"]
        },
        "retry": { "$ref": "#/$defs/retry" },
        "failure": { "$ref": "#/$defs/failure" }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_step_ids",
        "on_blocked",
        "on_authority_missing",
        "on_budget_exhausted",
        "on_uncertain_effect"
      ],
      "properties": {
        "required_step_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "on_blocked": { "const": "stop" },
        "on_authority_missing": { "const": "stop" },
        "on_budget_exhausted": { "const": "stop" },
        "on_uncertain_effect": { "const": "stop-and-escalate" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_steps",
        "max_network_steps",
        "max_mutation_steps",
        "max_total_attempts"
      ],
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_network_steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "max_mutation_steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "max_total_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    }
  },
  "x-axiom-semantic-validator": "mesh/src/lib/flow-compiler.mjs",
  "x-axiom-semantic-rules": [
    "dependency references must exist, cannot self-reference, and the workflow graph must be acyclic",
    "proposal hashing normalizes step order plus set-like arrays so semantically equivalent ordering produces one digest",
    "pure steps cannot request external, network, or persistence effects and persistence writes require mutation effect class",
    "mutation retries above one attempt require explicit idempotency semantics",
    "external mutations must stop and escalate on uncertain completion",
    "declared step, network, mutation, and total-attempt budgets are hard ceilings",
    "required capability ids are requests only and never grants",
    "semantic evidence digests are provenance only and never authority"
  ],
  "x-axiom-non-claims": [
    "natural-language-quality",
    "authority-grant",
    "tool-execution",
    "provider-invocation",
    "network-egress",
    "credential-access",
    "runtime-activation",
    "production-autonomy"
  ]
}
