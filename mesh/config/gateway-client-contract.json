{
  "schema": "axiom-gateway-client-contract.v1",
  "version": 1,
  "kernel_version": "0.12.0-dev.3",
  "base_path": "/v1",
  "boundary": {
    "request_target": "same-origin-relative-path",
    "authenticated_transport": "permission-restricted-gateway-ingress",
    "direct_internal_service_access": false,
    "token_persistence": "caller-managed-memory-only"
  },
  "limits": {
    "default_timeout_ms": 10000,
    "maximum_timeout_ms": 30000,
    "maximum_request_bytes": 1048576,
    "maximum_response_bytes": 2097152,
    "maximum_target_length": 8192,
    "maximum_query_values": 64,
    "maximum_query_value_length": 512,
    "idempotency_key_minimum_length": 16,
    "idempotency_key_maximum_length": 160
  },
  "cancellation": "AbortSignal",
  "error_contract": {
    "schema": "axiom-gateway-error.v1",
    "trace_header": "x-trace-id",
    "unknown_code_behavior": "preserve-and-present-generic-failure",
    "stable_codes": [
      "authentication_required",
      "invalid_token",
      "forbidden",
      "rate_limited",
      "body_too_large",
      "validation_error",
      "not_found",
      "idempotency_conflict",
      "confirmation_required",
      "independent_approval_required",
      "approval_mismatch",
      "approval_unavailable",
      "policy_denied",
      "capability_unavailable",
      "dependency_unavailable",
      "request_cancelled",
      "request_timeout",
      "response_too_large",
      "invalid_client_request",
      "invalid_gateway_response"
    ],
    "retryable_codes": [
      "rate_limited",
      "dependency_unavailable",
      "request_timeout"
    ]
  },
  "routes": [
