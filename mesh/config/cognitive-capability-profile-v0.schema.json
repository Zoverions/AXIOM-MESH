{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/cognitive-capability-profile-v0.schema.json",
  "title": "AXIOM Cognitive Capability Profile v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "profile_id",
    "catalog_entry",
    "integration_class",
    "offering_ref",
    "capabilities",
    "modalities",
    "deployment",
    "data_policy",
    "economics",
    "openness",
    "assurance",
    "created_at",
    "updated_at",
    "authority_effect",
    "network_effect",
    "credential_visibility",
    "runtime_activation",
    "selection_effect"
  ],
  "properties": {
    "schema": { "const": "axiom-cognitive-capability-profile.v0" },
    "version": { "const": 0 },
    "status": { "const": "inert-routing-metadata-laboratory" },
    "profile_id": { "$ref": "#/$defs/identifier" },
    "catalog_entry": { "$ref": "#/$defs/catalogEntry" },
    "integration_class": {
      "type": "string",
      "enum": ["agent-runtime", "model-provider", "compute-backend"]
    },
    "offering_ref": { "$ref": "#/$defs/identifier" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "reasoning",
          "coding",
          "vision",
          "computer-use",
          "research",
          "planning",
          "critique",
          "summarization",
          "embedding",
          "tool-use",
          "agent-orchestration",
          "other"
        ]
      }
    },
    "modalities": { "$ref": "#/$defs/modalities" },
    "deployment": { "$ref": "#/$defs/deployment" },
    "data_policy": { "$ref": "#/$defs/dataPolicy" },
    "economics": { "$ref": "#/$defs/economics" },
    "openness": { "$ref": "#/$defs/openness" },
    "assurance": { "$ref": "#/$defs/assurance" },
    "created_at": { "$ref": "#/$defs/dateTime" },
    "updated_at": { "$ref": "#/$defs/dateTime" },
    "authority_effect": { "const": "none" },
    "network_effect": { "const": "none" },
    "credential_visibility": { "const": "none" },
    "runtime_activation": { "const": false },
    "selection_effect": { "const": "eligibility-only" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "catalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "entry_version", "entry_digest"],
      "properties": {
        "entry_id": { "$ref": "#/$defs/identifier" },
        "entry_version": { "$ref": "#/$defs/version" },
        "entry_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "modality": {
      "type": "string",
      "enum": ["text", "image", "audio", "video", "embedding"]
    },
    "modalities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/modality" }
        },
        "output": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/modality" }
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locality", "access_mode"],
      "properties": {
        "locality": {
          "type": "string",
          "enum": ["owner-local", "owner-remote", "provider-remote", "hybrid"]
        },
        "access_mode": {
          "type": "string",
          "enum": ["local-runtime", "api", "remote-runtime", "hybrid"]
        }
      }
    },
    "dataPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retention", "training_use", "exportability", "policy_ref"],
      "properties": {
        "retention": {
          "type": "string",
          "enum": ["none", "transient", "persistent", "unknown"]
        },
        "training_use": {
          "type": "string",
          "enum": ["excluded", "possible", "unknown"]
        },
        "exportability": {
          "type": "string",
          "enum": ["none", "partial", "full", "unknown"]
        },
        "policy_ref": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 512 }
          ]
        }
      }
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cost_class", "latency_class", "context_class"],
      "properties": {
        "cost_class": {
          "type": "string",
          "enum": ["none", "low", "medium", "high", "unknown"]
        },
        "latency_class": {
          "type": "string",
          "enum": ["local-fast", "interactive", "slow", "batch", "unknown"]
        },
        "context_class": {
          "type": "string",
          "enum": ["small", "medium", "large", "very-large", "unknown"]
        }
      }
    },
    "openness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight_access", "artifact_digest", "license_ref"],
      "properties": {
        "weight_access": {
          "type": "string",
          "enum": ["closed", "open-remote", "open-acquired", "local-proprietary", "not-applicable"]
        },
        "artifact_digest": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        },
        "license_ref": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 256 }
          ]
        }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ceiling", "evidence_refs"],
      "properties": {
        "ceiling": {
          "type": "string",
          "enum": ["none", "self-asserted", "behavioral", "cryptographic", "hardware-rooted"]
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  },
  "x-axiom-semantic-validator": "mesh/src/lib/cognitive-capability-profile.mjs",
  "x-axiom-semantic-rules": [
    "profile catalog_entry identity version and digest must match one exact validated runtime/provider catalog entry",
    "profile integration_class must match the bound catalog entry",
    "owner-local local-runtime profiles require catalog entries with network_required false",
    "provider-remote api or remote-runtime profiles require catalog entries with network_required true",
    "open-acquired and local-proprietary weight access require an exact artifact digest; other states require null",
    "eligibility metadata never grants authority activates runtimes reveals credentials or performs network access"
  ],
  "x-axiom-non-claims": [
    "provider-availability",
    "model-invocation",
    "credential-brokerage",
    "network-egress",
    "automatic-routing-winner",
    "learned-routing",
    "benchmark-truth",
    "exact-price-truth",
    "provider-policy-freshness",
    "authority-grant"
  ]
}
