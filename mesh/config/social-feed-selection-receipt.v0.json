{
  "schema": "axiom-social-feed-selection-receipt-policy.v0",
  "version": 0,
  "status": "inert-selection-evidence-contract",
  "runtime_activation": false,
  "authority_effect": "none",
  "network_effect": "none",
  "receipt": {
    "schema": "axiom-social-feed-selection-receipt.v0",
    "owner_scope": "local",
    "content_digest_required": true,
    "selection_reason_required": true,
    "source_class_required": true,
    "selected_at_required": true,
    "preference_digest_required_for_personalized_reason": true,
    "curation_lens_digest_required_for_circle_curated_reason": true,
    "authority_effect": "none",
    "network_effect": "none"
  },
  "selection_reasons": [
    "followed-source",
    "circle-curated",
    "chronological",
    "topic-match",
    "diversity-counterview",
    "underrepresented-source",
    "user-requested-discovery",
    "suspected-spam-visible-by-choice"
  ],
  "source_classes": [
    "local-authored",
    "followed-remote-observation",
    "admitted-remote-observation",
    "circle-shared-observation",
    "user-imported-public-observation"
  ],
  "diversity_evidence": {
    "allowed_dimensions": [
      "viewpoint-distance",
      "source-novelty",
      "topic-novelty",
      "geographic-breadth",
      "evidence-source-diversity",
      "chronological-ranked-balance"
    ],
    "must_be_user_enabled": true,
    "must_bind_user_preference_digest": true,
    "may_use_hidden_political_label": false,
    "may_infer_religion": false,
    "may_infer_race_or_ethnicity": false,
    "may_infer_sexual_orientation": false,
    "may_infer_health_status": false,
    "may_infer_criminal_history": false,
    "opposing_view_is_truth_judgment": false,
    "underrepresented_source_is_quality_judgment": false,
    "diversity_insertion_is_endorsement": false
  },
  "explainability": {
    "human_reason_available": true,
    "raw_selection_receipt_available": true,
    "non_chronological_insertion_must_be_explainable": true,
    "opaque_score_alone_is_sufficient": false
  },
  "privacy": {
    "selection_receipt_is_owner_private_by_default": true,
    "may_publish_inferred_user_profile": false,
    "may_export_without_user_action": false
  }
}
