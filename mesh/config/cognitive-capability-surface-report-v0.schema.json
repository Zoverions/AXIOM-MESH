{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/cognitive-capability-surface-report-v0.schema.json",
  "title": "AXIOM Cognitive Capability Surface Report v0",
  "description": "Closed-world, evidence-only report over exact Capability Observation v0 artifacts for one Cognitive Capability Profile v0 at an explicit assessment time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "report_id",
    "profile_id",
    "profile_digest",
    "assessment_at",
    "recorded_at",
    "source_observations",
    "capability_surfaces",
    "contains_secret_material",
    "authority_effect",
    "network_effect",
    "training_effect",
    "spend_effect",
    "runtime_activation",
    "selection_effect"
  ],
  "properties": {
    "schema": {
      "const": "axiom-cognitive-capability-surface-report.v0"
    },
    "version": {
      "const": 0
    },
    "status": {
      "const": "inert-evidence-report"
    },
    "report_id": {
      "$ref": "#/$defs/identifier"
    },
    "profile_id": {
      "$ref": "#/$defs/identifier"
    },
    "profile_digest": {
      "$ref": "#/$defs/digest"
    },
    "assessment_at": {
      "$ref": "#/$defs/timestamp"
    },
    "recorded_at": {
      "$ref": "#/$defs/timestamp"
    },
    "source_observations": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/sourceObservation"
      }
    },
    "capability_surfaces": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/capabilitySurface"
      }
    },
    "contains_secret_material": {
      "const": false
    },
    "authority_effect": {
      "const": "none"
    },
    "network_effect": {
      "const": "none"
    },
    "training_effect": {
      "const": "none"
    },
    "spend_effect": {
      "const": "none"
    },
    "runtime_activation": {
      "const": false
    },
    "selection_effect": {
      "const": "evidence-only"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "unit": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,63}$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "nonNegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sourceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "observation_digest",
        "capability",
        "freshness",
        "observed_at",
        "valid_until",
        "recorded_at"
      ],
      "properties": {
        "observation_id": {
          "$ref": "#/$defs/identifier"
        },
        "observation_digest": {
          "$ref": "#/$defs/digest"
        },
        "capability": {
          "$ref": "#/$defs/identifier"
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "future",
            "not-yet-recorded"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "valid_until": {
          "$ref": "#/$defs/timestamp"
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "capabilitySurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "current_cells",
        "direct_conflict_cells",
        "mixed_conflict_cells",
        "variation_present"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/identifier"
        },
        "current_cells": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/currentCell"
          }
        },
        "direct_conflict_cells": {
          "$ref": "#/$defs/nonNegativeSafeInteger"
        },
        "mixed_conflict_cells": {
          "$ref": "#/$defs/nonNegativeSafeInteger"
        },
        "variation_present": {
          "type": "boolean"
        }
      }
    },
    "currentCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_key",
        "cell_digest",
        "observation_refs",
        "observation_digests",
        "classification_counts",
        "classification_set",
        "conflict_class",
        "evaluator_evidence",
        "failure_modes",
        "resource_buckets"
      ],
      "properties": {
        "cell_key": {
          "$ref": "#/$defs/cellKey"
        },
        "cell_digest": {
          "$ref": "#/$defs/digest"
        },
        "observation_refs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "observation_digests": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "classification_counts": {
          "$ref": "#/$defs/classificationCounts"
        },
        "classification_set": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "pass",
              "degraded",
              "fail",
              "indeterminate"
            ]
          }
        },
        "conflict_class": {
          "enum": [
            "none",
            "mixed",
            "direct"
          ]
        },
        "evaluator_evidence": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/evaluatorEvidence"
          }
        },
        "failure_modes": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/failureMode"
          }
        },
        "resource_buckets": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/resourceBucket"
          }
        }
      }
    },
    "cellKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "context_ref",
        "context_digest",
        "task_family_ref",
        "task_family_digest",
        "difficulty_class",
        "environment_ref",
        "environment_digest",
        "toolset_ref",
        "toolset_digest",
        "suite_ref",
        "suite_digest",
        "metric_set_ref",
        "metric_set_digest",
        "threshold_ref",
        "threshold_digest",
        "method_ref",
        "method_digest"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/identifier"
        },
        "context_ref": {
          "$ref": "#/$defs/identifier"
        },
        "context_digest": {
          "$ref": "#/$defs/digest"
        },
        "task_family_ref": {
          "$ref": "#/$defs/identifier"
        },
        "task_family_digest": {
          "$ref": "#/$defs/digest"
        },
        "difficulty_class": {
          "enum": [
            "trivial",
            "routine",
            "challenging",
            "expert",
            "adversarial",
            "unknown"
          ]
        },
        "environment_ref": {
          "$ref": "#/$defs/identifier"
        },
        "environment_digest": {
          "$ref": "#/$defs/digest"
        },
        "toolset_ref": {
          "$ref": "#/$defs/identifier"
        },
        "toolset_digest": {
          "$ref": "#/$defs/digest"
        },
        "suite_ref": {
          "$ref": "#/$defs/identifier"
        },
        "suite_digest": {
          "$ref": "#/$defs/digest"
        },
        "metric_set_ref": {
          "$ref": "#/$defs/identifier"
        },
        "metric_set_digest": {
          "$ref": "#/$defs/digest"
        },
        "threshold_ref": {
          "$ref": "#/$defs/identifier"
        },
        "threshold_digest": {
          "$ref": "#/$defs/digest"
        },
        "method_ref": {
          "$ref": "#/$defs/identifier"
        },
        "method_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "classificationCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "degraded",
        "fail",
        "indeterminate"
      ],
      "properties": {
        "pass": {
          "$ref": "#/$defs/nonNegativeSafeInteger"
        },
        "degraded": {
          "$ref": "#/$defs/nonNegativeSafeInteger"
        },
        "fail": {
          "$ref": "#/$defs/nonNegativeSafeInteger"
        },
        "indeterminate": {
          "$ref": "#/$defs/nonNegativeSafeInteger"
        }
      }
    },
    "evaluatorEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator_kind",
        "evaluator_ref",
        "evaluator_principal_ref",
        "assurance_class",
        "evidence_kind",
        "evidence_ref",
        "evidence_digest",
        "verification_ref",
        "verification_digest",
        "observation_refs"
      ],
      "properties": {
        "evaluator_kind": {
          "$ref": "#/$defs/identifier"
        },
        "evaluator_ref": {
          "$ref": "#/$defs/identifier"
        },
        "evaluator_principal_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/identifier"
            }
          ]
        },
        "assurance_class": {
          "$ref": "#/$defs/identifier"
        },
        "evidence_kind": {
          "$ref": "#/$defs/identifier"
        },
        "evidence_ref": {
          "$ref": "#/$defs/identifier"
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        },
        "verification_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/identifier"
            }
          ]
        },
        "verification_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "observation_refs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "failureMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_mode_ref",
        "observation_refs"
      ],
      "properties": {
        "failure_mode_ref": {
          "$ref": "#/$defs/identifier"
        },
        "observation_refs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "resourceBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_class",
        "basis",
        "unit",
        "measurement_count",
        "min_amount",
        "max_amount",
        "observation_refs"
      ],
      "properties": {
        "resource_class": {
          "$ref": "#/$defs/identifier"
        },
        "basis": {
          "enum": [
            "observed",
            "estimated",
            "unknown"
          ]
        },
        "unit": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/unit"
            }
          ]
        },
        "measurement_count": {
          "$ref": "#/$defs/nonNegativeSafeInteger"
        },
        "min_amount": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/nonNegativeSafeInteger"
            }
          ]
        },
        "max_amount": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/nonNegativeSafeInteger"
            }
          ]
        },
        "observation_refs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "const": "unknown"
              }
            },
            "required": [
              "basis"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "type": "null"
              },
              "min_amount": {
                "type": "null"
              },
              "max_amount": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "unit": {
                "$ref": "#/$defs/unit"
              },
              "min_amount": {
                "$ref": "#/$defs/nonNegativeSafeInteger"
              },
              "max_amount": {
                "$ref": "#/$defs/nonNegativeSafeInteger"
              }
            }
          }
        }
      ]
    }
  },
  "x-axiom-semantic-rules": [
    "The report profile_id and profile_digest must bind the exact validated Cognitive Capability Profile v0 used for derivation.",
    "Every source observation_id and observation_digest must bind an exact validated Capability Observation v0 artifact for that same profile.",
    "Freshness precedence is future, then not-yet-recorded, then stale, otherwise current, all relative to the explicit assessment_at timestamp and never the wall clock.",
    "Only current observations populate capability cells; stale, future, and not-yet-recorded observations remain visible in source inventory without contributing to current cells.",
    "Exact cell identity includes capability, difficulty, and every context and evaluation reference/digest dimension; observations from different exact cells are not merged.",
    "Conflict is preserved within an exact cell: pass plus fail is direct conflict; other multi-classification cells are mixed conflict; multiple distinct current cells represent contextual variation rather than direct conflict.",
    "Source references, cell lists, classification sets, evaluator/evidence groups, failure modes, and resource buckets use deterministic canonical order; semantic validation and exact re-verification enforce ordering not expressible in JSON Schema.",
    "Resource observations remain separated by exact resource class, basis, and unit; resource units are never converted and ranges are not averaged into a universal utility value.",
    "cell_digest must equal the canonical digest of cell_key, and exact report verification re-derives the report from the bound profile and observations and compares the canonical report digest.",
    "recorded_at cannot precede assessment_at; canonical ISO timestamp normalization is enforced by the semantic validator.",
    "The document is inert evidence and cannot create capabilities, grants, provider activation, network effects, training effects, spend effects, runtime activation, or execution authority."
  ],
  "x-axiom-non-claims": [
    "No universal model score or universal intelligence score is created by this report.",
    "No provider rank or global rank is inferred from capability surfaces.",
    "No majority winner or majority-vote truth is inferred when observations disagree.",
    "No routing weight or routing authority is granted by a surface report.",
    "Repeated evidence does not establish evaluator independence or statistical independence among evaluators.",
    "No execution authority is granted by observed capability or report derivation.",
    "No training permission or training effect is granted or performed.",
    "No spend permission or spend effect is granted or performed.",
    "No network permission, runtime activation, provider invocation, or topology mutation is granted or performed."
  ],
  "x-axiom-semantic-validator": "mesh/src/lib/cognitive-capability-surface-report.mjs"
}
