{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/circle-core-v0.schema.json",
  "title": "AXIOM Circle Core v0 inert contract package",
  "description": "Pure, non-authorizing Circle collaboration records. Cross-record and authority semantics are enforced by mesh/src/lib/circle-core.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "circle",
    "charter",
    "invitations",
    "memberships",
    "proposals",
    "tasks",
    "decisions",
    "appeals",
    "exits",
    "exports",
    "authority_effect",
    "network_effect",
    "runtime_activation"
  ],
  "properties": {
    "schema": { "const": "axiom-circle-core-package.v0" },
    "version": { "const": 0 },
    "status": { "const": "inert-contract-laboratory" },
    "circle": { "$ref": "#/$defs/circle" },
    "charter": { "$ref": "#/$defs/charter" },
    "invitations": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/invitation" } },
    "memberships": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/membership" } },
    "proposals": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/proposal" } },
    "tasks": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/task" } },
    "decisions": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/decision" } },
    "appeals": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/appeal" } },
    "exits": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/exit" } },
    "exports": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/export" } },
    "authority_effect": { "const": "none" },
    "network_effect": { "const": "none" },
    "runtime_activation": { "const": false }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "date": { "type": "string", "format": "date-time" },
    "noAuthority": { "const": "none" },
    "circle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "circle_id", "name", "purpose", "created_by", "created_at", "trust_anchor_id", "participation_model", "member_state_ownership", "policy_floor", "authority_effect", "network_effect", "runtime_activation"],
      "properties": {
        "schema": { "const": "axiom-circle.v0" },
        "circle_id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "created_by": { "$ref": "#/$defs/identifier" },
        "created_at": { "$ref": "#/$defs/date" },
        "trust_anchor_id": { "$ref": "#/$defs/identifier" },
        "participation_model": { "enum": ["voluntary", "contractual"] },
        "member_state_ownership": { "const": "independent-node" },
        "policy_floor": { "const": "raise-only" },
        "authority_effect": { "$ref": "#/$defs/noAuthority" },
        "network_effect": { "const": "none" },
        "runtime_activation": { "const": false }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "label", "declared_modes", "execution_authority"],
      "properties": {
        "role_id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "declared_modes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": { "enum": ["propose", "deliberate", "evidence", "vote", "approve", "review", "appeal", "observe"] }
        },
        "execution_authority": { "const": false }
      }
    },
    "charter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "circle_id", "version", "effective_from", "supersedes_digest", "roles", "decision_rule", "appeal_enabled", "member_exit_enabled", "execution_authority", "authority_effect"],
      "properties": {
        "schema": { "const": "axiom-circle-charter.v0" },
        "circle_id": { "$ref": "#/$defs/identifier" },
        "version": { "type": "integer", "minimum": 1 },
        "effective_from": { "$ref": "#/$defs/date" },
        "supersedes_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "roles": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/role" } },
        "decision_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quorum_basis_points", "approval_basis_points", "abstention_counts_toward_quorum"],
          "properties": {
            "quorum_basis_points": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "approval_basis_points": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "abstention_counts_toward_quorum": { "type": "boolean" }
          }
        },
        "appeal_enabled": { "const": true },
        "member_exit_enabled": { "const": true },
        "execution_authority": { "const": false },
        "authority_effect": { "$ref": "#/$defs/noAuthority" }
      }
    },
    "invitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "invitation_id", "circle_id", "invited_principal", "membership_class", "role_ids", "issued_by", "issued_at", "expires_at", "charter_digest", "one_use", "authority_effect"],
      "properties": {
        "schema": { "const": "axiom-circle-invitation.v0" },
        "invitation_id": { "$ref": "#/$defs/identifier" },
        "circle_id": { "$ref": "#/$defs/identifier" },
        "invited_principal": { "$ref": "#/$defs/identifier" },
        "membership_class": { "enum": ["member", "guardian", "contractor", "employee", "observer"] },
        "role_ids": { "type": "array", "uniqueItems": true, "maxItems": 16, "items": { "$ref": "#/$defs/identifier" } },
        "issued_by": { "$ref": "#/$defs/identifier" },
        "issued_at": { "$ref": "#/$defs/date" },
        "expires_at": { "$ref": "#/$defs/date" },
        "charter_digest": { "$ref": "#/$defs/digest" },
        "one_use": { "const": true },
        "authority_effect": { "$ref": "#/$defs/noAuthority" }
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "membership_id", "circle_id", "invitation_id", "principal_id", "role_ids", "accepted_at", "status", "status_effective_at", "member_state_ownership", "disclosure_profile", "authority_effect", "network_effect"],
      "properties": {
        "schema": { "const": "axiom-circle-membership.v0" },
        "membership_id": { "$ref": "#/$defs/identifier" },
        "circle_id": { "$ref": "#/$defs/identifier" },
        "invitation_id": { "$ref": "#/$defs/identifier" },
        "principal_id": { "$ref": "#/$defs/identifier" },
        "role_ids": { "type": "array", "uniqueItems": true, "maxItems": 16, "items": { "$ref": "#/$defs/identifier" } },
        "accepted_at": { "$ref": "#/$defs/date" },
        "status": { "enum": ["active", "suspended", "revoked", "exited"] },
        "status_effective_at": { "$ref": "#/$defs/date" },
        "member_state_ownership": { "const": "independent-node" },
        "disclosure_profile": { "const": "selective" },
        "authority_effect": { "$ref": "#/$defs/noAuthority" },
        "network_effect": { "const": "none" }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "proposal_id", "circle_id", "charter_digest", "proposer", "title", "summary", "created_at", "closes_at", "status", "evidence_refs", "execution_effect", "authority_effect"],
      "properties": {
        "schema": { "const": "axiom-circle-proposal.v0" },
        "proposal_id": { "$ref": "#/$defs/identifier" },
        "circle_id": { "$ref": "#/$defs/identifier" },
        "charter_digest": { "$ref": "#/$defs/digest" },
        "proposer": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "created_at": { "$ref": "#/$defs/date" },
        "closes_at": { "$ref": "#/$defs/date" },
        "status": { "enum": ["open", "withdrawn", "closed"] },
        "evidence_refs": { "type": "array", "uniqueItems": true, "maxItems": 64, "items": { "type": "string", "minLength": 1 },
        "execution_effect": { "const": "none" },
        "authority_effect": { "$ref": "#/$defs/noAuthority" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "task_id", "circle_id", "proposal_id", "assigned_membership_id", "description", "created_at", "due_at", "status", "evidence_refs", "execution_authority", "authority_effect"],
      "properties": {
        "schema": { "const": "axiom-circle-task.v0" },
        "task_id": { "$ref": "#/$defs/identifier" },
        "circle_id": { "$ref": "#/$defs/identifier" },
        "proposal_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/identifier" }] },
        "assigned_membership_id": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "created_at": { "$ref": "#/$defs/date" },
        "due_at": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/date" }] },
        "status": { "enum": ["open", "accepted", "completed", "cancelled"] },
        "evidence_refs": { "type": "array", "uniqueItems": true, "maxItems": 64, "items": { "type": "string", "minLength": 1 },
        "execution_authority": { "const": false },
        "authority_effect": { "$ref": "#/$defs/noAuthority" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "decision_id", "circle_id", "proposal_id", "charter_digest", "outcome", "decided_at", "participant_receipts", "finality", "runtime_authority", "authority_effect"],
      "properties": {
        "schema": { "const": "axiom-circle-decision.v0" },
        "decision_id": { "$ref": "#/$defs/identifier" },
        "circle_id": { "$ref": "#/$defs/identifier" },
        "proposal_id": { "$ref": "#/$defs/identifier" },
        "charter_digest": { "$ref": "#/$defs/digest" },
        "outcome": { "enum": ["accepted", "rejected", "no-quorum", "withdrawn"] },
        "decided_at": { "$ref": "#/$defs/date" },
        "participant_receipts": { "type": "array", "uniqueItems": true, "maxItems": 512, "items": { "type": "string", "minLength": 1 } },
        "finality": { "enum": ["circle-local-provisional", "circle-local-accepted"] },
        "runtime_authority": { "const": false },
        "authority_effect": { "$ref": "#/$defs/noAuthority" }
      }
    },
    "appeal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "appeal_id", "circle_id", "target_type", "target_id", "filed_by", "reason", "filed_at", "status", "resolved_at", "authority_effect"],
      "properties": {
        "schema": { "const": "axiom-circle-appeal.v0" },
        "appeal_id": { "$ref": "#/$defs/identifier" },
        "circle_id": { "$ref": "#/$defs/identifier" },
        "target_type": { "enum": ["decision", "membership", "task"] },
        "target_id": { "$ref": "#/$defs/identifier" },
        "filed_by": { "$ref": "#/$defs/identifier" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "filed_at": { "$ref": "#/$defs/date" },
        "status": { "enum": ["open", "accepted", "rejected", "withdrawn"] },
        "resolved_at": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/date" }] },
        "authority_effect": { "$ref": "#/$defs/noAuthority" }
      }
    },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "exit_id", "circle_id", "membership_id", "principal_id", "initiated_by", "kind", "effective_at", "reason_code", "future_obligation_effect", "history_rewrite", "authority_effect"],
      "properties": {
        "schema": { "const": "axiom-circle-exit.v0" },
        "exit_id": { "$ref": "#/$defs/identifier" },
        "circle_id": { "$ref": "#/$defs/identifier" },
        "membership_id": { "$ref": "#/$defs/identifier" },
        "principal_id": { "$ref": "#/$defs/identifier" },
        "initiated_by": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["voluntary-exit", "revocation"] },
        "effective_at": { "$ref": "#/$defs/date" },
        "reason_code": { "$ref": "#/$defs/identifier" },
        "future_obligation_effect": { "const": "ends-except-explicit-post-exit-rules" },
        "history_rewrite": { "const": false },
        "authority_effect": { "$ref": "#/$defs/noAuthority" }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "export_id", "circle_id", "exported_by", "exported_at", "disclosure_class", "included_record_digests", "portable_authority", "authority_effect", "network_effect"],
      "properties": {
        "schema": { "const": "axiom-circle-export.v0" },
        "export_id": { "$ref": "#/$defs/identifier" },
        "circle_id": { "$ref": "#/$defs/identifier" },
        "exported_by": { "$ref": "#/$defs/identifier" },
        "exported_at": { "$ref": "#/$defs/date" },
        "disclosure_class": { "enum": ["public-safe", "member-private"] },
        "included_record_digests": { "type": "array", "uniqueItems": true, "maxItems": 4096, "items": { "$ref": "#/$defs/digest" } },
        "portable_authority": { "const": false },
        "authority_effect": { "$ref": "#/$defs/noAuthority" },
        "network_effect": { "const": "none" }
      }
    }
  },
  "x-axiom-semantic-validator": "mesh/src/lib/circle-core.mjs",
  "x-axiom-non-claims": [
    "runtime-circle-authority",
    "multi-node-circle-governance",
    "federation",
    "consensus",
    "automatic-execution",
    "portable-authority"
  ]
}
