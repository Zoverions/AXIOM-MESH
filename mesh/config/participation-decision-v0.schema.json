{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/participation-decision-v0.schema.json",
  "title": "AXIOM Participation Decision v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema","version","status","action","reaction_recommendation","reasons","observation_digest","policy_digest",
    "decision_digest","authority_effect","data_scope_effect","communication_effect",
    "execution_effect","runtime_activation"
  ],
  "properties": {
    "schema": {"const":"axiom-participation-decision.v0"},
    "version": {"const":0},
    "status": {"const":"inert-participation-decision"},
    "action": {"enum":["ANSWER","INVESTIGATE","PASS"]},
    "reaction_recommendation": {"enum":["none","acknowledge"]},
    "reasons": {
      "type":"array","minItems":1,"maxItems":16,"uniqueItems":true,
      "items":{"type":"string","minLength":1,"maxLength":128}
    },
    "observation_digest": {"anyOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},
    "policy_digest": {"anyOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},
    "decision_digest": {"$ref":"#/$defs/digest"},
    "authority_effect": {"const":"none"},
    "data_scope_effect": {"const":"none"},
    "communication_effect": {"const":"none"},
    "execution_effect": {"const":"none"},
    "runtime_activation": {"const":false}
  },
  "allOf": [
    {
      "if":{"properties":{"observation_digest":{"type":"null"}}},
      "then":{"properties":{"policy_digest":{"type":"null"}}}
    },
    {
      "if":{"properties":{"policy_digest":{"type":"null"}}},
      "then":{"properties":{"observation_digest":{"type":"null"}}}
    }
  ],
  "$defs": {
    "digest": {"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
