{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/machine-principal-lifecycle-transition-v1.schema.json",
  "title": "AXIOM Machine Principal Lifecycle Transition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "principal_id",
    "principal_type",
    "root_authority_digest",
    "predecessor_lifecycle_seq",
    "predecessor_lifecycle_head_digest",
    "predecessor_authority_digest",
    "successor_lifecycle_seq",
    "successor_status",
    "successor_authority_digest",
    "successor_authority",
    "command_id",
    "command_digest",
    "mutation_authorization_digest",
    "actor_id",
    "policy_version",
    "policy_digest",
    "reason",
    "effective_at"
  ],
  "properties": {
    "schema": {
      "const": "axiom-machine-principal-lifecycle-transition.v1"
    },
    "principal_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    },
    "principal_type": {
      "enum": [
        "agent",
        "service"
      ]
    },
    "root_authority_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "predecessor_lifecycle_seq": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "predecessor_lifecycle_head_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "predecessor_authority_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "successor_lifecycle_seq": {
      "type": "integer",
      "minimum": 1
    },
    "successor_status": {
      "enum": [
        "active",
        "narrowed",
        "revoked",
        "compromised",
        "expired"
      ]
    },
    "successor_authority_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "successor_authority": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/machineAuthority"
        }
      ]
    },
    "command_id": {
      "type": "string",
      "pattern": "^machine_cmd_[a-f0-9]{64}$"
    },
    "command_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mutation_authorization_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "machineAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "type",
        "sponsor",
        "roles",
        "scopes",
        "lifetime",
        "runtime",
        "constraints",
        "authority_digest"
      ],
      "properties": {
        "schema": {
          "const": "axiom-machine-principal.v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
        },
        "type": {
          "enum": [
            "agent",
            "service"
          ]
        },
        "sponsor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
        },
        "roles": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{0,159}$"
          }
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          }
        },
        "lifetime": {
          "enum": [
            "persistent",
            "session",
            "ephemeral"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
            },
            "kind": {
              "enum": [
                "local-process",
                "container",
                "external-runtime"
              ]
            },
            "software_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actions",
            "purposes",
            "destinations",
            "budgets",
            "delegation"
          ],
          "properties": {
            "actions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]{1,127}$"
              }
            },
            "purposes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.:-]{0,159}$"
              }
            },
            "destinations": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
              }
            },
            "budgets": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_requests_per_minute",
                "max_concurrent_requests",
                "max_execution_ms",
                "max_request_bytes",
                "max_response_bytes"
              ],
              "properties": {
                "max_requests_per_minute": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "max_concurrent_requests": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 128
                },
                "max_execution_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 300000
                },
                "max_request_bytes": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 10485760
                },
                "max_response_bytes": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 20971520
                }
              }
            },
            "delegation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "allowed",
                "max_depth"
              ],
              "properties": {
                "allowed": {
                  "const": false
                },
                "max_depth": {
                  "const": 0
                }
              }
            }
          }
        },
        "authority_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "x-axiom-semantic-validator": "mesh/src/lib/machine-principal-currentness.mjs"
}
