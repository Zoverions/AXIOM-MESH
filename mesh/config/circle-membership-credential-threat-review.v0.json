{
  "schema": "axiom-circle-membership-credential-threat-review.v0",
  "version": 0,
  "status": "inert-membership-credential-threat-review",
  "runtime_activation": false,
  "authority_effect": "none",
  "network_effect": "none",
  "scope": "circle-member-device-and-public-credential-lifecycle-only",
  "threats": [
    {
      "id": "stolen-device-or-private-key",
      "mitigations": [
        "secret-material-never-stored-in-lifecycle-record",
        "credential-suspension-and-revocation-modelled",
        "device-compromise-invalidates-authentication-eligibility"
      ],
      "residual_limit": "the inert lifecycle does not detect theft itself and does not prove secure hardware custody"
    },
    {
      "id": "credential-key-reuse",
      "mitigations": [
        "public-key-fingerprint-bound",
        "duplicate-public-key-fingerprint-rejected"
      ],
      "residual_limit": "fingerprint uniqueness inside one lifecycle does not prove the key was never reused elsewhere"
    },
    {
      "id": "rotation-substitution-or-branching",
      "mitigations": [
        "exact-predecessor-required",
        "device-membership-principal-binding-preserved",
        "one-successor-per-predecessor",
        "one-root-lineage-per-device",
        "rotation-from-revoked-or-expired-predecessor-rejected"
      ],
      "residual_limit": "the inert record validates structural rotation but does not yet attest who authorized issuance"
    },
    {
      "id": "revocation-bypass",
      "mitigations": [
        "credential-revocation-is-irreversible-for-that-credential",
        "revoked-credential-not-authentication-eligible",
        "revoked-credential-cannot-be-used-as-late-rotation-predecessor"
      ],
      "residual_limit": "future runtime must bind every authentication decision to current derived credential state"
    },
    {
      "id": "compromised-device-reactivation",
      "mitigations": [
        "device-compromise-is-append-only",
        "compromised-device-credentials-not-authentication-eligible",
        "post-compromise-credential-issuance-rejected",
        "recovery-proposes-new-device-and-new-credential-identifiers"
      ],
      "residual_limit": "the contract does not itself enroll or attest the replacement device"
    },
    {
      "id": "recovery-takeover",
      "mitigations": [
        "recovery-proposal-requires-prior-device-compromise",
        "replacement-identifiers-must-not-already-exist",
        "recovery-proposal-grants-no-authority",
        "explicit-admission-required"
      ],
      "residual_limit": "the authority, identity proof, and human procedure for future recovery admission remain unimplemented"
    },
    {
      "id": "membership-exit-or-revocation-ambiguity",
      "mitigations": [
        "active-core-membership-required",
        "exit-history-on-active-membership-rejected",
        "membership-term-binds-credential-eligibility"
      ],
      "residual_limit": "future runtime must derive membership eligibility from append-only lifecycle state rather than a stale status label"
    },
    {
      "id": "role-or-authority-confusion",
      "mitigations": [
        "credential-record-cannot-carry-role-grants",
        "device-record-has-no-execution-authority",
        "portable-authority-false",
        "runtime-authority-false"
      ],
      "residual_limit": "a valid member credential may authenticate a key but cannot establish permission for any particular effect"
    },
    {
      "id": "secret-material-leakage",
      "mitigations": [
        "public-material-only-policy",
        "secret-material-included-false-on-device-and-credential-records"
      ],
      "residual_limit": "private-key generation, storage, backup, hardware binding, and destruction are outside this inert contract"
    },
    {
      "id": "clock-expiry-or-term-manipulation",
      "mitigations": [
        "canonical-utc-timestamps",
        "credential-expiry-after-issuance",
        "credential-expiry-within-membership-term",
        "device-and-credential-registration-after-term-start",
        "rotation-at-or-after-predecessor-expiry-rejected"
      ],
      "residual_limit": "timestamp syntax and ordering do not independently attest trusted real-world time"
    },
    {
      "id": "cross-circle-credential-confusion",
      "mitigations": [
        "exact-circle-id-binding",
        "exact-membership-id-binding",
        "exact-principal-id-binding"
      ],
      "residual_limit": "no cross-Circle credential recognition or delegation semantics are implemented"
    }
  ],
  "promotion_blockers": [
    "explicit-credential-issuance-authority-and-approval-model",
    "trusted-private-key-custody-and-rotation-runbook",
    "recovery-admission-proof-and-human-review",
    "grid-backed-replay-safe-device-and-credential-events",
    "runtime-authentication-check-against-current-derived-state",
    "charter-role-and-membership-lifecycle-integration",
    "security-and-privacy-review-before-real-member-use"
  ],
  "non_claims": {
    "key_possession_proves_human_identity": false,
    "key_possession_proves_legal_identity": false,
    "credential_grants_circle_role": false,
    "credential_grants_runtime_authority": false,
    "recovery_proposal_restores_membership": false,
    "secure_hardware_custody_proved": false,
