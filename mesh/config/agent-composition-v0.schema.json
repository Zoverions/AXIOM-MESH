{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schema/agent-composition-v0.schema.json",
  "title": "AXIOM Agent Composition Contract v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "composition_id",
    "principal_id",
    "integration_mode",
    "self_bundle",
    "runtimes",
    "models",
    "memories",
    "skill_sources",
    "cognitive_workers",
    "continuity_policy_ref",
    "credential_broker_policy_ref",
    "assurance_policy_ref",
    "portability",
    "created_at",
    "updated_at",
    "authority_effect",
    "network_effect",
    "runtime_activation"
  ],
  "properties": {
    "schema": { "const": "axiom-agent-composition.v0" },
    "version": { "const": 0 },
    "status": { "const": "inert-contract-laboratory" },
    "composition_id": { "$ref": "#/$defs/identifier" },
    "principal_id": { "$ref": "#/$defs/identifier" },
    "integration_mode": { "enum": ["wrapped", "integrated", "native"] },
    "self_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "$ref": "#/$defs/identifier" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "runtimes": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/runtime" }
    },
    "models": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/model" }
    },
    "memories": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/memory" }
    },
    "skill_sources": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/skill_source" }
    },
    "cognitive_workers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_ref", "authority_effect", "delegation_enabled"],
      "properties": {
        "policy_ref": { "$ref": "#/$defs/nullable_identifier" },
        "authority_effect": { "const": "none" },
        "delegation_enabled": { "const": false }
      }
    },
    "continuity_policy_ref": { "$ref": "#/$defs/nullable_identifier" },
    "credential_broker_policy_ref": { "$ref": "#/$defs/nullable_identifier" },
    "assurance_policy_ref": { "$ref": "#/$defs/nullable_identifier" },
    "portability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "export_profile_ref"],
      "properties": {
        "enabled": { "type": "boolean" },
        "export_profile_ref": { "$ref": "#/$defs/nullable_identifier" }
      }
    },
    "created_at": { "type": "string", "format": "date-time", "maxLength": 64 },
    "updated_at": { "type": "string", "format": "date-time", "maxLength": 64 },
    "authority_effect": { "const": "none" },
    "network_effect": { "const": "none" },
    "runtime_activation": { "const": false }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    },
    "nullable_identifier": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_id", "adapter_id", "profile_ref", "required"],
      "properties": {
        "runtime_id": { "$ref": "#/$defs/identifier" },
        "adapter_id": { "$ref": "#/$defs/identifier" },
        "profile_ref": { "$ref": "#/$defs/identifier" },
        "required": { "type": "boolean" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "provider_id", "profile_ref", "roles"],
      "properties": {
        "model_id": { "$ref": "#/$defs/identifier" },
        "provider_id": { "$ref": "#/$defs/identifier" },
        "profile_ref": { "$ref": "#/$defs/identifier" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "reasoning",
              "coding",
              "vision",
              "computer-use",
              "research",
              "planning",
              "critique",
              "summarization",
              "embedding",
              "other"
            ]
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_id", "provider_id", "profile_ref", "classes"],
      "properties": {
        "memory_id": { "$ref": "#/$defs/identifier" },
        "provider_id": { "$ref": "#/$defs/identifier" },
        "profile_ref": { "$ref": "#/$defs/identifier" },
        "classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "enum": ["semantic", "episodic", "procedural", "working"] }
        }
      }
    },
    "skill_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "artifact_ref", "profile_ref"],
      "properties": {
        "source_id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["native", "imported", "mcp", "custom"] },
        "artifact_ref": { "$ref": "#/$defs/identifier" },
        "profile_ref": { "$ref": "#/$defs/identifier" }
      }
    }
  },
  "x-axiom-semantic-validator": "mesh/src/lib/agent-composition.mjs",
  "x-axiom-non-claims": [
    "runtime-activation",
    "authority-grant",
    "machine-delegation",
    "credential-storage",
    "credential-brokering",
    "model-continuity-proof",
    "autonomous-self-modification"
  ]
}
