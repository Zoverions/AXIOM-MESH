    {
      "threat": "participant-proof-substitution",
      "mitigations": ["circle-membership-principal-credential-tuple-binding", "duplicate-credential-evidence-deduplication", "extra-or-missing-attestation-rejected"],
      "residual_limitation": "A valid key-possession proof does not establish that the key is controlled by the intended human rather than malware, a delegate, or another custodian."
