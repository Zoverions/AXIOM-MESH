{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axiom:contract:external-agent-ingress-request:v0",
  "title": "AXIOM External Agent Ingress Request v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "source",
    "principal",
    "intent",
    "observed_at",
    "expires_at",
    "evidence",
    "authority_state",
    "credentials_present",
    "grants_authority",
    "execution_effect",
    "network_effect",
    "request_digest"
  ],
  "properties": {
    "schema": { "const": "axiom-external-agent-ingress-request.v0" },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/#-]{0,191}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "provider", "transport_profile", "connector_ref", "context_digest"],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/#-]{0,191}$"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/#-]{0,191}$"
        },
        "transport_profile": { "enum": ["muse", "mcp", "a2a", "other"] },
        "connector_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/#-]{0,191}$"
        },
        "context_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_principal_ref", "identity_claim_external_only"],
      "properties": {
        "external_principal_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/#-]{0,191}$"
        },
        "identity_claim_external_only": { "const": true }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axiom_action", "input_digest", "requested_effect", "purpose", "resource_refs"],
      "properties": {
        "axiom_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/#-]{0,191}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requested_effect": {
          "enum": [
            "read-external",
            "write-external",
            "publish-external",
            "create-external-resource",
            "delete-external-resource",
            "generate-media",
            "financial",
            "communication",
            "unknown"
          ]
        },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 512 },
        "resource_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_refs", "external_claim_only"],
      "properties": {
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        },
        "external_claim_only": { "const": true }
      }
    },
    "authority_state": { "const": "unresolved" },
    "credentials_present": { "const": false },
    "grants_authority": { "const": false },
    "execution_effect": { "const": "none" },
    "network_effect": { "const": "none" },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
