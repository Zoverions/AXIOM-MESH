{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/installed-state-observation-v0.schema.json",
  "title": "AXIOM Installed State Observation v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema","version","status","observation_id","session_id","candidate_digest",
    "observed_at","observation_source","legacy_proof_state_detected","installed_kernel_version",
    "install_record_state","installed_profile_id","installed_release_id",
    "installed_source_revision","installed_host_plan_digest",
    "installed_release_manifest_digest","release_relation_to_desired",
    "relation_evidence_ref","secret_state","data_state","service_state",
    "readiness_state","evidence_refs","observation_digest","authority_effect",
    "mutation_effect","runtime_activation"
  ],
  "properties": {
    "schema":{"const":"axiom-installed-state-observation.v0"},
    "version":{"const":0},
    "status":{"const":"inert-installed-state-observation"},
    "observation_id":{"$ref":"#/$defs/id"},
    "session_id":{"$ref":"#/$defs/id"},
    "candidate_digest":{"$ref":"#/$defs/digest"},
    "observed_at":{"type":"string","format":"date-time"},
    "observation_source":{"enum":["live-local-observation","supplied-evidence","synthetic-test"]},
    "legacy_proof_state_detected":{"type":"boolean"},
    "installed_kernel_version":{"anyOf":[{"$comment":"Same accept set as install-session.mjs kernelVersion(): semver core and pre-release, no build metadata, no leading zeros, each core component at most Number.MAX_SAFE_INTEGER (9007199254740991), at most 128 characters. The pattern has no nested or overlapping quantifiers, so matching is linear. Parity is tested in install-session-schema.test.mjs.","type":"string","maxLength":128,"pattern":"^(?:0|[1-9]\\d{0,14}|[1-8]\\d{15}|900[0-6]\\d{12}|90070\\d{11}|90071[0-8]\\d{10}|900719[0-8]\\d{9}|9007199[0-1]\\d{8}|90071992[0-4]\\d{7}|900719925[0-3]\\d{6}|9007199254[0-6]\\d{5}|90071992547[0-3]\\d{4}|9007199254740[0-8]\\d{2}|90071992547409[0-8]\\d{1}|900719925474099[0-1])\\.(?:0|[1-9]\\d{0,14}|[1-8]\\d{15}|900[0-6]\\d{12}|90070\\d{11}|90071[0-8]\\d{10}|900719[0-8]\\d{9}|9007199[0-1]\\d{8}|90071992[0-4]\\d{7}|900719925[0-3]\\d{6}|9007199254[0-6]\\d{5}|90071992547[0-3]\\d{4}|9007199254740[0-8]\\d{2}|90071992547409[0-8]\\d{1}|900719925474099[0-1])\\.(?:0|[1-9]\\d{0,14}|[1-8]\\d{15}|900[0-6]\\d{12}|90070\\d{11}|90071[0-8]\\d{10}|900719[0-8]\\d{9}|9007199[0-1]\\d{8}|90071992[0-4]\\d{7}|900719925[0-3]\\d{6}|9007199254[0-6]\\d{5}|90071992547[0-3]\\d{4}|9007199254740[0-8]\\d{2}|90071992547409[0-8]\\d{1}|900719925474099[0-1])(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?$"},{"type":"null"}]},
    "install_record_state":{"enum":["absent","complete","partial","failed","unknown"]},
    "installed_profile_id":{"anyOf":[{"enum":["personal-local","infrastructure-node"]},{"type":"null"}]},
    "installed_release_id":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},
    "installed_source_revision":{"anyOf":[{"type":"string","pattern":"^[a-f0-9]{40}$"},{"type":"null"}]},
    "installed_host_plan_digest":{"anyOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},
    "installed_release_manifest_digest":{"anyOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},
    "release_relation_to_desired":{"enum":["absent","same","ancestor","descendant","diverged","unknown"]},
    "relation_evidence_ref":{"anyOf":[{"type":"string","minLength":1,"maxLength":512},{"type":"null"}]},
    "secret_state":{"enum":["absent","complete","partial","unknown"]},
    "data_state":{"enum":["absent","present","unknown"]},
    "service_state":{"enum":["absent","stopped","running","degraded","unknown"]},
    "readiness_state":{"enum":["not-checked","ready","not-ready","unknown"]},
    "evidence_refs":{"type":"array","minItems":1,"maxItems":128,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":512}},
    "observation_digest":{"$ref":"#/$defs/digest"},
    "authority_effect":{"const":"none"},
    "mutation_effect":{"const":"none"},
    "runtime_activation":{"const":false}
  },
  "$defs": {
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"},
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
