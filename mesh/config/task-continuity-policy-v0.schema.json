{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/task-continuity-policy-v0.schema.json",
  "title": "AXIOM Task Continuity Policy v0",
  "description": "Inert loss/degraded-mode policy. It may preserve or queue bounded task cognition during connectivity/provider loss but grants no authority and permits no external effect while degraded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "continuity_id",
    "outcome_id",
    "task_id",
    "authority_snapshot_ref",
    "budget_ref",
    "mode",
    "max_degraded_duration_ms",
    "allowed_local_capabilities",
    "allowed_data_classes",
    "expires_at",
    "grants_authority",
    "execution_effect",
    "runtime_activation"
  ],
  "properties": {
    "schema": {
      "const": "axiom-task-continuity-policy.v0"
    },
    "version": {
      "const": 0
    },
    "status": {
      "const": "inert-contract-laboratory"
    },
    "continuity_id": {
      "$ref": "#/$defs/id"
    },
    "outcome_id": {
      "$ref": "#/$defs/id"
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "authority_snapshot_ref": {
      "$ref": "#/$defs/id"
    },
    "budget_ref": {
      "$ref": "#/$defs/id"
    },
    "mode": {
      "enum": [
        "stop-on-loss",
        "local-cognition-degraded",
        "queue-until-reconnect"
      ]
    },
    "max_degraded_duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 604800000
    },
    "allowed_local_capabilities": {
      "$ref": "#/$defs/idArray"
    },
    "allowed_data_classes": {
      "$ref": "#/$defs/textArray"
    },
    "expires_at": {
      "$ref": "#/$defs/date"
    },
    "grants_authority": {
      "const": false
    },
    "execution_effect": {
      "const": "none"
    },
    "runtime_activation": {
      "const": false
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:#/-]{0,191}$"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "idArray": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "textArray": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  },
  "x-axiom-semantic-validator": "mesh/src/lib/task-continuity-policy.mjs",
  "x-axiom-non-claims": [
    "external-effect-authority",
    "remote-fallback-authority",
    "provider-substitution-authority",
    "offline-spend-authority",
    "runtime-activation"
  ]
}
