{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/execution-route-policy-v0.schema.json",
  "title": "AXIOM Execution Route Policy v0",
  "description": "Inert structured-first execution-route policy. It ranks route candidates for one exact operation digest but grants no authority and cannot change the requested effect.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "routing_id",
    "outcome_id",
    "task_id",
    "operation_digest",
    "authority_snapshot_ref",
    "effect_class",
    "consequence_class",
    "required_capabilities",
    "route_order",
    "allow_visual_fallback",
    "postcondition_required",
    "reconciliation_required",
    "grants_authority",
    "execution_effect",
    "runtime_activation"
  ],
  "properties": {
    "schema": {
      "const": "axiom-execution-route-policy.v0"
    },
    "version": {
      "const": 0
    },
    "status": {
      "const": "inert-contract-laboratory"
    },
    "routing_id": {
      "$ref": "#/$defs/id"
    },
    "outcome_id": {
      "$ref": "#/$defs/id"
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "operation_digest": {
      "$ref": "#/$defs/digest"
    },
    "authority_snapshot_ref": {
      "$ref": "#/$defs/id"
    },
    "effect_class": {
      "enum": [
        "none",
        "read-external",
        "write-external",
        "publish-external",
        "communication",
        "financial",
        "create-external-resource",
        "delete-external-resource",
        "physical",
        "unknown"
      ]
    },
    "consequence_class": {
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3"
      ]
    },
    "required_capabilities": {
      "$ref": "#/$defs/idArray"
    },
    "route_order": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "structured-api",
          "mcp-tool",
          "cli",
          "semantic-ui",
          "visual-computer-use"
        ]
      }
    },
    "allow_visual_fallback": {
      "type": "boolean"
    },
    "postcondition_required": {
      "type": "boolean"
    },
    "reconciliation_required": {
      "type": "boolean"
    },
    "grants_authority": {
      "const": false
    },
    "execution_effect": {
      "const": "none"
    },
    "runtime_activation": {
      "const": false
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:#/-]{0,191}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "idArray": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    }
  },
  "x-axiom-semantic-validator": "mesh/src/lib/execution-route-policy.mjs",
  "x-axiom-non-claims": [
    "effect-authority",
    "route-execution",
    "computer-use-authority",
    "mcp-authority",
    "network-activation",
    "runtime-activation"
  ]
}
