{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/axiom-gateway-client-contract.v1.json",
  "title": "AXIOM Gateway client contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "kernel_version",
    "base_path",
    "boundary",
    "limits",
    "cancellation",
    "error_contract",
    "routes"
  ],
  "properties": {
    "schema": { "const": "axiom-gateway-client-contract.v1" },
    "version": { "const": 1 },
    "kernel_version": { "const": "0.12.0-dev.3" },
    "base_path": { "const": "/v1" },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_target",
        "authenticated_transport",
        "direct_internal_service_access",
        "token_persistence"
      ],
      "properties": {
        "request_target": { "const": "same-origin-relative-path" },
        "authenticated_transport": { "const": "permission-restricted-gateway-ingress" },
        "direct_internal_service_access": { "const": false },
        "token_persistence": { "const": "caller-managed-memory-only" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_timeout_ms",
        "maximum_timeout_ms",
        "maximum_request_bytes",
        "maximum_response_bytes",
        "maximum_target_length",
        "maximum_query_values",
        "maximum_query_value_length",
        "idempotency_key_minimum_length",
        "idempotency_key_maximum_length"
      ],
      "properties": {
        "default_timeout_ms": { "type": "integer", "minimum": 1 },
        "maximum_timeout_ms": { "type": "integer", "minimum": 1 },
        "maximum_request_bytes": { "type": "integer", "minimum": 1 },
        "maximum_response_bytes": { "type": "integer", "minimum": 1 },
        "maximum_target_length": { "type": "integer", "minimum": 1 },
        "maximum_query_values": { "type": "integer", "minimum": 1 },
        "maximum_query_value_length": { "type": "integer", "minimum": 1 },
        "idempotency_key_minimum_length": { "type": "integer", "minimum": 1 },
        "idempotency_key_maximum_length": { "type": "integer", "minimum": 1 }
      }
    },
    "cancellation": { "const": "AbortSignal" },
    "error_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "trace_header",
        "unknown_code_behavior",
        "stable_codes",
        "retryable_codes"
      ],
      "properties": {
        "schema": { "const": "axiom-gateway-error.v1" },
        "trace_header": { "const": "x-trace-id" },
        "unknown_code_behavior": { "const": "preserve-and-present-generic-failure" },
        "stable_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/errorCode" }
        },
        "retryable_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/errorCode" }
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "$defs": {
    "errorCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "method",
        "path",
        "access",
        "idempotency",
        "path_parameters",
        "query_parameters",
        "request_schema",
        "response_schema",
        "required_response_fields",
        "response_media_type"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$" },
        "method": { "enum": ["GET", "POST"] },
        "path": { "type": "string", "pattern": "^/v1(?:/[A-Za-z0-9._~!$&'()+,;=:@%:-]+)+$" },
        "access": { "type": "string", "minLength": 1, "maxLength": 96 },
        "idempotency": { "enum": ["required", "not_applicable"] },
        "path_parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
        },
        "query_parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
        },
        "request_schema": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^axiom-[a-z0-9-]+\\.v1$" }
          ]
        },
        "response_schema": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+\\.v1$" },
        "required_response_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
        },
        "response_media_type": {
          "enum": ["application/json", "application/openmetrics-text"]
        }
      }
    },
    "intentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9.-]+$"
        },
        "input": { "type": "object" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 512 },
        "data_scopes": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "context_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "view_digest",
            "projection_digest",
            "authority_digest",
            "receipt_digest",
            "projection_receipt"
          ],
          "properties": {
            "schema": { "const": "axiom-context-task-binding.v1" },
            "view_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "projection_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "authority_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "receipt_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "projection_receipt": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema",
                "statement",
                "attestation",
                "receipt_digest"
              ],
              "properties": {
                "schema": { "const": "axiom-context-projection-receipt.v1" },
                "receipt_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "statement": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schema",
                    "principal",
                    "purpose",
                    "owner",
                    "as_of",
                    "view_digest",
                    "projection_digest",
                    "authority_digest",
                    "projected_context_scopes",
                    "grid",
                    "authority_effect"
                  ],
                  "properties": {
                    "schema": { "const": "axiom-context-projection-receipt-statement.v1" },
                    "principal": { "type": "string", "minLength": 1, "maxLength": 160 },
                    "purpose": { "type": "string", "minLength": 1, "maxLength": 160 },
                    "owner": { "type": "string", "minLength": 1, "maxLength": 160 },
                    "as_of": { "type": "string", "format": "date-time" },
                    "view_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                    "projection_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                    "authority_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                    "machine_authority_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                    "projected_context_scopes": {
                      "type": "array",
                      "maxItems": 64,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^context:[A-Za-z0-9][A-Za-z0-9_.:-]{0,151}$"
                      }
                    },
                    "grid": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["last_seq", "last_hash", "verification_mode"],
                      "properties": {
                        "last_seq": { "type": "integer", "minimum": 0 },
                        "last_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                        "verification_mode": { "const": "full" }
                      }
                    },
                    "authority_effect": { "const": "none" }
                  }
                },
                "attestation": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["algorithm", "key_id", "digest", "signature"],
                  "properties": {
                    "algorithm": { "const": "Ed25519" },
                    "key_id": { "type": "string", "minLength": 1, "maxLength": 160 },
                    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                    "signature": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "pattern": "^[A-Za-z0-9_-]+$"
                    }
                  }
                }
              }
            }
          }
        },
        "confirmations": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "approval_ids": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    },
    "errorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "trace_id"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "$ref": "#/$defs/errorCode" },
            "message": { "type": "string", "minLength": 1 },
            "details": {}
          }
        },
        "trace_id": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    }
  }
}
