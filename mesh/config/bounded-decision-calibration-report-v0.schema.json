{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/bounded-decision-calibration-report-v0.schema.json",
  "title": "AXIOM Bounded Decision Calibration Report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "calibration_report_id",
    "provider_profile_digest",
    "offering_version_or_revision",
    "offering_revision_evidence",
    "question_schema_family_refs",
    "domain",
    "population_description",
    "evaluation_period",
    "sample_count",
    "outcome_source_refs",
    "metrics",
    "known_limitations",
    "distribution_shift_notes",
    "created_at",
    "valid_until",
    "review_state",
    "report_digest",
    "authority_effect",
    "assurance_effect",
    "network_effect",
    "credential_visibility",
    "runtime_activation",
    "selection_effect"
  ],
  "properties": {
    "schema": { "const": "axiom-bounded-decision-calibration-report.v0" },
    "version": { "const": 0 },
    "status": { "const": "inert-bounded-decision-calibration" },
    "calibration_report_id": { "$ref": "#/$defs/identifier" },
    "provider_profile_digest": { "$ref": "#/$defs/sha256" },
    "offering_version_or_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "offering_revision_evidence": {
      "type": "string",
      "enum": ["exact-artifact", "provider-versioned", "mutable-alias", "unknown"]
    },
    "question_schema_family_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/schemaFamilyRef" }
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "population_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "evaluation_period": { "$ref": "#/$defs/evaluationPeriod" },
    "sample_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "outcome_source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/outcomeSource" }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/metric" }
    },
    "known_limitations": { "$ref": "#/$defs/stringList" },
    "distribution_shift_notes": { "$ref": "#/$defs/stringList" },
    "created_at": { "$ref": "#/$defs/dateTime" },
    "valid_until": { "$ref": "#/$defs/dateTime" },
    "review_state": {
      "type": "string",
      "enum": ["experimental", "reviewed", "expired", "rejected"]
    },
    "report_digest": { "$ref": "#/$defs/sha256" },
    "authority_effect": { "const": "none" },
    "assurance_effect": { "const": "none" },
    "network_effect": { "const": "none" },
    "credential_visibility": { "const": "none" },
    "runtime_activation": { "const": false },
    "selection_effect": { "const": "evidence-only" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "schemaFamilyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_schema_id", "question_schema_digest"],
      "properties": {
        "question_schema_id": { "$ref": "#/$defs/identifier" },
        "question_schema_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "outcomeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome_ref", "outcome_digest", "source_class"],
      "properties": {
        "outcome_ref": { "$ref": "#/$defs/identifier" },
        "outcome_digest": { "$ref": "#/$defs/sha256" },
        "source_class": {
          "type": "string",
          "enum": [
            "benchmark-harness",
            "deterministic-checker",
            "human-adjudication",
            "independent-verifier",
            "other-reviewed"
          ]
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "value"],
      "properties": {
        "metric_id": { "$ref": "#/$defs/identifier" },
        "value": { "type": "number" }
      }
    },
    "evaluationPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/dateTime" },
        "to": { "$ref": "#/$defs/dateTime" }
      }
    },
    "stringList": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  },
  "x-axiom-semantic-validator": "mesh/src/lib/bounded-decision-calibration-report.mjs",
  "x-axiom-semantic-rules": [
    "calibration outcomes must be independently sourced and provider confidence cannot serve as ground truth",
    "question schema family references must resolve exactly to supplied content-addressed schemas in the declared domain",
    "mutable-alias or unknown revision evidence remains explicitly weaker than exact-artifact or provider-versioned reproducibility",
    "valid_until cannot precede created_at and created_at cannot precede the end of the evaluation period",
    "calibration review state is evidence metadata only and never creates authority or assurance"
  ],
  "x-axiom-non-claims": [
    "truth-from-provider-confidence",
    "semantic-infallibility",
    "authority-grant",
    "assurance-promotion",
    "production-routing",
    "provider-revision-reproducibility-from-alias"
  ]
}
