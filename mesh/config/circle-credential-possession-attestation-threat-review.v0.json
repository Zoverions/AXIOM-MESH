{
  "schema": "axiom-circle-credential-possession-attestation-threat-review.v0",
  "version": 0,
  "status": "inert-possession-attestation-threat-review",
  "runtime_activation": false,
  "authority_effect": "none",
  "network_effect": "none",
  "threats": [
    {
      "threat": "wrong-or-substituted-private-key",
      "mitigations": ["ed25519-response-signature-over-exact-challenge-digest", "spki-der-public-key-reconstructed-for-verification", "public-key-fingerprint-must-equal-lifecycle-credential"],
      "residual_limitation": "A valid signature proves control of the matching private key during the observation window, not who or what physically controlled the key."
    },
    {
      "threat": "public-key-encoding-substitution",
      "mitigations": ["spki-der-only-proof-format", "sha256-spki-der-fingerprint-scheme", "ed25519-key-type-required"],
      "residual_limitation": "The proof layer defines a canonical fingerprint scheme for possession evidence but does not retroactively redefine older opaque lifecycle fingerprint commitments."
    },
    {
      "threat": "expired-or-future-challenge",
      "mitigations": ["hypervisor-signed-issued-and-expiry-times", "absolute-sixty-second-challenge-ceiling", "local-verifier-ttl-ceiling"],
      "residual_limitation": "The timing guarantee is relative to the Hypervisor observation clock and does not establish trusted global time."
    },
    {
      "threat": "request-substitution",
      "mitigations": ["challenge-binds-exact-request-digest", "response-binds-challenge-digest", "attestation-repeats-exact-request-digest"],
      "residual_limitation": "A caller must still supply the correct higher-layer request digest; this standalone contract is not yet wired into Circle admission."
    },
    {
      "threat": "lifecycle-head-substitution",
      "mitigations": ["challenge-binds-exact-lifecycle-head-digest", "challenge-binds-credential-lifecycle-digest", "verification-requires-matching-grid-head-snapshot-and-lifecycle-bytes"],
      "residual_limitation": "Atomic protection against a lifecycle head changing after attestation depends on later integration with the #1247 Grid commit CAS."
    },
    {
      "threat": "revoked-suspended-expired-or-compromised-credential",
      "mitigations": ["credential-lifecycle-fully-validated", "authentication-eligible-state-derived-at-challenge-issue-time", "device-compromise-overrides-credential-state"],
      "residual_limitation": "State derived from the supplied authoritative lifecycle cannot detect an unreported real-world compromise."
    },
    {
      "threat": "challenge-response-replay",
      "mitigations": ["random-192-bit-challenge-nonce", "short-lived-hypervisor-signed-challenge", "proof-bound-to-one-challenge-and-request"],
      "residual_limitation": "Challenge single-use consumption is not durably persisted in v0, so exact replay inside the active window is not claimed to be prevented."
    },
    {
      "threat": "historical-possession-backdating",
      "mitigations": ["hypervisor-creates-challenge-with-current-issued-at", "hypervisor-observation-must-occur-inside-active-window", "attestation-records-observed-at"],
      "residual_limitation": "The attestation proves Hypervisor-observed possession in its bounded challenge window; it cannot prove the signer possessed the key before that observation."
    },
    {
      "threat": "possession-laundered-into-identity-or-role",
      "mitigations": ["attestation-human-identity-false", "attestation-legal-identity-false", "attestation-role-authority-false", "runtime-and-external-authority-false"],
      "residual_limitation": "External consumers must preserve these claim boundaries and not reinterpret key possession as personhood, legitimacy, or permission."
    },
    {
      "threat": "hypervisor-key-substitution",
      "mitigations": ["challenge-and-attestation-both-hypervisor-signed", "verification-requires-explicit-trusted-hypervisor-public-key", "challenge-envelope-tamper-invalidates-signature"],
      "residual_limitation": "Compromise of the trusted Hypervisor signing key remains outside this inert contract and requires the existing service-key lifecycle controls."
    }
  ],
  "non_claims": [
    "human-identity",
    "legal-identity",
    "authorized-human-custody",
    "credential-issuance-authority",
    "membership-authority",
    "role-authority",
    "governance-legitimacy",
    "trusted-global-time",
    "historical-possession-before-hypervisor-observation",
    "challenge-single-use-persistence",
    "runtime-authorization",
    "portable-authority",
    "external-effect-authority",
    "distributed-consensus"
  ],
  "promotion_blockers": [
    "bind-possession-attestation-into-atomic-circle-admission-capability",
    "bind-attestation-lifecycle-head-to-same-grid-commit-cas",
    "define-durable-challenge-consumption-if-single-use-is-required",
    "define-member-client-key-custody-and-signing-interface-without-secret-export",
    "define-recovery-and-compromise-response-for-possession-keys",
    "member-facing-explanation-that-possession-is-not-identity-or-role-authority",
    "independent-security-privacy-device-loss-coercion-and-recovery-review"
  ]
}
