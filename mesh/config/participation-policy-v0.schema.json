{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/participation-policy-v0.schema.json",
  "title": "AXIOM Participation Policy v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","version","status","policy_id","preset","policy_source_ref","issued_at","expires_at","passive_participation","reactions_enabled","silent_investigation","explicit_mode","allowed_context_classes","quiet_context_ids","consequence_ceiling","threshold_basis","thresholds","cooldown","grants_authority","data_scope_effect","execution_effect","runtime_activation"],
  "properties": {
    "schema": {"const":"axiom-participation-policy.v0"},
    "version": {"const":0},
    "status": {"const":"inert-participation-policy"},
    "policy_id": {"$ref":"#/$defs/id"},
    "preset": {"enum":["listener","investigator","balanced","teammate","custom"]},
    "policy_source_ref": {"$ref":"#/$defs/id"},
    "issued_at": {"type":"string","format":"date-time"},
    "expires_at": {"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},
    "passive_participation": {"type":"boolean"},
    "reactions_enabled": {"type":"boolean"},
    "silent_investigation": {"type":"boolean"},
    "explicit_mode": {"enum":["answer","investigate-first"]},
    "allowed_context_classes": {"type":"array","minItems":1,"maxItems":5,"uniqueItems":true,"items":{"enum":["owner-private","direct","circle","organization","public"]}},
    "quiet_context_ids": {"type":"array","maxItems":256,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "consequence_ceiling": {"enum":["C0","C1","C2","C3"]},
    "threshold_basis": {"const":"illustrative-unvalidated"},
    "thresholds": {
      "type":"object","additionalProperties":false,
      "required":["reply_usefulness_min","reply_confidence_min","investigate_value_min","acknowledge_fit_min","noise_max","interruption_cost_max"],
      "properties": {
        "reply_usefulness_min":{"$ref":"#/$defs/score"},
        "reply_confidence_min":{"$ref":"#/$defs/score"},
        "investigate_value_min":{"$ref":"#/$defs/score"},
        "acknowledge_fit_min":{"$ref":"#/$defs/score"},
        "noise_max":{"$ref":"#/$defs/score"},
        "interruption_cost_max":{"$ref":"#/$defs/score"}
      }
    },
    "cooldown": {
      "type":"object","additionalProperties":false,
      "required":["required","window_seconds","max_unsolicited_interventions"],
      "properties": {
        "required":{"type":"boolean"},
        "window_seconds":{"type":"integer","minimum":1,"maximum":86400},
        "max_unsolicited_interventions":{"type":"integer","minimum":0,"maximum":10000}
      }
    },
    "grants_authority": {"const":false},
    "data_scope_effect": {"const":"none"},
    "execution_effect": {"const":"none"},
    "runtime_activation": {"const":false}
  },
  "$defs": {
    "id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:#/-]{0,191}$"},
    "score": {"type":"integer","minimum":0,"maximum":100}
  }
}
