{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/install-session-v0.schema.json",
  "title": "AXIOM Install Session Candidate v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema","version","status","session_id","profile_id","runtime_strategy",
    "desired_release_id","desired_source_revision","desired_kernel_version",
    "minimum_compatible_kernel","rollback_mode","host_candidate_compatible","host_plan_digest",
    "host_plan_facts_source","release_manifest_digest","artifact_sha256s",
    "artifact_evidence_refs","requested_at","max_observation_age_seconds",
    "host_mutation_authorized","authority_effect","network_effect",
    "runtime_activation"
  ],
  "properties": {
    "schema": {"const":"axiom-install-session-candidate.v0"},
    "version": {"const":0},
    "status": {"const":"inert-install-session-candidate"},
    "session_id": {"$ref":"#/$defs/id"},
    "profile_id": {"enum":["personal-local","infrastructure-node"]},
    "runtime_strategy": {"enum":["oci","source"]},
    "desired_release_id": {"$ref":"#/$defs/id"},
    "desired_source_revision": {"type":"string","pattern":"^[a-f0-9]{40}$"},
    "desired_kernel_version": {"$ref":"#/$defs/kernel_version"},
    "minimum_compatible_kernel": {"$ref":"#/$defs/kernel_version"},
    "rollback_mode": {"enum":["in-place-compatible","backup-restore-required","migration-specific"]},
    "host_candidate_compatible": {"type":"boolean"},
    "host_plan_digest": {"$ref":"#/$defs/digest"},
    "host_plan_facts_source": {"enum":["live-local-observation","supplied-evidence","synthetic-test"]},
    "release_manifest_digest": {"$ref":"#/$defs/digest"},
    "artifact_sha256s": {
      "type":"array","minItems":1,"maxItems":128,"uniqueItems":true,
      "items":{"$ref":"#/$defs/digest"}
    },
    "artifact_evidence_refs": {
      "type":"array","minItems":1,"maxItems":128,"uniqueItems":true,
      "items":{"type":"string","minLength":1,"maxLength":512}
    },
    "requested_at": {"type":"string","format":"date-time"},
    "max_observation_age_seconds": {"type":"integer","minimum":1,"maximum":3600},
    "host_mutation_authorized": {"const":false},
    "authority_effect": {"const":"none"},
    "network_effect": {"const":"none"},
    "runtime_activation": {"const":false}
  },
  "$defs": {
    "id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"},
    "digest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "kernel_version": {"$comment":"Same accept set as install-session.mjs kernelVersion(): semver core and pre-release, no build metadata, no leading zeros, each core component at most Number.MAX_SAFE_INTEGER (9007199254740991), at most 128 characters. The pattern has no nested or overlapping quantifiers, so matching is linear. Parity is tested in install-session-schema.test.mjs. Ordering is not part of this accept set: install-session.mjs orders different cores by core and, for a same-core ancestor upgrade only, the restricted dev line X.Y.Z-dev.N < X.Y.Z-dev.M (N < M) < X.Y.Z with N, M canonical safe integers; every other same-core pre-release pair is unordered.","type":"string","maxLength":128,"pattern":"^(?:0|[1-9]\\d{0,14}|[1-8]\\d{15}|900[0-6]\\d{12}|90070\\d{11}|90071[0-8]\\d{10}|900719[0-8]\\d{9}|9007199[0-1]\\d{8}|90071992[0-4]\\d{7}|900719925[0-3]\\d{6}|9007199254[0-6]\\d{5}|90071992547[0-3]\\d{4}|9007199254740[0-8]\\d{2}|90071992547409[0-8]\\d{1}|900719925474099[0-1])\\.(?:0|[1-9]\\d{0,14}|[1-8]\\d{15}|900[0-6]\\d{12}|90070\\d{11}|90071[0-8]\\d{10}|900719[0-8]\\d{9}|9007199[0-1]\\d{8}|90071992[0-4]\\d{7}|900719925[0-3]\\d{6}|9007199254[0-6]\\d{5}|90071992547[0-3]\\d{4}|9007199254740[0-8]\\d{2}|90071992547409[0-8]\\d{1}|900719925474099[0-1])\\.(?:0|[1-9]\\d{0,14}|[1-8]\\d{15}|900[0-6]\\d{12}|90070\\d{11}|90071[0-8]\\d{10}|900719[0-8]\\d{9}|9007199[0-1]\\d{8}|90071992[0-4]\\d{7}|900719925[0-3]\\d{6}|9007199254[0-6]\\d{5}|90071992547[0-3]\\d{4}|9007199254740[0-8]\\d{2}|90071992547409[0-8]\\d{1}|900719925474099[0-1])(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?$"}
  }
}
