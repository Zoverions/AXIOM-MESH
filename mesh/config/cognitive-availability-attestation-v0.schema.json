{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-mesh.local/schemas/cognitive-availability-attestation-v0.schema.json",
  "title": "AXIOM Cognitive Availability Attestation v0",
  "description": "Inert, content-addressed evidence describing an observation of one Cognitive Topology node. This schema validates structure only; exact topology binding and artifact semantics are enforced by the semantic validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "attestation_id",
    "topology_id",
    "topology_digest",
    "node_id",
    "model_id",
    "declared_target",
    "observation",
    "observer_ref",
    "evidence",
    "observed_at",
    "valid_until",
    "recorded_at",
    "contains_secret_material",
    "authority_effect",
    "network_effect",
    "runtime_activation"
  ],
  "properties": {
    "schema": { "const": "axiom-cognitive-availability-attestation.v0" },
    "version": { "const": 0 },
    "status": { "const": "inert-evidence" },
    "attestation_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" },
    "topology_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" },
    "topology_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "node_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" },
    "model_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" },
    "declared_target": { "$ref": "#/$defs/declaredTarget" },
    "observation": { "$ref": "#/$defs/observation" },
    "observer_ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" },
    "evidence": { "$ref": "#/$defs/evidence" },
    "observed_at": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "contains_secret_material": { "const": false },
    "authority_effect": { "const": "none" },
    "network_effect": { "const": "none" },
    "runtime_activation": { "const": false }
  },
  "$defs": {
    "declaredTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access_mode", "custody", "weight_state", "artifact_digest"],
      "properties": {
        "access_mode": {
          "enum": ["api", "local-runtime", "remote-runtime", "hybrid"]
        },
        "custody": {
          "enum": ["provider-controlled", "owner-local", "owner-remote", "shared"]
        },
        "weight_state": {
          "enum": ["closed", "open-remote", "open-acquired", "local-proprietary", "not-applicable"]
        },
        "artifact_digest": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "observation_mode", "evidence_class", "observed_artifact_digest"],
      "properties": {
        "availability": {
          "enum": ["available", "unavailable", "indeterminate"]
        },
        "observation_mode": {
          "enum": ["local-artifact", "local-runtime", "provider-api", "remote-runtime", "provider-statement", "synthetic-probe"]
        },
        "evidence_class": {
          "enum": ["direct-local", "direct-remote", "provider-asserted", "synthetic-observed", "indirect"]
        },
        "observed_artifact_digest": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_ref", "evidence_digest"],
      "properties": {
        "evidence_ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" },
        "evidence_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "x-axiom-semantic-validator": "mesh/src/lib/cognitive-availability-attestation.mjs",
  "x-axiom-semantic-rules": [
    "topology_id and topology_digest must bind to one exact Cognitive Topology",
    "node_id and model_id must identify one exact Cognitive Topology node",
    "declared_target must exactly match the bound node access_mode, custody, weight state, and artifact digest",
    "owner-addressable available observations require an observed artifact digest; unavailable or indeterminate observations require null",
    "non-owner-addressable observations require observed_artifact_digest null",
    "a different valid owner artifact digest remains structurally valid evidence and resolves with artifact_match false",
    "valid_until cannot precede observed_at and recorded_at cannot precede observed_at",
    "freshness is evaluated by consumers against valid_until rather than mutating or invalidating historical evidence"
  ],
  "x-axiom-non-claims": [
    "provider-reachability",
    "provider-statement-truth",
    "artifact-availability-beyond-recorded-observation",
    "observer-trust",
    "model-invocation",
    "provider-api-execution",
    "authority-grant",
    "network-effect",
    "runtime-activation",
    "principal-continuity-proof",
    "subjective-identity-proof"
  ]
}
