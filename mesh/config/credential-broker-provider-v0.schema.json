{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schema/credential-broker-provider-v0.schema.json",
  "title": "AXIOM Credential Broker Provider v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "provider_id",
    "provider_kind",
    "integration_mode",
    "supported_credential_classes",
    "supported_actions",
    "allowed_destinations",
    "approval_mode",
    "secret_visibility",
    "model_secret_access",
    "live_invocation",
    "authority_effect",
    "network_effect"
  ],
  "properties": {
    "schema": { "const": "axiom-credential-broker-provider.v0" },
    "version": { "const": 0 },
    "status": { "const": "inert-contract-laboratory" },
    "provider_id": { "$ref": "#/$defs/identifier" },
    "provider_kind": {
      "enum": ["password-manager", "enterprise-secret-manager", "hardware-authenticator", "local-vault", "other"]
    },
    "integration_mode": {
      "enum": ["external-native", "trusted-broker-api", "trusted-browser-extension", "local-only"]
    },
    "supported_credential_classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": ["password", "passkey", "totp", "oauth-token", "api-key", "client-certificate", "session", "signing-key", "other"]
      }
    },
    "supported_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "allowed_destinations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https://", "maxLength": 512 }
    },
    "approval_mode": { "const": "always-human" },
    "secret_visibility": { "const": "trusted-broker-only" },
    "model_secret_access": { "const": false },
    "live_invocation": { "const": false },
    "authority_effect": { "const": "none" },
    "network_effect": { "const": "none" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    }
  },
  "x-axiom-semantic-validator": "mesh/src/lib/credential-broker-contract.mjs",
  "x-axiom-non-claims": [
    "live-credential-brokering",
    "credential-storage",
    "secret-release",
    "browser-automation",
    "network-egress",
    "authority-grant",
    "production-provider-support"
  ]
}
