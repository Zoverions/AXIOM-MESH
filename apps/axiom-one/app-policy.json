{
  "schema": "axiom-one-preview.v1",
  "version": 1,
  "kernel_version": "0.12.0-dev.3",
  "status": "experimental-local-preview",
  "network": {
    "bind_host": "127.0.0.1",
    "default_port": 4173,
    "default_gateway_origin": "http://127.0.0.1:8080",
    "gateway_target": "same-origin-relative-v1",
    "remote_origins_allowed": false
  },
  "security": {
    "token_persistence": "memory-only",
    "cookies_used": false,
    "secret_or_user_data_storage": false,
    "public_shell_cache": true,
    "third_party_assets": false,
    "analytics": false,
    "api_cache": false,
    "maximum_proxy_request_bytes": 1048576,
    "maximum_proxy_response_bytes": 2097152,
    "proxy_timeout_ms": 30000
  },
  "human_explanations": {
    "contract_schema": "axiom-one-human-contract.v1",
    "status": "experimental-human-explanations",
    "action_previews": ["system.echo", "memory.put", "memory.link", "memory.tombstone", "export.create"],
    "stable_gateway_errors": 20,
    "event_kinds": 37,
    "raw_evidence_always_available": true,
    "authoritative_pre_execution_kernel_plan": false
  },
  "memory_lifecycle": {
    "status": "experimental-bounded-lifecycle",
    "actions": ["memory.put", "memory.link", "memory.tombstone", "export.create"],
    "read_route": "memory.list",
    "provenance_relations": ["derived-from", "supports", "corrects"],
    "self_links": false,
    "correction_replaces_original": false,
    "link_deletion": false,
    "export_routes": ["exports.get", "export_bundles.get"],
    "bundle_reveal": "explicit-user-action-only",
    "persistent_browser_storage": false,
    "hard_delete": false,
    "restore": false,
    "sharing": false
  },
  "surfaces": [
    "overview",
    "ask",
    "approvals",
    "vault",
    "receipts",
    "share",
    "explore"
  ],
  "gateway_routes": [
    "status.get",
    "capabilities.list",
    "operations.get",
    "intents.submit",
    "approvals.list",
    "memory.list",
    "exports.get",
    "export_bundles.get",
    "events.list",
    "nodes.list",
    "capsules.list",
    "imports.list",
    "backups.list",
    "audit.verify"
  ],
  "non_claims": [
    "supported-product",
    "production-promotion",
    "browser-session-security-complete",
    "external-ai-enabled",
    "sharing-enabled",
    "circles-enabled",
    "live-deployment"
  ]
}
