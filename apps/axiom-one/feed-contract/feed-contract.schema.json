{"$id":"https://axiom-mesh.local/contracts/feed-contract.v1","$schema":"https://json-schema.org/draft/2020-12/schema","definitions":{"audience":{"description":"Audience descriptor. malformed → whole request fails 400, no partial results.","pattern":"^(public|intimate|named:[A-Za-z0-9._-]+|circle:[A-Za-z0-9._-]+)$","type":"string"},"draftCard":{"additionalProperties":false,"properties":{"auto_approve_eligible":{"description":"Widening drafts are never eligible for standing-rule auto-approve.","type":"boolean"},"created_at":{"format":"date-time","type":"string"},"draft_id":{"pattern":"^fd_[A-Za-z0-9_.-]{1,120}$","type":"string"},"kind":{"$ref":"#/definitions/feedItemKind"},"proposed_scope":{"maxLength":120,"minLength":1,"type":"string"},"scope_delta":{"description":"Computed server-side, shown verbatim. Widening deltas always carry the per-item marker.","type":"string"},"source_scope":{"maxLength":120,"minLength":1,"type":"string"},"widening":{"type":"boolean"}},"required":["draft_id","kind","source_scope","proposed_scope","scope_delta","created_at","widening","auto_approve_eligible"],"type":"object"},"draftsResponse":{"additionalProperties":false,"properties":{"drafts":{"items":{"$ref":"#/definitions/draftCard"},"type":"array"}},"required":["drafts"],"type":"object"},"errorCode":{"enum":["validation_error","not_found","not_authorized_for_audience","rescind_refused","mock_limitation"],"type":"string"},"errorResponse":{"additionalProperties":false,"properties":{"error":{"additionalProperties":false,"properties":{"code":{"$ref":"#/definitions/errorCode"},"message":{"maxLength":500,"type":"string"}},"required":["code","message"],"type":"object"},"mock":{"const":true,"type":"boolean"},"trace_id":{"maxLength":160,"minLength":8,"type":"string"}},"required":["error","trace_id"],"type":"object"},"feedItemKind":{"enum":["note","essay","link","media","track","share"],"type":"string"},"feedListResponse":{"additionalProperties":false,"properties":{"items":{"description":"Sequence order, newest first. Rescinded items excluded server-side — no placeholders, no countable gaps.","items":{"$ref":"#/definitions/projection"},"maxItems":100,"type":"array"},"next_cursor":{"description":"Opaque cursor for the next page; null when the page is the tail.","type":["string","null"]},"server_seq":{"description":"Feed sequence number at read time; the client uses it for cache invalidation.","minimum":0,"type":"integer"}},"required":["items","next_cursor","server_seq"],"type":"object"},"ledgerRecord":{"additionalProperties":false,"properties":{"at":{"format":"date-time","type":"string"},"attestations":{"items":{"$ref":"#/definitions/rescindAttestation"},"type":"array"},"item_id":{"pattern":"^fi_[A-Za-z0-9_.-]{1,120}$","type":"string"},"local_effects":{"items":{"$ref":"#/definitions/rescindLocalEffect"},"type":"array"},"reason":{"maxLength":500,"type":"string"},"rescind_id":{"pattern":"^rs_[A-Za-z0-9_.-]{1,120}$","type":"string"},"scope_after":{"maxLength":120,"type":"string"},"scope_before":{"maxLength":120,"minLength":1,"type":"string"},"tombstone_id":{"pattern":"^ts_[A-Za-z0-9_.-]{1,120}$","type":"string"}},"required":["rescind_id","item_id","scope_before","scope_after","tombstone_id","attestations","local_effects","at"],"type":"object"},"ledgerResponse":{"additionalProperties":false,"properties":{"records":{"items":{"$ref":"#/definitions/ledgerRecord"},"type":"array"}},"required":["records"],"type":"object"},"projection":{"additionalProperties":false,"properties":{"audience":{"$ref":"#/definitions/audience"},"author":{"maxLength":200,"minLength":1,"type":"string"},"compiled_at":{"format":"date-time","type":"string"},"digest":{"pattern":"^sha256:[A-Za-z0-9_.-]{1,128}$","type":"string"},"identity_version":{"minimum":1,"type":"integer"},"item_id":{"pattern":"^fi_[A-Za-z0-9_.-]{1,120}$","type":"string"},"kind":{"$ref":"#/definitions/feedItemKind"},"payload":{"additionalProperties":false,"description":"Audience-compiled content. The client never sees other audiences' payloads.","properties":{"link_url":{"maxLength":2000,"type":"string"},"text":{"maxLength":20000,"type":"string"},"title":{"maxLength":300,"type":"string"}},"required":["text"],"type":"object"},"projection_id":{"pattern":"^fp_[A-Za-z0-9_.-]{1,120}$","type":"string"},"ref":{"maxLength":2000,"type":"string"},"sent_at":{"format":"date-time","type":"string"}},"required":["projection_id","item_id","digest","compiled_at","identity_version","kind","sent_at","author","audience","payload"],"type":"object"},"rescindAttestation":{"additionalProperties":false,"properties":{"at":{"format":"date-time","type":"string"},"attestation_id":{"pattern":"^ra_[A-Za-z0-9_.-]{1,120}$","type":"string"},"response":{"maxLength":500,"type":"string"},"sent_to":{"maxLength":200,"minLength":1,"type":"string"}},"required":["attestation_id","sent_to","at"],"type":"object"},"rescindLocalEffect":{"additionalProperties":false,"properties":{"action":{"maxLength":120,"minLength":1,"type":"string"},"at":{"format":"date-time","type":"string"},"surface":{"maxLength":120,"minLength":1,"type":"string"}},"required":["surface","action","at"],"type":"object"},"rescindResponse":{"additionalProperties":false,"properties":{"attestations":{"items":{"$ref":"#/definitions/rescindAttestation"},"type":"array"},"local_effects":{"items":{"$ref":"#/definitions/rescindLocalEffect"},"minItems":1,"type":"array"},"mock_only":{"const":true,"description":"Stub marker. The real feed.rescind is a signed act with mirror-registry sourcing (F-7); the mock only flips local state.","type":"boolean"},"rescind_id":{"pattern":"^rs_[A-Za-z0-9_.-]{1,120}$","type":"string"},"rescinded_at":{"format":"date-time","type":"string"},"tombstone_id":{"pattern":"^ts_[A-Za-z0-9_.-]{1,120}$","type":"string"},"ui_copy":{"description":"Verbatim ledger line the UI shows: 'removed everywhere you control; N mirrors asked, M honored.'","type":"string"}},"required":["rescind_id","tombstone_id","rescinded_at","attestations","local_effects","ui_copy","mock_only"],"type":"object"}},"description":"Typed interface the PWA uses to read the unified presence feed. Mocks + loopback stubs only. Real wiring follows F-1..F-3 (presence-post registry adoption). Until then the scope labels carried here are mock annotations, not registry claims.","title":"AXIOM One PWA feed contract — scaffolding (DESIGN-ONLY)","type":"object"}