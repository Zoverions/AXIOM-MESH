{
  "schema": "axiom-agent-linux-isolation-adapter-threat-model.v1",
  "phase": "fixed-probe-linux-kernel-isolation",
  "core_invariant": "A successful fixed isolation probe is evidence about that tested boundary, not permission to execute arbitrary repository work, physical-device proof, or production executor authority.",
  "effect_scope": {
    "disposable_local_container_create_start_kill_remove": true,
    "fixed_probe_process_execution": true,
    "disposable_container_tmpfs_mutation": true,
    "denied_network_privilege_root_write_escape_attempts": true,
    "runner_artifact_receipt_write": true,
    "caller_supplied_image_or_command": false,
    "repository_bind_mount": false,
    "host_root_bind_mount": false,
    "docker_socket_mount": false,
    "credential_or_secret_mount": false,
    "probe_network_connectivity": false,
    "remote_execution": false,
    "contributed_hardware_control": false,
    "production_node_enrollment": false,
    "deployment_authority": false,
    "capability_promotion": false
  },
  "attack_classes": [
    "caller-controlled-image-or-command-smuggling",
    "docker-socket-or-host-root-mount-smuggling",
    "ambient-runner-secret-or-environment-inheritance",
    "container-root-write-or-symlink-write-escape",
    "network-egress-or-namespace-substitution",
    "capability-or-privilege-escalation",
    "seccomp-disable-or-profile-substitution",
    "pid-tree-escape-or-unbounded-process-fanout",
    "cpu-memory-pid-limit-omission-or-widening",
    "probe-timeout-leaving-live-container-state",
    "output-flood-bypassing-host-output-ceiling",
    "cleanup-failure-represented-as-success",
    "hosted-ci-evidence-promoted-to-physical-device-proof",
    "fixed-probe-evidence-promoted-to-arbitrary-repository-execution-authority",
    "receipt-digest-or-policy-binding-substitution",
    "production-runtime-import-of-effect-capable-lab-code"
  ],
  "required_controls": [
    "absolute-docker-binary",
    "fixed-repository-built-image-tag-and-resolved-image-id",
    "argv-array-only-docker-invocation",
    "no-shell-execution",
    "network-none",
    "read-only-container-root",
    "no-bind-mounts",
    "cap-drop-all",
    "no-new-privileges",
    "non-root-uid-gid",
    "bounded-tmpfs-workspaces",
    "cpu-memory-pid-ceilings",
    "bounded-output-and-time",
    "deterministic-container-cleanup",
    "fail-closed-unknown-or-ambiguous-probe-result",
    "separate-pure-receipt-verifier",
    "no-production-runtime-import"
  ],
  "promotion_blockers": [
    "no-arbitrary-repository-task-execution",
    "no-dry-run-plan-to-real-effect-mapping",
    "no-production-grade-current-revocation-check-at-effect-time",
    "no-production-lifecycle-consumption-integration",
    "no-executor-originated-general-effect-receipt",
    "no-physical-device-isolation-evidence",
    "no-independent-external-effect-security-review",
    "no-production-promotion"
  ],
  "boundaries": {
    "physical_device_proof": false,
    "globally_verified_platform_isolation": false,
    "arbitrary_repository_code_isolation_verified": false,
    "compiled_plan_effect_admission": false,
    "production_executor_ready": false,
    "remote_execution_enabled": false,
    "remote_administration_enabled": false,
    "credential_access_enabled": false,
    "secret_access_enabled": false,
    "production_node_enrollment_enabled": false,
    "deployment_authority": false,
    "capability_promotion_authority": false,
    "authority_granted": false
  }
}
