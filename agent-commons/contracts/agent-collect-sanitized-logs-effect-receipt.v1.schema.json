{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/agent-collect-sanitized-logs-effect-receipt.v1.schema.json",
  "title": "AXIOM Agent Collect Sanitized Logs Effect Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "statement", "statement_digest", "executor_signature", "receipt_digest"],
  "properties": {
    "schema": { "const": "axiom-agent-collect-sanitized-logs-effect-receipt.v1" },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor_id", "executor_key_id", "executor_version", "policy_digest", "repository", "revision",
        "admission_digest", "plan_digest", "authorization_id", "authorization_digest", "sponsor_id", "subject_id",
        "lifecycle_ledger_id", "lifecycle_key_id", "lifecycle_pre_effect_head_digest",
        "lifecycle_consumption_event_digest", "lifecycle_final_head_digest", "lifecycle_final_receipt_digest",
        "durable_store_id", "durable_consume_generation", "durable_consume_record_digest",
        "durable_consume_head_receipt_digest", "durable_final_generation", "durable_final_record_digest",
        "isolation_receipt_digest", "isolation_adapter_id", "image_id", "operation_id", "sanitization_policy_id",
        "adapter_script_sha256", "source_logical_path", "started_at", "finished_at", "observation",
        "cleanup_verified", "revocation_state", "known_signed_head_only", "global_currentness_claimed",
        "dry_run_plan_effect_reachable", "laboratory_effect_admission_observed",
        "durable_consumption_before_effect_observed", "real_process_effect_observed",
        "disposable_filesystem_write_observed", "disposable_filesystem_read_observed",
        "sanitization_allowlist_observed", "arbitrary_path_used", "host_or_repository_logs_read",
        "repository_code_executed", "repository_workspace_mutated", "network_performed",
        "credentials_retrieved", "secrets_retrieved", "service_controlled", "package_installed",
        "remote_execution_enabled", "remote_hardware_accessed", "production_enrollment",
        "deployment_authority", "capability_promoted", "task_success_claimed",
        "general_executor_available", "axiom_authority_granted"
      ],
      "properties": {
        "executor_id": { "const": "agent-commons.linux-collect-sanitized-logs-effect" },
        "executor_key_id": { "$ref": "#/$defs/digest" },
        "executor_version": { "const": 1 },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "repository": { "const": "Zoverions/AXIOM-MESH" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "admission_digest": { "$ref": "#/$defs/digest" },
        "plan_digest": { "$ref": "#/$defs/digest" },
        "authorization_id": { "$ref": "#/$defs/id" },
        "authorization_digest": { "$ref": "#/$defs/digest" },
        "sponsor_id": { "$ref": "#/$defs/id" },
        "subject_id": { "$ref": "#/$defs/id" },
        "lifecycle_ledger_id": { "$ref": "#/$defs/id" },
        "lifecycle_key_id": { "$ref": "#/$defs/digest" },
        "lifecycle_pre_effect_head_digest": { "$ref": "#/$defs/digest" },
        "lifecycle_consumption_event_digest": { "$ref": "#/$defs/digest" },
        "lifecycle_final_head_digest": { "$ref": "#/$defs/digest" },
        "lifecycle_final_receipt_digest": { "$ref": "#/$defs/digest" },
        "durable_store_id": { "$ref": "#/$defs/id" },
        "durable_consume_generation": { "type": "integer", "minimum": 2 },
        "durable_consume_record_digest": { "$ref": "#/$defs/digest" },
        "durable_consume_head_receipt_digest": { "$ref": "#/$defs/digest" },
        "durable_final_generation": { "type": "integer", "minimum": 3 },
        "durable_final_record_digest": { "$ref": "#/$defs/digest" },
        "isolation_receipt_digest": { "$ref": "#/$defs/digest" },
        "isolation_adapter_id": { "const": "docker-linux-isolation-lab-v1" },
        "image_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "operation_id": { "const": "collect-sanitized-logs" },
        "sanitization_policy_id": { "const": "synthetic-jsonl-allowlist-v1" },
        "adapter_script_sha256": { "$ref": "#/$defs/digest" },
        "source_logical_path": { "const": "work/session/logs/lab.jsonl" },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "finished_at": { "$ref": "#/$defs/timestamp" },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter_script_sha256", "source_logical_path", "source_record_count", "source_bytes",
            "sanitized_record_count", "sanitized_output", "output_sha256", "output_bytes",
            "source_open_nofollow", "source_regular_file", "source_inside_disposable_workspace",
            "forbidden_sentinel_absent", "exit_status", "stderr_empty", "network_mode",
            "repository_code_execution", "container_absent_after_cleanup"
          ],
          "properties": {
            "adapter_script_sha256": { "$ref": "#/$defs/digest" },
            "source_logical_path": { "const": "work/session/logs/lab.jsonl" },
            "source_record_count": { "type": "integer", "minimum": 1, "maximum": 16 },
            "source_bytes": { "type": "integer", "minimum": 1, "maximum": 8192 },
            "sanitized_record_count": { "type": "integer", "minimum": 1, "maximum": 16 },
            "sanitized_output": { "type": "string", "minLength": 2, "maxLength": 4096 },
            "output_sha256": { "$ref": "#/$defs/digest" },
            "output_bytes": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "source_open_nofollow": { "const": true },
            "source_regular_file": { "const": true },
            "source_inside_disposable_workspace": { "const": true },
            "forbidden_sentinel_absent": { "const": true },
            "exit_status": { "const": 0 },
            "stderr_empty": { "const": true },
            "network_mode": { "const": "none" },
            "repository_code_execution": { "const": false },
            "container_absent_after_cleanup": { "const": true }
          }
        },
        "cleanup_verified": { "const": true },
        "revocation_state": { "const": "active" },
        "known_signed_head_only": { "const": true },
        "global_currentness_claimed": { "const": false },
        "dry_run_plan_effect_reachable": { "const": false },
        "laboratory_effect_admission_observed": { "const": true },
        "durable_consumption_before_effect_observed": { "const": true },
        "real_process_effect_observed": { "const": true },
        "disposable_filesystem_write_observed": { "const": true },
        "disposable_filesystem_read_observed": { "const": true },
        "sanitization_allowlist_observed": { "const": true },
        "arbitrary_path_used": { "const": false },
        "host_or_repository_logs_read": { "const": false },
        "repository_code_executed": { "const": false },
        "repository_workspace_mutated": { "const": false },
        "network_performed": { "const": false },
        "credentials_retrieved": { "const": false },
        "secrets_retrieved": { "const": false },
        "service_controlled": { "const": false },
        "package_installed": { "const": false },
        "remote_execution_enabled": { "const": false },
        "remote_hardware_accessed": { "const": false },
        "production_enrollment": { "const": false },
        "deployment_authority": { "const": false },
        "capability_promoted": { "const": false },
        "task_success_claimed": { "const": false },
        "general_executor_available": { "const": false },
        "axiom_authority_granted": { "const": false }
      }
    },
    "statement_digest": { "$ref": "#/$defs/digest" },
    "executor_signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 256 },
    "receipt_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}