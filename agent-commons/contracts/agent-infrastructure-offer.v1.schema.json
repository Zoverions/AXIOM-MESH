{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/agent-infrastructure-offer.v1.schema.json",
  "title": "AXIOM Agent Infrastructure Offer v1",
  "description": "Experimental Agent Commons hardware/test-capacity offer. An offer is discovery metadata only and grants no node admission, execution, credential, production, purchase, or payment authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "offer_id", "repository", "publisher", "node_profile", "custody", "availability", "challenge_classes", "evidence", "boundaries"],
  "properties": {
    "schema": { "const": "axiom-agent-infrastructure-offer.v1" },
    "offer_id": { "$ref": "#/$defs/id" },
    "repository": { "const": "Zoverions/AXIOM-MESH" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["human", "machine", "organization"] },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "node_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "profile_id", "profile_sha256"],
      "properties": {
        "schema": { "const": "axiom-compute-node-profile.v1" },
        "profile_id": { "$ref": "#/$defs/id" },
        "profile_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_control", "remote_access_available"],
      "properties": {
        "physical_control": { "enum": ["contributor", "organization", "shared-lab", "unknown"] },
        "remote_access_available": { "type": "boolean" }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts_at", "expires_at", "maximum_sessions"],
      "properties": {
        "starts_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "maximum_sessions": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "challenge_classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/challengeClass" }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_status", "evidence_refs"],
      "properties": {
        "fact_status": { "enum": ["declared", "measured", "reproduced", "externally-verified"] },
        "evidence_refs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destructive_actions_allowed", "production_enrollment_allowed", "credential_issuance_allowed", "secret_access_allowed", "firmware_changes_allowed", "purchases_allowed", "authority_granted", "payment_promised"],
      "properties": {
        "destructive_actions_allowed": { "const": false },
        "production_enrollment_allowed": { "const": false },
        "credential_issuance_allowed": { "const": false },
        "secret_access_allowed": { "const": false },
        "firmware_changes_allowed": { "const": false },
        "purchases_allowed": { "const": false },
        "authority_granted": { "const": false },
        "payment_promised": { "const": false }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "challengeClass": { "enum": ["hardware-validation", "test-node-provisioning", "deployment-reproduction", "infrastructure-diagnostics", "support-assistance", "device-lab-capacity"] }
  }
}
