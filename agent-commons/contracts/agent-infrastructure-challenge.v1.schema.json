{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/agent-infrastructure-challenge.v1.schema.json",
  "title": "AXIOM Agent Infrastructure Challenge v1",
  "description": "Experimental bounded hardware/infrastructure test challenge. It authorizes no production enrollment, credential issuance, secret access, firmware change, purchase, destructive repair, or ambient execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "challenge_id", "repository", "base_sha", "class", "target", "plan", "acceptance", "evidence_requirements", "security_reporting", "boundaries", "expires_at"],
  "properties": {
    "schema": { "const": "axiom-agent-infrastructure-challenge.v1" },
    "challenge_id": { "$ref": "#/$defs/id" },
    "repository": { "const": "Zoverions/AXIOM-MESH" },
    "base_sha": { "$ref": "#/$defs/sha40" },
    "class": { "$ref": "#/$defs/challengeClass" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offer_id", "node_profile_sha256"],
      "properties": {
        "offer_id": { "$ref": "#/$defs/id" },
        "node_profile_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_operations", "prohibited_operations", "network"],
      "properties": {
        "allowed_operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeOperation" }
        },
        "prohibited_operations": {
          "type": "array",
          "minItems": 8,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/prohibitedOperation" }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "allowed_origins", "credentials_allowed"],
          "properties": {
            "mode": { "enum": ["none", "bounded-public-read", "owner-lan"] },
            "allowed_origins": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 512 }
            },
            "credentials_allowed": { "const": false }
          }
        }
      }
    },
    "acceptance": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/text" } },
    "evidence_requirements": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/text" } },
    "security_reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_safe", "private_route"],
      "properties": {
        "public_safe": { "type": "boolean" },
        "private_route": { "const": "SECURITY.md" }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_enrollment_allowed", "credential_issuance_allowed", "secret_access_allowed", "firmware_changes_allowed", "purchases_allowed", "destructive_actions_allowed", "authority_granted", "payment_promised"],
      "properties": {
        "production_enrollment_allowed": { "const": false },
        "credential_issuance_allowed": { "const": false },
        "secret_access_allowed": { "const": false },
        "firmware_changes_allowed": { "const": false },
        "purchases_allowed": { "const": false },
        "destructive_actions_allowed": { "const": false },
        "authority_granted": { "const": false },
        "payment_promised": { "const": false }
      }
    },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" },
    "sha40": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "challengeClass": { "enum": ["hardware-validation", "test-node-provisioning", "deployment-reproduction", "infrastructure-diagnostics", "support-assistance", "device-lab-capacity"] },
    "safeOperation": { "enum": ["read-system-facts", "create-disposable-workspace", "install-test-dependencies", "run-build", "run-tests", "start-local-test-services", "collect-sanitized-logs", "collect-benchmark-metrics", "reset-disposable-workspace"] },
    "prohibitedOperation": { "enum": ["production-node-enrollment", "credential-issuance", "secret-retrieval", "firmware-change", "boot-chain-change", "disk-erasure", "purchase-or-subscription", "security-boundary-weakening", "unbounded-remote-shell", "permanent-system-mutation"] }
  }
}
