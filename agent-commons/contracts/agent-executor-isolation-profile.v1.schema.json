{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/agent-executor-isolation-profile.v1.schema.json",
  "title": "AXIOM Agent Executor Isolation Profile v1",
  "description": "Experimental pre-effect requirement/evidence profile for one reviewed OS isolation policy. Validation grants no process, filesystem, network, credential, remote-administration, production or capability authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_id",
    "platform_profile_digest",
    "operating_system",
    "architecture",
    "policy",
    "evidence",
    "requirements",
    "claims"
  ],
  "properties": {
    "schema": { "const": "axiom-agent-executor-isolation-profile.v1" },
    "profile_id": { "$ref": "#/$defs/id" },
    "platform_profile_digest": { "$ref": "#/$defs/sha256" },
    "operating_system": { "enum": ["linux", "macos", "windows"] },
    "architecture": { "enum": ["x64", "arm64"] },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_schema", "catalog_digest", "policy_id", "revision"],
      "properties": {
        "catalog_schema": { "const": "axiom-agent-executor-isolation-policy-catalog.v1" },
        "catalog_digest": { "$ref": "#/$defs/sha256" },
        "policy_id": { "$ref": "#/$defs/id" },
        "revision": { "const": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observation_environment", "refs", "real_effects_observed"],
      "properties": {
        "status": { "enum": ["declared", "measured", "reproduced", "externally-verified"] },
        "observation_environment": { "enum": ["unspecified", "hosted-ci", "physical-device", "external-lab"] },
        "refs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "real_effects_observed": { "const": false }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "common_controls",
        "mechanism_families",
        "repository_code_boundary",
        "hosted_ci_sufficient",
        "physical_device_evidence_required_before_production_promotion"
      ],
      "properties": {
        "common_controls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "mechanism_families": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "repository_code_boundary": { "type": "string", "minLength": 1, "maxLength": 256 },
        "hosted_ci_sufficient": { "const": false },
        "physical_device_evidence_required_before_production_promotion": { "const": true }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_isolation_verified",
        "repository_code_isolation_verified",
        "effect_reachable",
        "production_executor_ready",
        "remote_execution_enabled",
        "production_node_enrollment",
        "deployment_authority",
        "capability_promoted",
        "authority_granted"
      ],
      "properties": {
        "platform_isolation_verified": { "const": false },
        "repository_code_isolation_verified": { "const": false },
        "effect_reachable": { "const": false },
        "production_executor_ready": { "const": false },
        "remote_execution_enabled": { "const": false },
        "production_node_enrollment": { "const": false },
        "deployment_authority": { "const": false },
        "capability_promoted": { "const": false },
        "authority_granted": { "const": false }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
