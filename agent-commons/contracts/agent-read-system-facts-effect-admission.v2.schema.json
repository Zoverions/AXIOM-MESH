{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/agent-read-system-facts-effect-admission.v2.schema.json",
  "title": "AXIOM Agent Read System Facts Effect Admission v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "statement", "statement_digest", "issuer_signature", "admission_digest"],
  "properties": {
    "schema": { "const": "axiom-agent-read-system-facts-effect-admission.v2" },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission_id",
        "issuer_id",
        "issuer_key_id",
        "repository",
        "revision",
        "handoff_digest",
        "handoff_id",
        "sender_principal_id",
        "executor_principal_id",
        "executor_credential_digest",
        "action",
        "input_digest",
        "consumption_record_digest",
        "consumption_storage_key",
        "consumption_effect_at",
        "currentness_set_digest",
        "isolation_policy_id",
        "isolation_policy_revision",
        "isolation_policy_digest",
        "not_before",
        "expires_at",
        "admission_kind",
        "fixed_operation_only",
        "consumption_record_required",
        "effect_boundary_currentness_recheck_required",
        "effect_already_executed",
        "general_executor_authority",
        "repository_code_execution_authority",
        "arbitrary_command_authority",
        "arbitrary_path_authority",
        "network_authority",
        "credential_authority",
        "secret_authority",
        "remote_hardware_authority",
        "production_authority",
        "deployment_authority",
        "capability_promotion_authority",
        "global_currentness_claimed",
        "task_success_claimed",
        "truth_claimed",
        "application_correctness_claimed",
        "authority_effect",
        "delegation_effect"
      ],
      "properties": {
        "admission_id": { "type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$" },
        "issuer_id": { "type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$" },
        "issuer_key_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "repository": { "const": "Zoverions/AXIOM-MESH" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "handoff_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "handoff_id": { "type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$" },
        "sender_principal_id": { "type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$" },
        "executor_principal_id": { "type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$" },
        "executor_credential_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "action": { "const": "agent.read-system-facts" },
        "input_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "consumption_record_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "consumption_storage_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "consumption_effect_at": { "type": "string", "format": "date-time" },
        "currentness_set_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "isolation_policy_id": { "const": "linux-read-system-facts-fixed-v1" },
        "isolation_policy_revision": { "const": 1 },
        "isolation_policy_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "not_before": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "admission_kind": { "const": "fixed-consumed-handoff-effect-admission" },
        "fixed_operation_only": { "const": true },
        "consumption_record_required": { "const": true },
        "effect_boundary_currentness_recheck_required": { "const": true },
        "effect_already_executed": { "const": false },
        "general_executor_authority": { "const": false },
        "repository_code_execution_authority": { "const": false },
        "arbitrary_command_authority": { "const": false },
        "arbitrary_path_authority": { "const": false },
        "network_authority": { "const": false },
        "credential_authority": { "const": false },
        "secret_authority": { "const": false },
        "remote_hardware_authority": { "const": false },
        "production_authority": { "const": false },
        "deployment_authority": { "const": false },
        "capability_promotion_authority": { "const": false },
        "global_currentness_claimed": { "const": false },
        "task_success_claimed": { "const": false },
        "truth_claimed": { "const": false },
        "application_correctness_claimed": { "const": false },
        "authority_effect": { "const": "none" },
        "delegation_effect": { "const": "none" }
      }
    },
    "statement_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "issuer_signature": { "type": "string", "minLength": 32, "maxLength": 1024, "pattern": "^[A-Za-z0-9_-]+$" },
    "admission_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
