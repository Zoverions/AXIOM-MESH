{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/agent-test-session-authorization.v1.schema.json",
  "title": "AXIOM Agent Test Session Authorization v1",
  "description": "Experimental human-sponsored authorization envelope for one bounded infrastructure test session. The envelope is not currently effect-reachable and grants no production, credential, secret, shell, firmware, purchase, deployment, or capability-promotion authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authorization_id", "repository", "sponsor", "subject", "challenge", "attestation", "timing", "scope", "revocation", "effects"],
  "properties": {
    "schema": { "const": "axiom-agent-test-session-authorization.v1" },
    "authorization_id": { "$ref": "#/$defs/id" },
    "repository": { "const": "Zoverions/AXIOM-MESH" },
    "sponsor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "approval_ref"],
      "properties": {
        "type": { "const": "human" },
        "id": { "$ref": "#/$defs/id" },
        "approval_ref": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "machine" },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challenge_id", "offer_id", "node_profile_sha256"],
      "properties": {
        "challenge_id": { "$ref": "#/$defs/id" },
        "offer_id": { "$ref": "#/$defs/id" },
        "node_profile_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestation_id", "key_fingerprint_sha256"],
      "properties": {
        "attestation_id": { "$ref": "#/$defs/id" },
        "key_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issued_at", "not_before", "expires_at", "maximum_duration_seconds"],
      "properties": {
        "issued_at": { "type": "string", "format": "date-time" },
        "not_before": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "maximum_duration_seconds": { "type": "integer", "minimum": 1, "maximum": 900 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_operations", "network", "filesystem_scope", "credentials_allowed", "secret_access_allowed", "interactive_shell_allowed", "unbounded_remote_shell_allowed"],
      "properties": {
        "allowed_operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeOperation" }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "allowed_origins"],
          "properties": {
            "mode": { "enum": ["none", "bounded-public-read", "owner-lan"] },
            "allowed_origins": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          }
        },
        "filesystem_scope": { "const": "disposable-workspace-only" },
        "credentials_allowed": { "const": false },
        "secret_access_allowed": { "const": false },
        "interactive_shell_allowed": { "const": false },
        "unbounded_remote_shell_allowed": { "const": false }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revocable", "one_time", "fail_closed_on_unknown", "revocation_ref"],
      "properties": {
        "revocable": { "const": true },
        "one_time": { "const": true },
        "fail_closed_on_unknown": { "const": true },
        "revocation_ref": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_reachable", "production_enrollment", "persistent_remote_administration", "credentials_issued", "secrets_accessed", "firmware_changed", "boot_chain_changed", "purchase_performed", "destructive_action_performed", "permanent_system_mutation", "deployment_authority", "capability_promoted"],
      "properties": {
        "effect_reachable": { "const": false },
        "production_enrollment": { "const": false },
        "persistent_remote_administration": { "const": false },
        "credentials_issued": { "const": false },
        "secrets_accessed": { "const": false },
        "firmware_changed": { "const": false },
        "boot_chain_changed": { "const": false },
        "purchase_performed": { "const": false },
        "destructive_action_performed": { "const": false },
        "permanent_system_mutation": { "const": false },
        "deployment_authority": { "const": false },
        "capability_promoted": { "const": false }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safeOperation": { "enum": ["read-system-facts", "create-disposable-workspace", "install-test-dependencies", "run-build", "run-tests", "start-local-test-services", "collect-sanitized-logs", "collect-benchmark-metrics", "reset-disposable-workspace"] }
  }
}
