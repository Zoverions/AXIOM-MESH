{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-mesh.dev/schemas/axiom-agent-currentness-checkpoint.v1.json",
  "title": "AXIOM Agent Currentness Checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "statement",
    "statement_digest",
    "observer_signature",
    "checkpoint_digest"
  ],
  "properties": {
    "schema": { "const": "axiom-agent-currentness-checkpoint.v1" },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "checkpoint_sequence",
        "predecessor_checkpoint_digest",
        "observer_id",
        "observer_key_id",
        "principal_id",
        "issuer_id",
        "evaluated_at",
        "credential_history_digest",
        "credential_digests",
        "revocation_set_digest",
        "revocation_digests",
        "currentness_status",
        "current_credential_digest",
        "current_key_epoch",
        "current_operational_key_id",
        "current_revocation_digest",
        "current_reason_code",
        "checkpoint_kind",
        "evidence_scope",
        "rollback_detection_scope",
        "global_currentness_claimed",
        "ancestor_relationship_verified",
        "effect_admission_authorized",
        "authority_effect",
        "delegation_effect"
      ],
      "properties": {
        "checkpoint_id": { "$ref": "#/$defs/id" },
        "checkpoint_sequence": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "predecessor_checkpoint_digest": {
          "anyOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "observer_id": { "$ref": "#/$defs/id" },
        "observer_key_id": { "$ref": "#/$defs/digest" },
        "principal_id": { "$ref": "#/$defs/id" },
        "issuer_id": { "$ref": "#/$defs/id" },
        "evaluated_at": { "$ref": "#/$defs/timestamp" },
        "credential_history_digest": { "$ref": "#/$defs/digest" },
        "credential_digests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        },
        "revocation_set_digest": { "$ref": "#/$defs/digest" },
        "revocation_digests": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        },
        "currentness_status": {
          "enum": ["active", "revoked", "expired", "not-yet-valid"]
        },
        "current_credential_digest": {
          "anyOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "current_key_epoch": {
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 256 },
            { "type": "null" }
          ]
        },
        "current_operational_key_id": {
          "anyOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "current_revocation_digest": {
          "anyOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "current_reason_code": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
            { "type": "null" }
          ]
        },
        "checkpoint_kind": { "const": "retained-issuer-evidence-currentness" },
        "evidence_scope": { "const": "supplied-issuer-evidence-only" },
        "rollback_detection_scope": { "const": "retained-signed-checkpoint-chain" },
        "global_currentness_claimed": { "const": false },
        "ancestor_relationship_verified": { "const": false },
        "effect_admission_authorized": { "const": false },
        "authority_effect": { "const": "none" },
        "delegation_effect": { "const": "none" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "checkpoint_sequence": { "const": 1 } },
            "required": ["checkpoint_sequence"]
          },
          "then": {
            "properties": { "predecessor_checkpoint_digest": { "type": "null" } }
          },
          "else": {
            "properties": { "predecessor_checkpoint_digest": { "$ref": "#/$defs/digest" } }
          }
        },
        {
          "if": {
            "properties": { "currentness_status": { "const": "active" } },
            "required": ["currentness_status"]
          },
          "then": {
            "properties": {
              "current_credential_digest": { "$ref": "#/$defs/digest" },
              "current_key_epoch": { "type": "integer", "minimum": 1, "maximum": 256 },
              "current_operational_key_id": { "$ref": "#/$defs/digest" },
              "current_revocation_digest": { "type": "null" },
              "current_reason_code": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "currentness_status": { "const": "revoked" } },
            "required": ["currentness_status"]
          },
          "then": {
            "properties": {
              "current_credential_digest": { "$ref": "#/$defs/digest" },
              "current_key_epoch": { "type": "integer", "minimum": 1, "maximum": 256 },
              "current_operational_key_id": { "type": "null" },
              "current_revocation_digest": { "$ref": "#/$defs/digest" },
              "current_reason_code": { "type": "string", "minLength": 1, "maxLength": 64 }
            }
          }
        },
        {
          "if": {
            "properties": { "currentness_status": { "const": "not-yet-valid" } },
            "required": ["currentness_status"]
          },
          "then": {
            "properties": {
              "current_credential_digest": { "type": "null" },
              "current_key_epoch": { "type": "null" },
              "current_operational_key_id": { "type": "null" },
              "current_revocation_digest": { "type": "null" },
              "current_reason_code": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "currentness_status": { "const": "expired" } },
            "required": ["currentness_status"]
          },
          "then": {
            "properties": {
              "current_credential_digest": { "$ref": "#/$defs/digest" },
              "current_key_epoch": { "type": "integer", "minimum": 1, "maximum": 256 },
              "current_operational_key_id": { "type": "null" },
              "current_revocation_digest": { "type": "null" },
              "current_reason_code": { "type": "null" }
            }
          }
        }
      ]
    },
    "statement_digest": { "$ref": "#/$defs/digest" },
    "observer_signature": {
      "type": "string",
      "minLength": 32,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "checkpoint_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "minLength": 24,
      "maxLength": 24
    }
  }
}
