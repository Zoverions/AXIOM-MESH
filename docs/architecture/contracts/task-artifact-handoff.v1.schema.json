{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axiom:contract:task-artifact-handoff:v1",
  "title": "AXIOM Task Artifact Handoff v1",
  "description": "Draft runtime-neutral task, artifact, lifecycle, and handoff envelope. The contract records coordination state and does not itself grant runtime authority or delegation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "causal_id",
    "requester",
    "execution_target",
    "request",
    "authority",
    "budgets",
    "lifecycle",
    "inputs",
    "outputs"
  ],
  "properties": {
    "schema": {
      "const": "axiom-task-artifact-handoff.v1"
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "causal_id": {
      "$ref": "#/$defs/id"
    },
    "parent_task_id": {
      "$ref": "#/$defs/id"
    },
    "handoff_from_task_id": {
      "$ref": "#/$defs/id"
    },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id"],
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/id"
        },
        "sponsor_principal_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "execution_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integration_id", "integration_class", "adapter_contract"],
      "properties": {
        "integration_id": {
          "$ref": "#/$defs/id"
        },
        "integration_class": {
          "enum": [
            "agent-runtime",
            "model-provider",
            "tool-service-connector",
            "protocol-adapter",
            "compute-backend",
            "evidence-oracle"
          ]
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "adapter_contract": {
          "$ref": "#/$defs/contractPin"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "purpose", "destinations"],
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/id"
        },
        "purpose": {
          "$ref": "#/$defs/id"
        },
        "destinations": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "data_classes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordination_is_authorization",
        "handoff_transfers_authority",
        "delegation_required_for_independent_child_authority"
      ],
      "properties": {
        "coordination_is_authorization": {
          "const": false
        },
        "handoff_transfers_authority": {
          "const": false
        },
        "delegation_required_for_independent_child_authority": {
          "const": true
        },
        "grant_id": {
          "$ref": "#/$defs/id"
        },
        "grant_digest": {
          "$ref": "#/$defs/sha256"
        },
        "delegation_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ms"],
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "deadline_at": {
          "$ref": "#/$defs/dateTime"
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "max_child_tasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "cost_ceiling_minor_units": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "created_at", "updated_at"],
      "properties": {
        "state": {
          "enum": [
            "queued",
            "running",
            "awaiting-approval",
            "blocked",
            "completed",
            "failed",
            "cancelled",
            "expired",
            "uncertain"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/dateTime"
        },
        "updated_at": {
          "$ref": "#/$defs/dateTime"
        },
        "cancel_requested_at": {
          "$ref": "#/$defs/dateTime"
        },
        "terminal_reason": {
          "type": "string",
          "maxLength": 1000
        },
        "terminal_receipt_id": {
          "$ref": "#/$defs/id"
        },
        "uncertainty_record_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "inputs": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "outputs": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "events": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{1,191}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "maxLength": 80
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "contractPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "contract_version", "contract_sha256"],
      "properties": {
        "contract_id": {
          "$ref": "#/$defs/id"
        },
        "contract_version": {
          "$ref": "#/$defs/version"
        },
        "contract_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256", "size_bytes", "source_principal_id"],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/id"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "mime_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "schema_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "source_principal_id": {
          "$ref": "#/$defs/id"
        },
        "source_task_id": {
          "$ref": "#/$defs/id"
        },
        "data_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "retention_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "type", "at", "actor_principal_id"],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "task.created",
            "task.started",
            "task.awaiting-approval",
            "task.blocked",
            "task.handoff",
            "artifact.observed",
            "task.cancel-requested",
            "task.cancelled",
            "task.completed",
            "task.failed",
            "task.expired",
            "task.uncertain"
          ]
        },
        "at": {
          "$ref": "#/$defs/dateTime"
        },
        "actor_principal_id": {
          "$ref": "#/$defs/id"
        },
        "detail_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
