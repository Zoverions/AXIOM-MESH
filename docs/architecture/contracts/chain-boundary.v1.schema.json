{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axiom:contract:chain-boundary:v1",
  "title": "axiom-chain-boundary.v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "chainIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "adapter_family", "namespace", "network_id", "display_name", "profile_version", "profile_sha256"],
      "properties": {
        "schema": { "const": "axiom-chain-identity.v1" },
        "adapter_family": { "type": "string", "minLength": 1, "maxLength": 64 },
        "namespace": { "type": "string", "minLength": 1, "maxLength": 64 },
        "network_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "profile_version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "profile_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "transactionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "chain", "transaction_id"],
      "properties": {
        "schema": { "const": "axiom-chain-transaction-reference.v1" },
        "chain": { "$ref": "#/$defs/chainIdentity" },
        "transaction_id": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "assetIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "chain", "asset_kind", "local_identifier", "representation_lineage"],
      "properties": {
        "schema": { "const": "axiom-chain-asset.v1" },
        "chain": { "$ref": "#/$defs/chainIdentity" },
        "asset_kind": { "enum": ["native", "token", "wrapped", "bridged", "other"] },
        "local_identifier": { "type": "string", "minLength": 1, "maxLength": 512 },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 255 },
        "symbol": { "type": "string", "minLength": 1, "maxLength": 32 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "representation_lineage": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
      }
    },
    "finalityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "chain", "model", "status", "reference", "verification_status", "evidence_sha256", "observed_at"],
      "properties": {
        "schema": { "const": "axiom-chain-finality-evidence.v1" },
        "chain": { "$ref": "#/$defs/chainIdentity" },
        "model": { "enum": ["probabilistic-depth", "finalized-checkpoint", "validity-proof-settlement", "sequencer-plus-l1", "bft-threshold", "other"] },
        "status": { "enum": ["pending", "provisional", "final", "reverted", "uncertain"] },
        "reference": { "type": "string", "minLength": 1, "maxLength": 512 },
        "verification_status": { "enum": ["unverified", "provider-reported", "independently-verified", "conflicted", "unsupported"] },
        "evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "chainObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "chain", "observation_type", "state_reference", "object_reference", "payload_sha256", "provider_id", "adapter_id", "adapter_version", "observed_at", "finality_status", "verification_status"],
      "properties": {
        "schema": { "const": "axiom-chain-observation.v1" },
        "chain": { "$ref": "#/$defs/chainIdentity" },
        "observation_type": { "enum": ["block", "transaction", "receipt", "event", "account-state", "contract-state", "other"] },
        "state_reference": { "type": "string", "minLength": 1, "maxLength": 512 },
        "object_reference": { "type": "string", "minLength": 1, "maxLength": 512 },
        "payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "provider_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "adapter_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "observed_at": { "type": "string", "format": "date-time" },
        "finality_status": { "enum": ["pending", "provisional", "final", "reverted", "uncertain"] },
        "verification_status": { "enum": ["unverified", "provider-reported", "independently-verified", "conflicted", "unsupported"] }
      }
    },
    "settlementEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "obligation_ref", "transaction", "asset", "amount_minor_units", "unit", "payee_binding", "finality", "adapter_evidence_sha256", "observed_at", "status"],
      "properties": {
        "schema": { "const": "axiom-chain-settlement-evidence.v1" },
        "obligation_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "transaction": { "$ref": "#/$defs/transactionReference" },
        "asset": { "$ref": "#/$defs/assetIdentity" },
        "amount_minor_units": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "payee_binding": { "type": "string", "minLength": 1, "maxLength": 256 },
        "finality": { "$ref": "#/$defs/finalityEvidence" },
        "adapter_evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "observed_at": { "type": "string", "format": "date-time" },
        "status": { "enum": ["observed", "verified", "final", "disputed", "reverted", "failed"] },
        "remainder_minor_units": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "anchorEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "local_sha256", "transaction", "finality", "adapter_evidence_sha256", "observed_at"],
      "properties": {
        "schema": { "const": "axiom-chain-anchor-evidence.v1" },
        "local_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "transaction": { "$ref": "#/$defs/transactionReference" },
        "finality": { "$ref": "#/$defs/finalityEvidence" },
        "adapter_evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "bridgeRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "source_chain", "destination_chain", "source_asset", "destination_asset", "provider_id", "provider_version", "mechanism", "custody_model", "trust_model", "assumptions", "contract_dependencies", "representation_change", "estimated_fee_minor_units", "fee_unit", "estimated_latency_seconds", "source_finality_requirement", "destination_finality_requirement", "operational_dependencies", "evidence_timestamp", "local_risk_classification", "required_execution_capability"],
      "properties": {
        "schema": { "const": "axiom-chain-bridge-route.v1" },
        "source_chain": { "$ref": "#/$defs/chainIdentity" },
        "destination_chain": { "$ref": "#/$defs/chainIdentity" },
        "source_asset": { "$ref": "#/$defs/assetIdentity" },
        "destination_asset": { "$ref": "#/$defs/assetIdentity" },
        "provider_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "provider_version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "mechanism": { "type": "string", "minLength": 1, "maxLength": 256 },
        "custody_model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "trust_model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "assumptions": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "contract_dependencies": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "representation_change": { "type": "string", "minLength": 1, "maxLength": 256 },
        "estimated_fee_minor_units": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "fee_unit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "estimated_latency_seconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "source_finality_requirement": { "type": "string", "minLength": 1, "maxLength": 256 },
        "destination_finality_requirement": { "type": "string", "minLength": 1, "maxLength": 256 },
        "operational_dependencies": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "evidence_timestamp": { "type": "string", "format": "date-time" },
        "local_risk_classification": { "type": "string", "minLength": 1, "maxLength": 256 },
        "required_execution_capability": { "const": "chain.bridge.execute" }
      }
    }
  }
}
