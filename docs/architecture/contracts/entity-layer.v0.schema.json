{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"axiom-entity-layer.v0",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","version","status","layer_id","layer_version","layer_class","artifact_ref","artifact_digest","authors","adopter_principal_id","endorsement_mode","provenance_refs","influence_scopes","privacy_class","mutability","dependencies","conflicts","predecessor_layer_ref","created_at","adopted_at","expires_at","contains_raw_private_content","authority_effect","network_effect","runtime_activation"],
  "properties":{
    "schema":{"const":"axiom-entity-layer.v0"},
    "version":{"const":0},
    "status":{"const":"inert-contract-laboratory"},
    "layer_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"},
    "layer_version":{"type":"integer","minimum":0},
    "layer_class":{"enum":["constitution","worldview","judgment","disposition","culture","domain","skill","relationship","personal-grounding","presentation","self-authored"]},
    "artifact_ref":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"},
    "artifact_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "authors":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"}},
    "adopter_principal_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"},
    "endorsement_mode":{"enum":["none","human","entity","joint","governance"]},
    "provenance_refs":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"}},
    "influence_scopes":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"enum":["reasoning-guidance","judgment-heuristic","conversation-disposition","retrieval-preference","presentation","domain-workflow","relationship-expectation"]}},
    "privacy_class":{"enum":["public","shared","private","sealed"]},
    "mutability":{"enum":["immutable","replaceable","evolvable","ephemeral"]},
    "dependencies":{"type":"array","maxItems":16,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"}},
    "conflicts":{"type":"array","maxItems":16,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"}},
    "predecessor_layer_ref":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"}]},
    "created_at":{"type":"string","format":"date-time","maxLength":64},
    "adopted_at":{"type":"string","format":"date-time","maxLength":64},
    "expires_at":{"anyOf":[{"type":"null"},{"type":"string","format":"date-time","maxLength":64}]},
    "contains_raw_private_content":{"const":false},
    "authority_effect":{"const":"none"},
    "network_effect":{"const":"none"},
    "runtime_activation":{"const":false}
  },
  "allOf":[
    {"if":{"properties":{"layer_class":{"const":"personal-grounding"}},"required":["layer_class"]},"then":{"properties":{"privacy_class":{"enum":["private","sealed"]}}}},
    {"if":{"properties":{"mutability":{"const":"ephemeral"}},"required":["mutability"]},"then":{"properties":{"expires_at":{"type":"string","format":"date-time"}}},"else":{"properties":{"expires_at":{"type":"null"}}}}
  ]
}
