{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/secret-reference.v1.schema.json",
  "title": "AXIOM Secret Reference v1",
  "description": "Documentation-only closed contract for an opaque reference to secret material held under AXIOM-local, external-provider, or hardware-backed custody. The object contains no secret bytes and grants no authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "secret_ref_id",
    "owner_subject_ref",
    "secret_class",
    "custody",
    "status",
    "created_at",
    "plaintext_embedded",
    "secret_material_in_reference",
    "raw_key_material_embedded",
    "grants_secret_use_authority",
    "grants_effect_authority"
  ],
  "properties": {
    "schema": {
      "const": "axiom-secret-reference.v1"
    },
    "secret_ref_id": {
      "$ref": "#/$defs/id"
    },
    "owner_subject_ref": {
      "$ref": "#/$defs/id"
    },
    "secret_class": {
      "enum": [
        "password",
        "api-token",
        "oauth-credential",
        "private-key",
        "signing-key",
        "certificate-key",
        "recovery-secret",
        "payment-credential",
        "other"
      ]
    },
    "custody": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "local_secret_object_ref"
          ],
          "properties": {
            "mode": {
              "const": "axiom-local"
            },
            "local_secret_object_ref": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "provider_id",
            "provider_secret_ref"
          ],
          "properties": {
            "mode": {
              "const": "external-provider"
            },
            "provider_id": {
              "$ref": "#/$defs/id"
            },
            "provider_secret_ref": {
              "$ref": "#/$defs/opaque"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "provider_id",
            "hardware_key_ref"
          ],
          "properties": {
            "mode": {
              "const": "hardware-backed"
            },
            "provider_id": {
              "$ref": "#/$defs/id"
            },
            "hardware_key_ref": {
              "$ref": "#/$defs/opaque"
            }
          }
        }
      ]
    },
    "status": {
      "enum": [
        "active",
        "rotating",
        "revoked",
        "expired",
        "destroyed",
        "unavailable"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "rotated_from_ref": {
      "$ref": "#/$defs/id"
    },
    "plaintext_embedded": {
      "const": false
    },
    "secret_material_in_reference": {
      "const": false
    },
    "raw_key_material_embedded": {
      "const": false
    },
    "grants_secret_use_authority": {
      "const": false
    },
    "grants_effect_authority": {
      "const": false
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    },
    "opaque": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
