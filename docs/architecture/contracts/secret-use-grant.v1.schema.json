{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/secret-use-grant.v1.schema.json",
  "title": "AXIOM Secret Use Grant v1",
  "description": "Documentation-only closed contract for one-use, purpose- and destination-bound secret use. It explicitly forbids reveal, export, persistence, logging, model-context exposure, requester access to secret bytes, and delegation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "grant_id",
    "principal_ref",
    "secret_ref_id",
    "operation",
    "purpose",
    "destination",
    "issued_at",
    "expires_at",
    "policy_decision_ref",
    "receipt_reservation_ref",
    "one_use",
    "delegable",
    "permits_reveal",
    "permits_export",
    "permits_persistence",
    "permits_logging",
    "permits_model_context_exposure",
    "returns_secret_bytes_to_requester",
    "wildcard_destination",
    "requires_execution_time_authorization_recheck",
    "requires_revocation_check_before_use",
    "receipt_required"
  ],
  "properties": {
    "schema": {
      "const": "axiom-secret-use-grant.v1"
    },
    "grant_id": {
      "$ref": "#/$defs/id"
    },
    "principal_ref": {
      "$ref": "#/$defs/id"
    },
    "runtime_ref": {
      "$ref": "#/$defs/id"
    },
    "secret_ref_id": {
      "$ref": "#/$defs/id"
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "https-origin",
            "service-principal",
            "local-process",
            "hardware-endpoint"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "nonce_digest": {
      "$ref": "#/$defs/sha256"
    },
    "policy_decision_ref": {
      "$ref": "#/$defs/id"
    },
    "effect_grant_ref": {
      "$ref": "#/$defs/id"
    },
    "receipt_reservation_ref": {
      "$ref": "#/$defs/id"
    },
    "one_use": {
      "const": true
    },
    "delegable": {
      "const": false
    },
    "permits_reveal": {
      "const": false
    },
    "permits_export": {
      "const": false
    },
    "permits_persistence": {
      "const": false
    },
    "permits_logging": {
      "const": false
    },
    "permits_model_context_exposure": {
      "const": false
    },
    "returns_secret_bytes_to_requester": {
      "const": false
    },
    "wildcard_destination": {
      "const": false
    },
    "requires_execution_time_authorization_recheck": {
      "const": true
    },
    "requires_revocation_check_before_use": {
      "const": true
    },
    "receipt_required": {
      "const": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
