{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/context-request.v1.schema.json",
  "title": "AXIOM Context Request v1",
  "description": "Documentation-only draft for a semantic, purpose-bound request for minimum-necessary context. A Context Request is not consent, a vault selector, a vault mount, or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "owner_subject_ref",
    "requester_principal_ref",
    "recipient_principal_ref",
    "purpose",
    "task_class",
    "issued_at",
    "expires_at",
    "semantic_needs",
    "retention_request",
    "minimum_necessary_requested",
    "source_vault_selector_in_request",
    "requests_vault_mount",
    "requests_raw_vault_object",
    "grants_vault_access",
    "grants_execution_authority",
    "onward_disclosure_requested"
  ],
  "properties": {
    "schema": {
      "const": "axiom-context-request.v1"
    },
    "request_id": {
      "$ref": "#/$defs/id"
    },
    "owner_subject_ref": {
      "$ref": "#/$defs/id"
    },
    "requester_principal_ref": {
      "$ref": "#/$defs/id"
    },
    "recipient_principal_ref": {
      "$ref": "#/$defs/id"
    },
    "destination_ref": {
      "$ref": "#/$defs/id"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "task_class": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "semantic_needs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "semantic_type",
          "need",
          "required",
          "maximum_sensitivity",
          "acceptable_disclosure_modes"
        ],
        "properties": {
          "semantic_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "need": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "required": {
            "type": "boolean"
          },
          "maximum_sensitivity": {
            "$ref": "#/$defs/sensitivity"
          },
          "acceptable_disclosure_modes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "enum": [
                "transformed-constraint",
                "redacted",
                "aggregate",
                "derived-inference",
                "owner-approved-verbatim"
              ]
            }
          },
          "minimum_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "retention_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_seconds",
        "recipient_may_persist_requested"
      ],
      "properties": {
        "max_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        },
        "recipient_may_persist_requested": {
          "type": "boolean"
        },
        "retention_reason": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "requester_evidence_refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "minimum_necessary_requested": {
      "const": true
    },
    "source_vault_selector_in_request": {
      "const": false
    },
    "requests_vault_mount": {
      "const": false
    },
    "requests_raw_vault_object": {
      "const": false
    },
    "grants_vault_access": {
      "const": false
    },
    "grants_execution_authority": {
      "const": false
    },
    "onward_disclosure_requested": {
      "const": false
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    },
    "sensitivity": {
      "enum": [
        "ordinary-private",
        "sensitive",
        "restricted",
        "critical-secret"
      ]
    }
  }
}
