{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/human-sovereign-baseline.v0.schema.json",
  "title": "AXIOM Human Sovereign Baseline v0",
  "description": "Inert conformance record for minimum direct-human sovereignty independent of counterpart participation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","version","status","baseline_id","human_principal_id","node_ref","direct_identity_access","direct_inspection","direct_consent","direct_refusal","direct_revocation","direct_recovery","direct_export","direct_authority_review","counterpart_optional","counterpart_absence_preserves_human_principal","counterpart_disagreement_cannot_revoke_human_authority","counterpart_agreement_cannot_widen_human_authority","counterpart_state_not_required_for_root_identity","direct_operation_preserves_policy_checks","created_at","updated_at","authority_effect","network_effect","runtime_activation"],
  "properties": {
    "schema": {"const": "axiom-human-sovereign-baseline.v0"},
    "version": {"const": 0},
    "status": {"const": "inert-contract-laboratory"},
    "baseline_id": {"$ref": "#/$defs/id"},
    "human_principal_id": {"$ref": "#/$defs/id"},
    "node_ref": {"$ref": "#/$defs/id"},
    "direct_identity_access": {"const": true},
    "direct_inspection": {"const": true},
    "direct_consent": {"const": true},
    "direct_refusal": {"const": true},
    "direct_revocation": {"const": true},
    "direct_recovery": {"const": true},
    "direct_export": {"const": true},
    "direct_authority_review": {"const": true},
    "counterpart_optional": {"const": true},
    "counterpart_absence_preserves_human_principal": {"const": true},
    "counterpart_disagreement_cannot_revoke_human_authority": {"const": true},
    "counterpart_agreement_cannot_widen_human_authority": {"const": true},
    "counterpart_state_not_required_for_root_identity": {"const": true},
    "direct_operation_preserves_policy_checks": {"const": true},
    "created_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "updated_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "authority_effect": {"const": "none"},
    "network_effect": {"const": "none"},
    "runtime_activation": {"const": false}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"}}
}
