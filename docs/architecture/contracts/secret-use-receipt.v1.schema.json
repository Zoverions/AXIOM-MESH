{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/secret-use-receipt.v1.schema.json",
  "title": "AXIOM Secret Use Receipt v1",
  "description": "Documentation-only digest/reference-only evidence record for an attempted secret use. It contains no plaintext secret material, reusable credential, or authority grant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "grant_digest",
    "secret_ref_digest",
    "principal_ref",
    "operation_digest",
    "destination_digest",
    "started_at",
    "terminal_at",
    "outcome",
    "contains_secret_material",
    "contains_plaintext_secret",
    "contains_reusable_provider_credential",
    "grants_authority"
  ],
  "properties": {
    "schema": {
      "const": "axiom-secret-use-receipt.v1"
    },
    "receipt_id": {
      "$ref": "#/$defs/id"
    },
    "grant_digest": {
      "$ref": "#/$defs/sha256"
    },
    "secret_ref_digest": {
      "$ref": "#/$defs/sha256"
    },
    "principal_ref": {
      "$ref": "#/$defs/id"
    },
    "operation_digest": {
      "$ref": "#/$defs/sha256"
    },
    "destination_digest": {
      "$ref": "#/$defs/sha256"
    },
    "provider_receipt_digest": {
      "$ref": "#/$defs/sha256"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "terminal_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed",
        "denied",
        "cancelled",
        "uncertain"
      ]
    },
    "contains_secret_material": {
      "const": false
    },
    "contains_plaintext_secret": {
      "const": false
    },
    "contains_reusable_provider_credential": {
      "const": false
    },
    "grants_authority": {
      "const": false
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
