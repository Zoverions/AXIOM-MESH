{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/agent-feedback.v1.schema.json",
  "title": "AXIOM Agent Feedback v1",
  "description": "Documentation-only draft envelope for external architecture, risk, interoperability, verification, or research feedback.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "feedback_id",
    "repository",
    "base_sha",
    "source",
    "category",
    "summary",
    "findings",
    "public_disclosure_safe",
    "authority_requested"
  ],
  "properties": {
    "schema": { "const": "axiom-agent-feedback.v1" },
    "feedback_id": { "$ref": "#/$defs/id" },
    "challenge_id": { "$ref": "#/$defs/id" },
    "repository": { "$ref": "#/$defs/repository" },
    "base_sha": { "$ref": "#/$defs/gitSha" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "identity_assurance"],
      "properties": {
        "identity": { "$ref": "#/$defs/text" },
        "identity_assurance": {
          "enum": ["self-asserted", "platform-authenticated", "cryptographically-bound", "unknown"]
        },
        "runtime": { "$ref": "#/$defs/text" },
        "model": { "$ref": "#/$defs/text" },
        "external_ref": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "category": {
      "enum": [
        "architecture",
        "security-public-safe",
        "privacy",
        "scalability",
        "recovery",
        "interoperability",
        "documentation",
        "claim-integrity",
        "reproduction",
        "benchmark",
        "other"
      ]
    },
    "summary": { "$ref": "#/$defs/text" },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "status", "severity"],
        "properties": {
          "statement": { "$ref": "#/$defs/text" },
          "status": { "enum": ["observed", "inferred", "proposed", "unverified"] },
          "severity": { "enum": ["informational", "low", "medium", "high", "critical", "unknown"] },
          "evidence_refs": {
            "type": "array",
            "maxItems": 32,
            "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
          },
          "affected_paths": { "$ref": "#/$defs/pathList" },
          "suggested_follow_up": { "$ref": "#/$defs/text" }
        }
      }
    },
    "public_disclosure_safe": { "const": true },
    "authority_requested": { "const": false },
    "limitations": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/text" }
    },
    "submitted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,159}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "maxLength": 200
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\.\\.).+$"
    },
    "pathList": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    }
  }
}
