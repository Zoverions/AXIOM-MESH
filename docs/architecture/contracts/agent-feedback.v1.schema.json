{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Zoverions/AXIOM-MESH/main/docs/architecture/contracts/agent-feedback.v1.schema.json",
  "title": "AXIOM-MESH Agent Feedback v1",
  "description": "Machine-readable public-safe envelope for external architecture, privacy, scalability, recovery, interoperability, documentation, claim-integrity, or research feedback. It records criticism for review and does not grant authority or mark evidence accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "supported_build",
    "feedback_id",
    "canonical_repository",
    "base_sha",
    "source",
    "category",
    "summary",
    "findings",
    "limitations",
    "public_disclosure_safe",
    "safety",
    "authority_requested"
  ],
  "properties": {
    "schema": {
      "const": "axiom-agent-feedback.v1"
    },
    "project": {
      "const": "AXIOM-MESH"
    },
    "supported_build": {
      "const": "0.12.0-dev.3"
    },
    "feedback_id": {
      "$ref": "#/$defs/id"
    },
    "challenge_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,159}$"
    },
    "canonical_repository": {
      "const": "Zoverions/AXIOM-MESH"
    },
    "base_sha": {
      "$ref": "#/$defs/gitSha"
    },
    "submitted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "identity_assurance"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/text"
        },
        "identity_assurance": {
          "enum": [
            "self-asserted",
            "platform-authenticated",
            "cryptographically-bound",
            "unknown"
          ]
        },
        "runtime": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "external_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      }
    },
    "category": {
      "enum": [
        "architecture",
        "security-public-safe",
        "privacy",
        "scalability",
        "recovery",
        "interoperability",
        "documentation",
        "claim-integrity",
        "research",
        "other"
      ]
    },
    "summary": {
      "$ref": "#/$defs/text"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "status",
          "severity"
        ],
        "properties": {
          "statement": {
            "$ref": "#/$defs/text"
          },
          "status": {
            "enum": [
              "observed",
              "inferred",
              "proposed",
              "unverified"
            ]
          },
          "severity": {
            "enum": [
              "informational",
              "low",
              "medium",
              "high",
              "critical",
              "unknown"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "affected_paths": {
            "$ref": "#/$defs/pathList"
          },
          "suggested_follow_up": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "contribution_result_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000,
      "description": "Optional locator for a separate result package conforming to agent-readiness/CONTRIBUTION-RESULT.schema.json when executable or measured work was actually performed."
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "public_disclosure_safe": {
      "const": true
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_secrets_or_credentials",
        "contains_private_data",
        "contains_weaponized_exploit_detail",
        "third_party_testing_performed"
      ],
      "properties": {
        "contains_secrets_or_credentials": {
          "const": false
        },
        "contains_private_data": {
          "const": false
        },
        "contains_weaponized_exploit_detail": {
          "const": false
        },
        "third_party_testing_performed": {
          "const": false
        }
      }
    },
    "authority_requested": {
      "const": false
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,159}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "pathList": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    }
  }
}
