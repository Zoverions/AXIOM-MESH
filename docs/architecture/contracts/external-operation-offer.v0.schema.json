{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axiom:contract:external-operation-offer:v0",
  "title": "AXIOM External Operation Offer v0",
  "description": "Structural wire schema only for the inert External Operation Offer v0. Conditional semantic invariants such as freshness-state/valid-until consistency, topology origin rules, reconciliation-path requirements, catalog-subset checks, independent effect verification, quote currentness, and spend ceilings are enforced by validateExternalOperationOffer / resolveExternalOperationOffer / evaluateExternalOperationOffer. Passing this JSON Schema alone never makes an offer eligible and never grants authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "offer_id",
    "observed_at",
    "freshness",
    "catalog_entry",
    "operation",
    "topology",
    "quote",
    "health",
    "execution_semantics",
    "evidence",
    "grants_authority",
    "execution_effect"
  ],
  "properties": {
    "schema": {
      "const": "axiom-external-operation-offer.v0"
    },
    "offer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:#/-]{0,191}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "freshness": {
      "description": "Structural shape only. Runtime semantic validation requires valid_until exactly when state=current and forbids it when state=unknown.",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "enum": ["current", "unknown"]
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "catalog_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "entry_version", "entry_digest"],
      "properties": {
        "entry_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"
        },
        "entry_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "entry_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broker_operation_id",
        "axiom_action",
        "schema_sha256",
        "provider_ref",
        "effect_class",
        "input_data_classes",
        "output_data_classes",
        "network_required",
        "description"
      ],
      "properties": {
        "broker_operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192
        },
        "axiom_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provider_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192
        },
        "effect_class": {
          "enum": [
            "read-external",
            "write-external",
            "publish-external",
            "create-external-resource",
            "delete-external-resource",
            "generate-media",
            "financial",
            "communication",
            "unknown"
          ]
        },
        "input_data_classes": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "output_data_classes": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "network_required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "Untrusted advisory text. Never participates in allow/deny authority calculation."
        }
      }
    },
    "topology": {
      "description": "Structural shape only. Runtime semantic validation enforces canonical HTTPS origins, hosted-broker destination presence, and explicit remote-provider destinations when network access is required.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broker_location",
        "broker_destination",
        "downstream_location",
        "provider_destination"
      ],
      "properties": {
        "broker_location": {
          "enum": ["hosted", "owner-local"]
        },
        "broker_destination": {
          "type": ["string", "null"],
          "maxLength": 2048
        },
        "downstream_location": {
          "enum": ["provider-remote", "owner-local", "owner-remote", "hybrid", "unknown"]
        },
        "provider_destination": {
          "type": ["string", "null"],
          "maxLength": 2048
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "currency",
        "quoted_amount_minor_units",
        "max_amount_minor_units",
        "pricing_unit",
        "valid_until"
      ],
      "properties": {
        "kind": {
          "enum": ["free", "exact", "bounded", "variable", "unknown"]
        },
        "currency": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{3}$"
        },
        "quoted_amount_minor_units": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "max_amount_minor_units": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "pricing_unit": {
          "enum": ["call", "result", "character", "second", "token", "other"]
        },
        "valid_until": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "observed_at", "p50_ms", "p95_ms"],
      "properties": {
        "state": {
          "enum": ["available", "degraded", "unavailable", "unknown"]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "p50_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "p95_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "execution_semantics": {
      "description": "Structural shape only. Runtime semantic validation requires reconciliation_path for reconciliation=required and reconciliation=status-path.",
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ms", "cancellation", "idempotency", "reconciliation"],
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "cancellation": {
          "enum": ["best-effort", "unsupported", "cooperative", "unknown"]
        },
        "idempotency": {
          "enum": ["read-safe", "idempotent-key", "none", "unknown"]
        },
        "reconciliation": {
          "enum": ["not-required", "required", "status-path", "unknown"]
        },
        "reconciliation_path": {
          "type": ["string", "null"],
          "maxLength": 512
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_refs", "external_claim_only"],
      "properties": {
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "external_claim_only": {
          "const": true
        }
      }
    },
    "grants_authority": {
      "const": false
    },
    "execution_effect": {
      "const": "none"
    }
  }
}