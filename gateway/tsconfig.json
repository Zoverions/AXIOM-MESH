{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "src/**/*",
    "../testing/**/*"
  ]
}
