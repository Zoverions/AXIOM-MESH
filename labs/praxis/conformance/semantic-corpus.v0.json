  "compile_cases": [
    {
      "name": "valid-authorized-commit",
      "source": "requires permit p: Deploy @ Production;\nop release = Deploy(\"artifact\") @ Production;\nauthorize release using p as armed;\nprepare armed as prepared;\ncommit prepared as receipt;",
      "expect": {
        "ok": true,
        "instruction_ops": [
          "REQUIRE_PERMIT",
          "PLAN",
          "AUTHORIZE",
          "PREPARE",
          "COMMIT"
        ]
      }
    },
    {
      "name": "valid-lease-authorization",
      "source": "requires lease window: Deploy @ Production;\nop release = Deploy(\"artifact\") @ Production;\nauthorize release using window as armed;",
      "expect": {
        "ok": true,
        "instruction_ops": [
          "REQUIRE_LEASE",
          "PLAN",
          "AUTHORIZE"
        ]
      }
    },
    {
      "name": "knowledge-cannot-authorize",
      "source": "observe fact = \"safe\" from \"fixture\";\nop release = Deploy(fact) @ Production;\nauthorize release using fact as armed;",
      "expect": {
        "ok": false,
        "code": "PRAXIS_AUTHORIZE_REQUIRES_PERMIT"
      }
    },
    {
      "name": "identity-value-cannot-authorize",
      "source": "observe identity = \"agent:alice\" from \"identity-directory\";\nop release = Deploy(\"artifact\") @ Production;\nauthorize release using identity as armed;",
      "expect": {
        "ok": false,
        "code": "PRAXIS_AUTHORIZE_REQUIRES_PERMIT"
      }
    },
    {
      "name": "discovery-value-cannot-authorize",
      "source": "observe discovered = \"service:deploy\" from \"discovery\";\nop release = Deploy(\"artifact\") @ Production;\nauthorize release using discovered as armed;",
      "expect": {
        "ok": false,
        "code": "PRAXIS_AUTHORIZE_REQUIRES_PERMIT"
      }
    },
    {
      "name": "assessment-cannot-authorize",
      "source": "observe evidence = \"safe\" from \"fixture\";\nassess consensus = evidence with CollectiveReview;\nop release = Deploy(evidence) @ Production;\nauthorize release using consensus as armed;",
      "expect": {
        "ok": false,
        "code": "PRAXIS_AUTHORIZE_REQUIRES_PERMIT"
      }
    },
    {
      "name": "planned-operation-cannot-authorize-another-operation",
      "source": "op plan = Plan(\"x\") @ Production;\nop release = Deploy(\"artifact\") @ Production;\nauthorize release using plan as armed;",
      "expect": {
        "ok": false,
        "code": "PRAXIS_AUTHORIZE_REQUIRES_PERMIT"
      }
    },
    {
      "name": "commit-requires-durable-preparation",
      "source": "requires permit p: Deploy @ Production;\nop release = Deploy(\"artifact\") @ Production;\nauthorize release using p as armed;\ncommit armed as receipt;",
      "expect": {
        "ok": false,
        "code": "PRAXIS_COMMIT_REQUIRES_PREPARATION"
      }
    },
    {
      "name": "action-substitution-denied",
      "source": "requires permit p: Restart @ Production;\nop release = Deploy(\"artifact\") @ Production;\nauthorize release using p as armed;",
      "expect": {
        "ok": false,
        "code": "PRAXIS_AUTHORITY_MISMATCH"
      }
    },
    {
      "name": "scope-substitution-denied",
      "source": "requires permit p: Deploy @ Staging;\nop release = Deploy(\"artifact\") @ Production;\nauthorize release using p as armed;",
      "expect": {
        "ok": false,
        "code": "PRAXIS_AUTHORITY_MISMATCH"
      }
    },
    {
      "name": "linear-permit-reuse-denied",
      "source": "requires permit p: Deploy @ Production;\nop first = Deploy(\"a\") @ Production;\nop second = Deploy(\"b\") @ Production;\nauthorize first using p as first_armed;\nauthorize second using p as second_armed;",
      "expect": {
        "ok": false,
        "code": "PRAXIS_LINEAR_AUTHORITY_REUSE"
      }
    },
    {
      "name": "authority-smuggling-denied",
      "source": "requires permit p: Deploy @ Production;\nop leak = Log(p) @ Audit;",
      "expect": {
        "ok": false,
        "code": "PRAXIS_AUTHORITY_EXFILTRATION"
      }
    },
    {
      "name": "permit-cannot-be-reobserved-as-knowledge",
      "source": "requires permit p: Deploy @ Production;\nobserve leaked = p from \"self\";",
      "expect": {
        "ok": false,
        "code": "PRAXIS_INFORMATION_FLOW_VIOLATION"
      }
    },
    {
      "name": "verify-requires-evidence",
      "source": "op plan = Plan(\"x\") @ Local;\nverify proof = plan with Policy;",
      "expect": {
        "ok": false,
        "code": "PRAXIS_VERIFY_REQUIRES_EVIDENCE"
      }
    },
    {
      "name": "duplicate-binding-denied",
      "source": "observe x = 1 from \"a\";\nobserve x = 2 from \"b\";",
      "expect": {
        "ok": false,
        "code": "PRAXIS_DUPLICATE_BINDING"
      }
    },
    {
      "name": "secret-reference-cannot-be-ordinary-argument",
      "source": "requires secret key: SigningCredential;\nop leak = Log(key) @ Audit;",
      "expect": {
        "ok": false,
        "code": "PRAXIS_SECRET_EXFILTRATION"
      }
    },
    {
      "name": "valid-opaque-secret-binding",
      "source": "requires secret key: SigningCredential;\nop sign = Sign(\"digest\") @ Local using secrets key;",
      "expect": {
        "ok": true,
        "instruction_ops": [
          "REQUIRE_SECRET",
          "PLAN"
        ]
      }
    },
    {
      "name": "valid-imported-prepared-commit",
      "source": "requires prepared prior: Deploy @ Production;\ncommit prior as receipt;",
      "expect": {
        "ok": true,
        "instruction_ops": [
          "REQUIRE_PREPARED",
          "COMMIT"
        ]
      }
    },
    {
      "name": "valid-prepared-cancellation",
      "source": "requires prepared prior: Deploy @ Production;\ncancel prior as canceled;",
      "expect": {
        "ok": true,
        "instruction_ops": [
          "REQUIRE_PREPARED",
          "CANCEL"
        ]
      }
    },
    {
      "name": "prepared-terminal-transition-is-linear",
      "source": "requires prepared prior: Deploy @ Production;\ncancel prior as canceled;\ncommit prior as receipt;",
      "expect": {
        "ok": false,
        "code": "PRAXIS_LINEAR_OPERATION_REUSE"
      }
    },
    {
      "name": "valid-explicit-quorum-authority",
      "source": "requires quorum gate: Deploy @ Production threshold 2 of Operator, Security, Provider;\nop release = Deploy(\"artifact\") @ Production;\nauthorize release using gate as armed;",
      "expect": {
        "ok": true,
        "instruction_ops": [
          "REQUIRE_QUORUM",
          "PLAN",
          "AUTHORIZE"
        ]
      }
    },
    {
      "name": "invalid-quorum-threshold",
      "source": "requires quorum gate: Deploy @ Production threshold 3 of Operator, Security;",
      "expect": {
        "ok": false,
        "code": "PRAXIS_INVALID_QUORUM"
      }
    }
