# ============================================================================
# AXIOM-MESH Service Configuration
# ============================================================================
# Copy this file to .env and fill in your actual configuration values

# Gateway Service (TypeScript/Node.js)
GATEWAY_REST_PORT=3000
GATEWAY_WS_PORT=3001
GATEWAY_HOST=0.0.0.0
GATEWAY_API_KEY=your_api_key_here
GATEWAY_INTERNAL_SECRET=your_gateway_internal_secret_here

# Hypervisor Service (Python - AI Orchestration)
HYPERVISOR_API_KEY=your_secure_hypervisor_key_here
HYPERVISOR_PORT=8000
HYPERVISOR_HOST=0.0.0.0
HYPERVISOR_URL=http://localhost:8000

# Sandbox Service (TypeScript - Isolated Execution)
SANDBOX_PORT=4000
SANDBOX_HOST=0.0.0.0
SANDBOX_URL=http://localhost:4000
SANDBOX_APPARMOR_PROFILE=axiom-sandbox
SANDBOX_SECCOMP_PROFILE=./sandbox/security/seccomp-default.json

# Grid Service (Go - Ledger & P2P)
GRID_PORT=5000
GRID_WS_URL=ws://localhost:5000
GRID_HOST=0.0.0.0
GRID_URL=http://localhost:5000
GRID_STAKE_URL=http://localhost:5000/stake
GRID_ZKML_URL=http://localhost:5000/zkml/verify

# ============================================================================
# External Services & APIs
# ============================================================================

# IPFS Configuration (for decentralized data storage)
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080
IPFS_HOST=ipfs
IPFS_PORT=5001

MESHSTORE_QUOTA_GB=50   # auto-set by CLI; edge=10, gpu=200

# Arweave Configuration (for permanent archival)
ARWEAVE_API_URL=https://arweave.net
ARWEAVE_KEY_FILE=./arweave-key.json
# Arweave key path or content; obtain from https://arweave.app

# Chainlink Oracle Configuration (for external data)
ORACLE_ENDPOINT=https://oracle.chainlink.example.com
ORACLE_API_KEY=your_oracle_api_key

# ============================================================================
# AI & LLM Configuration
# ============================================================================

# LLM Provider (openai, anthropic, huggingface, local)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# OR for Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...

# Cortex & Agent Configuration
CORTEX_TEMPERATURE=0.7
CORTEX_MAX_TOKENS=4096

# ============================================================================
# Channel Integrations (Communication Adapters)
# ============================================================================

# Discord Integration
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_GUILD_ID=your_discord_guild_id

# Slack Integration
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=your_signing_secret

# Telegram Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# WhatsApp Integration
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_ID=your_phone_id
WHATSAPP_ACCESS_TOKEN=your_access_token

# ============================================================================
# ZK-ML Configuration
# ============================================================================

# ZK Proof Verification Keys
ZKML_VKEY_PATH=./grid/contracts/vkeys/
ZKML_PROVING_MODE=development  # or 'production' for real proofs

# ============================================================================
# MCP (Model Context Protocol) Configuration
# ============================================================================

# MCP Servers configuration
MCP_SERVER_PORT=8081
MCP_SERVERS=["axiom-mesh-server"]
AXIOM_MESH_MCP_STDIO=true

# ============================================================================
# Database & Storage
# ============================================================================

# In-memory ledger (development) or persistent DB (production)
LEDGER_TYPE=memory  # or 'sqlalchemy' / 'postgresql'
# LEDGER_DB_URL=postgresql://user:password@localhost:5432/axiom_ledger

# ============================================================================
# Logging & Monitoring
# ============================================================================

LOG_LEVEL=info  # debug, info, warning, error, critical
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================================================
# Security & Treasury
# ============================================================================

# Treasury Fund Configuration
NETWORK_SECURITY_FUND_RATIO=0.60
WEALTH_GENERATION_POOL_RATIO=0.40

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Firewall & Access Control
ENABLE_FIREWALL=true
ALLOWED_ORIGINS=localhost:3000,example.com

# ============================================================================
# Feature Flags
# ============================================================================

ENABLE_AUTORESEARCH=true
ENABLE_DISTRIBUTED_ARCHIVE=true
ENABLE_CONSENSUS_MODE=true
ENABLE_OFFLINE_MODE=false  # Set to true for testing offline scenarios


# Grid on-chain ComputeBond integration (optional)
GRID_ETH_RPC_URL=http://127.0.0.1:8545
GRID_ETH_CHAIN_ID=31337
GRID_ETH_PRIVATE_KEY=
GRID_COMPUTE_BOND_ADDRESS=

# Inference Orchestration (v15.5.3)
INFERENCE_PROVIDERS=grok,openai,mcp-infer
MIN_SWARM_DEVICES=2
EXTERNAL_INFERENCE_ENABLED=true
