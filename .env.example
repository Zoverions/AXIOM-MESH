# Supported clean-kernel configuration
NODE_ENV=production
AXIOM_AUTO_BOOTSTRAP=false
AXIOM_DATA_DIR=/var/lib/axiom-mesh
AXIOM_GATEWAY_HOST=127.0.0.1
AXIOM_INTERNAL_HOST=127.0.0.1
AXIOM_GATEWAY_PORT=8080
AXIOM_HYPERVISOR_PORT=8081
AXIOM_SANDBOX_PORT=8082
AXIOM_GRID_PORT=8083
AXIOM_HYPERVISOR_URL=http://127.0.0.1:8081
AXIOM_SANDBOX_URL=http://127.0.0.1:8082
AXIOM_GRID_URL=http://127.0.0.1:8083
AXIOM_POLICY_PATHS=["/etc/axiom-mesh/policy.json"]
AXIOM_API_TOKENS_FILE=/run/secrets/api-tokens.json
AXIOM_DATA_KEY_FILE=/run/secrets/data-protection.key
AXIOM_LOG_REQUESTS=true
