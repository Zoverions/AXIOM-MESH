{
  "schema": "axiom-institutional-pattern-package.v1",
  "package_id": "pattern:appointment-credential-review-cycle",
  "version": "0.1.0",
  "title": "Appointment, credential, decision, and review cycle",
  "provenance": {
    "author": "AXIOM-MESH project",
    "source": "repository-local experimental package",
    "license": "Apache-2.0"
  },
  "applicability": {
    "domains": [
      "associations_and_businesses",
      "education",
      "government",
      "machine_organizations",
      "research"
    ],
    "jurisdiction": "unspecified-local-adaptation-required",
    "assumptions": [
      "local authority sources are defined outside this package",
      "effect admission is handled by the local authority path"
    ]
  },
  "primitives": [
    "relationship",
    "role_or_office",
    "term_or_appointment",
    "credential",
    "proposal_or_request",
    "approval_or_decision",
    "evidence_or_attestation",
    "challenge_or_appeal",
    "succession_or_recovery",
    "effect_admission"
  ],
  "workflow": [
    {"step":"establish_relationship","primitive":"relationship"},
    {"step":"record_office","primitive":"role_or_office"},
    {"step":"bind_current_occupant","primitive":"term_or_appointment"},
    {"step":"present_or_issue_credential","primitive":"credential"},
    {"step":"submit_request","primitive":"proposal_or_request"},
    {"step":"record_decision","primitive":"approval_or_decision"},
    {"step":"bind_evidence","primitive":"evidence_or_attestation"},
    {"step":"permit_challenge","primitive":"challenge_or_appeal"},
    {"step":"handle_vacancy_or_recovery","primitive":"succession_or_recovery"},
    {"step":"reenter_local_authority_path","primitive":"effect_admission"}
  ],
  "local_adaptation_required": true,
  "simulation_required_before_live_adoption": true,
  "authority": {
    "import_grants_authority": false,
    "installation_grants_authority": false,
    "pattern_role_grants_authority": false,
    "credential_grants_authority": false,
    "collective_result_grants_authority": false,
    "effect_requires_local_admission": true,
    "authority_effect": "none"
  },
  "limitations": [
    "This package carries no legal meaning by itself.",
    "Domain-specific rights, duties, retention, accessibility, privacy, appeal, and assurance rules must be supplied locally.",
    "A package signature would establish provenance/integrity only, not institutional approval."
  ]
}
