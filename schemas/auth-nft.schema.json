{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://axiommesh.io/schemas/auth-nft.schema.json",
  "title": "AuthorizationNFT",
  "description": "Schema for Authorization NFT metadata.",
  "type": "object",
  "properties": {
    "tokenId": { "type": "string" },
    "holder": { "type": "string" },
    "dataCID": { "type": "string" },
    "clarityLevel": { "type": "string", "enum": ["obfuscated", "partial", "full"] }
  },
  "required": ["tokenId", "holder", "dataCID", "clarityLevel"],
  "additionalProperties": false
}