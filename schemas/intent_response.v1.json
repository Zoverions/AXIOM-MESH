{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://axiommesh.io/schemas/intent_response.v1.json",
  "title": "IntentResponse",
  "description": "Represents the response sent from the Hypervisor back to the Gateway.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the response."
    },
    "intent_id": {
      "type": "string",
      "description": "The unique identifier of the original intent."
    },
    "response": {
      "type": "string",
      "description": "The textual response from the Hypervisor."
    },
    "status": {
      "type": "string",
      "enum": ["success", "error", "pending"],
      "description": "The processing status."
    },
    "confidence": {
      "type": "number",
      "description": "Model confidence score for the response."
    },
    "provenance": {
      "type": "array",
      "items": { 
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": ["graphify", "xmcp", "manual", "inferred"],
            "description": "Source system for this provenance entry"
          },
          "xurl": {
            "type": "string",
            "description": "X URL pattern used for XMCP-sourced data"
          },
          "tool_name": {
            "type": "string",
            "description": "MCP tool name (e.g., search_posts, get_user_info)"
          },
          "tool_call": {
            "type": "string",
            "description": "Deprecated alias for tool_name"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO8601 timestamp of data fetch"
          },
          "cached": {
            "type": "boolean",
            "description": "Whether this was served from semantic cache"
          },
          "cache_hit": {
            "type": "boolean",
            "description": "Deprecated alias for cached"
          },
          "edge_type": {
            "type": "string",
            "enum": ["EXTRACTED", "INFERRED", "AMBIGUOUS"],
            "description": "Confidence level for graph edges"
          }
        },
        "required": ["source"]
      },
      "description": "Data/model provenance sources with XMCP support"
    },
    "trace_id": {
      "type": "string",
      "description": "Trace identifier for end-to-end observability."
    },
    "intent_type": {
      "type": "string",
      "enum": ["GOV_MINT_CITIZENSHIP", "MEMORY_VAULT_ACCESS"],
      "description": "Type of intent if applicable."
    }
  },
  "required": ["id", "intent_id", "response", "status"],
  "additionalProperties": false
}
