{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "mcp_compatibility_matrix.v1",
  "title": "MCPCompatibilityMatrix",
  "description": "Minimum compatibility policy for MCP peer classes and risk/security thresholds.",
  "type": "object",
  "required": ["version", "default_policy", "peer_classes"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "default_policy": {
      "type": "string",
      "enum": ["deny", "allow_with_review", "allow"]
    },
    "peer_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "peer_class",
          "min_security_profile",
          "max_risk_tier",
          "required_capabilities",
          "policy"
        ],
        "properties": {
          "peer_class": {
            "type": "string",
            "pattern": "^[a-z0-9_:-]{2,64}$"
          },
          "min_security_profile": {
            "type": "string",
            "enum": ["S0_LEGACY_LOCKED", "S1_BASELINE", "S2_HARDENED", "S3_ZKML_FULL_NODE"]
          },
          "max_risk_tier": {
            "type": "string",
            "enum": ["R0", "R1", "R2", "R3", "R4"]
          },
          "required_capabilities": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 128 },
            "uniqueItems": true
          },
          "policy": {
            "type": "string",
            "enum": ["deny", "allow_with_review", "allow"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
