{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "capsule_fragment.v1",
  "title": "CapsuleFragment",
  "type": "object",
  "required": [
    "public_fragment"
  ],
  "properties": {
    "public_fragment": {
      "type": "object",
      "required": [
        "interface_schema",
        "zk_snark_circuit"
      ],
      "properties": {
        "interface_schema": {
          "type": "object",
          "description": "Interface schema describing inputs and outputs"
        },
        "zk_snark_circuit": {
          "type": "string",
          "description": "zk-SNARK circuit proving verifiable execution"
        }
      },
      "additionalProperties": false
    },
    "private_fragment": {
      "type": "object",
      "required": [
        "encrypted_logic",
        "decryption_setup"
      ],
      "properties": {
        "encrypted_logic": {
          "type": "string",
          "description": "Encrypted agent-specific logic"
        },
        "decryption_setup": {
          "type": "string",
          "description": "Decryption derivation setup derived from ComputeBond + node DID"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
