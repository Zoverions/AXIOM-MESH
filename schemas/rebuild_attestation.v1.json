{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "rebuild_attestation.v1",
  "title": "RebuildAttestation",
  "type": "object",
  "required": [
    "capsule_id",
    "mode",
    "compiler_version",
    "changes",
    "compiled_at"
  ],
  "properties": {
    "capsule_id": { "type": "string", "minLength": 3 },
    "mode": {
      "type": "string",
      "enum": ["rewrite", "rebuild"]
    },
    "compiler_version": { "type": "string", "minLength": 1 },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component", "action", "reason"],
        "properties": {
          "component": { "type": "string" },
          "action": {
            "type": "string",
            "enum": ["replace_io", "drop_dependency", "reimplement", "policy_wrap", "sandbox_only"]
          },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "security_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "summary"],
        "properties": {
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "summary": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "compiled_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
