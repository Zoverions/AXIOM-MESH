{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Universal Distribution Intent",
  "type": "object",
  "properties": {
    "intentType": { "enum": ["DISTRIBUTION_PAYROLL", "DISTRIBUTION_UBI", "DIRECT_DONATION"] },
    "from": { "type": "string" },
    "amount": { "type": "integer" },
    "source": { "enum": ["business-payroll", "gov-benefits", "direct-donation", "org-grant"] },
    "recipientList": { "type": "array", "items": { "type": "object" } },
    "zkProofHash": { "type": "string" }
  },
  "required": ["intentType", "amount"]
}