{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "source_descriptor.v1",
  "title": "SourceDescriptor",
  "type": "object",
  "required": ["source_type", "source_ref", "immutable_digest", "captured_at"],
  "properties": {
    "source_type": {
      "type": "string",
      "enum": ["git", "registry", "mcp", "service_api", "internal"]
    },
    "source_ref": { "type": "string", "minLength": 1 },
    "immutable_digest": { "type": "string", "minLength": 8 },
    "captured_at": { "type": "string", "format": "date-time" },
    "upstream_signature": {
      "type": "object",
      "properties": {
        "present": { "type": "boolean" },
        "algorithm": { "type": "string" },
        "key_id": { "type": "string" },
        "valid": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "declared_authority": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "tool_exec",
          "data_read",
          "data_write",
          "governance",
          "verification"
        ]
      }
    }
  },
  "additionalProperties": false
}
