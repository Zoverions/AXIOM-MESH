{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Autonomous Model Training Intent",
  "type": "object",
  "properties": {
    "intentType": { "type": "string", "enum": ["MODEL_AUTO_TRAIN", "RESOURCE_ALLOCATE"] },
    "purpose": { "type": "string", "enum": ["security", "zkml-optimizer", "performance", "governance", "custom"] },
    "taskPurpose": { "enum": ["security", "environmental-stewardship", "robot-workforce", "supply-chain", "governance"] },
    "minTreasuryThreshold": { "type": "integer", "minimum": 0 },
    "minPoERThreshold": { "type": "integer", "minimum": 0 },
    "datasetSource": { "type": "string", "enum": ["grid", "private-vault", "external-approved"] },
    "targetEpochs": { "type": "integer", "default": 10 },
    "zkProofRequired": { "type": "boolean", "default": true },
    "amount": { "type": "integer" }
  },
  "required": ["intentType"]
}
