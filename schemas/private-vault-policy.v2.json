{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://axiommesh.io/schemas/private-vault-policy.v2.json",
  "title": "Private Vault Policy",
  "description": "ACL schema for private memory vault.",
  "type": "object",
  "properties": {
    "ownerDID": { "type": "string" },
    "allowedSubAgents": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expiry": { "type": "integer" },
    "readOnlySummaryOnly": { "type": "boolean" }
  },
  "required": ["ownerDID", "allowedSubAgents", "expiry", "readOnlySummaryOnly"],
  "additionalProperties": false
}
