{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "alignment_profile.v1",
  "title": "AlignmentProfile",
  "description": "User or agent alignment profile controlling risk tolerance and policy priorities.",
  "type": "object",
  "required": [
    "profile_id",
    "subject_did",
    "version",
    "goals",
    "traits",
    "characteristics",
    "risk_tolerance",
    "priority_tags",
    "created_at"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{8,128}$"
    },
    "subject_did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[A-Za-z0-9._:%-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "traits": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "characteristics": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "risk_tolerance": {
      "type": "string",
      "enum": ["minimal", "conservative", "balanced", "assertive", "experimental"]
    },
    "priority_tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 64 },
      "uniqueItems": true
    },
    "constraints": {
      "type": "object",
      "properties": {
        "max_external_action_level": {
          "type": "string",
          "enum": ["deny", "observe_only", "approval_required", "autonomous"]
        },
        "allowed_peer_classes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
