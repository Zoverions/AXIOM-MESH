#include <tunables/global>

profile axiom-sandbox flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  # Allow basic execution
  /bin/** rix,
  /usr/bin/** rix,
  /lib/** rm,
  /usr/lib/** rm,

  # Allow python and node execution
  /usr/local/bin/python3* rix,
  /usr/local/bin/node rix,

  # Deny all network access (sandbox should be offline)
  deny network raw,
  deny network packet,
  deny network inet,
  deny network inet6,

  # Deny access to sensitive files
  deny /etc/passwd r,
  deny /etc/shadow r,
  deny /etc/group r,

  # Deny mounting
  deny mount,
  deny umount,
  deny pivot_root,

  # Deny ptracing
  deny ptrace,

  # Restrict /proc access
  deny /proc/kcore rw,
  deny /proc/sysrq-trigger rw,
  deny /proc/bus/** rw,

  # Allow /tmp usage
  /tmp/** rw,
}