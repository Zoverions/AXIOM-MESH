{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "executive-telemetry.schema.json",
  "title": "Executive Telemetry Schema",
  "type": "object",
  "required": ["timestamp", "metrics"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "analysis_time": { "type": "number" },
        "confidence_score": { "type": "number" },
        "strategic_value": { "type": "number" }
      },
      "required": ["analysis_time", "confidence_score", "strategic_value"]
    }
  },
  "additionalProperties": false
}
