{
  "capsule_id": "cap-health-001",
  "name": "health-longevity-capsule",
  "version": "1.0.0",
  "issuer": {
    "mesh_issuer": "hypervisor",
    "key_id": "key-001"
  },
  "capabilities": [
    "privacy-preserving-data-analysis",
    "longevity-tracking",
    "cause-and-effect-analysis",
    "quality-of-life-metrics"
  ],
  "constraints": {
    "proof_carrying_intents": true,
    "intent_canonicalization": true,
    "max_risk_score": 0.1,
    "deterministic_unit_privacy": true,
    "individual_control": true
  },
  "runtime": {
    "cpu_limit": 2.0,
    "memory_limit_mb": 1024,
    "timeout_ms": 60000
  },
  "token_policy": {
    "scope": {
      "tools": [
        "health-data-connector",
        "longevity-analyzer"
      ],
      "data": [
        "/workspace/health"
      ]
    },
    "ttl_seconds": 3600,
    "revocation_handle_required": true,
    "proof_strictness": "high"
  },
  "personality": {
    "style": "analytical-and-empathetic",
    "heuristics": [
      "maximize_privacy",
      "ensure_individual_control",
      "optimize_quality_of_life"
    ]
  }
}
