{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "telemetry.schema.json",
  "title": "GPD Telemetry Schema",
  "type": "object",
  "required": ["timestamp", "metrics"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "verification_variance": { "type": "number" },
        "constraint_slack": { "type": "number" },
        "extremal_tendency": { "type": "number" }
      },
      "required": ["verification_variance", "constraint_slack", "extremal_tendency"]
    }
  },
  "additionalProperties": false
}
