{
  "name": "crypto-operations",
  "version": "1.0.0",
  "description": "Cryptographic operations and security proofs capsule",
  "capabilities": [
    "encryption_decryption",
    "digital_signatures",
    "key_management",
    "hash_functions",
    "random_generation",
    "security_proofs"
  ],
  "runtime_requirements": {
    "cpu_cores": 1,
    "memory_gb": 2,
    "gpu_required": false,
    "max_execution_time_seconds": 120
  },
  "security_profile": {
    "isolation_level": "high_security",
    "network_access": false,
    "file_access": "none",
    "system_calls": "minimal"
  },
  "dependencies": [
    "cryptography>=41.0.0",
    "pycryptodome>=3.18.0",
    "hashlib",
    "secrets"
  ],
  "entry_point": "crypto_adapter.py",
  "schema_version": "1.0"
}