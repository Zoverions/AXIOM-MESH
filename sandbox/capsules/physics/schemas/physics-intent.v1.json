{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-mesh.org/schemas/physics-intent.v1.json",
  "title": "Physics Research Intent Schema",
  "description": "Schema for physics research and computation intents",
  "type": "object",
  "properties": {
    "operation": {
      "type": "string",
      "enum": ["simulate", "analyze", "solve", "visualize"],
      "description": "The primary physics operation to perform"
    },
    "domain": {
      "type": "string",
      "enum": ["classical", "quantum", "thermo", "fluid", "em", "particle"],
      "description": "Physics domain for the computation"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "mass": {
          "type": "number",
          "minimum": 0,
          "description": "Mass in kg"
        },
        "spring_constant": {
          "type": "number",
          "minimum": 0,
          "description": "Spring constant in N/m"
        },
        "initial_displacement": {
          "type": "number",
          "description": "Initial displacement in meters"
        },
        "initial_velocity": {
          "type": "number",
          "description": "Initial velocity in m/s"
        },
        "initial_height": {
          "type": "number",
          "minimum": 0,
          "description": "Initial height in meters"
        },
        "launch_angle": {
          "type": "number",
          "minimum": 0,
          "maximum": 90,
          "description": "Launch angle in degrees"
        },
        "gravity": {
          "type": "number",
          "minimum": 0,
          "description": "Gravitational acceleration in m/s²"
        },
        "quantum_number": {
          "type": "integer",
          "minimum": 1,
          "description": "Principal quantum number"
        },
        "angular_momentum": {
          "type": "integer",
          "minimum": 0,
          "description": "Azimuthal quantum number"
        },
        "magnetic": {
          "type": "integer",
          "description": "Magnetic quantum number"
        },
        "atomic_number": {
          "type": "integer",
          "minimum": 1,
          "description": "Atomic number (Z)"
        },
        "temperature_1": {
          "type": "number",
          "minimum": 0,
          "description": "Initial temperature in K"
        },
        "temperature_2": {
          "type": "number",
          "minimum": 0,
          "description": "Final temperature in K"
        },
        "volume_1": {
          "type": "number",
          "minimum": 0,
          "description": "Initial volume in m³"
        },
        "volume_2": {
          "type": "number",
          "minimum": 0,
          "description": "Final volume in m³"
        },
        "moles": {
          "type": "number",
          "minimum": 0,
          "description": "Number of moles"
        },
        "gamma": {
          "type": "number",
          "minimum": 1,
          "description": "Heat capacity ratio"
        }
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "description": "Maximum number of iterations"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "description": "Numerical tolerance"
        },
        "time_limit": {
          "type": "number",
          "minimum": 1,
          "maximum": 3600,
          "description": "Time limit in seconds"
        }
      },
      "additionalProperties": true
    },
    "proof_hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["conservation_check", "dimensional_analysis", "numerical_stability"]
          },
          "property": {
            "type": "string"
          },
          "tolerance": {
            "type": "number",
            "minimum": 0
          },
          "expected_dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "method": {
            "type": "string"
          }
        },
        "required": ["type"]
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string",
            "enum": ["symbolic_solver", "numerical_simulator", "data_analyzer", "physics_plotter"]
          },
          "parameters": {
            "type": "object"
          },
          "constraints": {
            "type": "object"
          },
          "domain": {
            "type": "string"
          },
          "output_format": {
            "type": "string"
          }
        },
        "required": ["tool"]
      }
    }
  },
  "required": ["operation", "domain", "parameters"]
}