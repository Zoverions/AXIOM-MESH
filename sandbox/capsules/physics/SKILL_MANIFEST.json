{
  "name": "physics-research",
  "version": "1.0.0",
  "description": "Physics research and simulation capsule for computational physics, dynamics, and scientific modeling",
  "capabilities": [
    "dynamics_simulation",
    "quantum_mechanics",
    "thermodynamics",
    "electromagnetic_fields",
    "fluid_dynamics",
    "particle_physics"
  ],
  "runtime_requirements": {
    "cpu_cores": 2,
    "memory_gb": 4,
    "gpu_required": false,
    "max_execution_time_seconds": 300
  },
  "security_profile": {
    "isolation_level": "sandboxed",
    "network_access": false,
    "file_access": "read-only",
    "system_calls": "restricted"
  },
  "dependencies": [
    "numpy>=1.24.0",
    "scipy>=1.10.0",
    "matplotlib>=3.6.0",
    "sympy>=1.12.0"
  ],
  "entry_point": "physics_adapter.py",
  "schema_version": "1.0"
}