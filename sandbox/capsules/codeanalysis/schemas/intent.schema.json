{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "codeanalysis-intent.schema.json",
  "title": "Code Analysis Intent Schema",
  "type": "object",
  "required": ["task"],
  "properties": {
    "task": {
      "type": "string",
      "enum": ["parse", "check", "lint", "format"]
    },
    "code": {
      "type": "string"
    },
    "parameters": {
      "type": "object"
    },
    "constraints": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
