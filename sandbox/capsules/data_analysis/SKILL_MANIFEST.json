{
  "name": "data-analysis",
  "version": "1.0.0",
  "description": "Data analysis and visualization capsule for statistical computing and machine learning",
  "capabilities": [
    "statistical_analysis",
    "data_visualization",
    "machine_learning",
    "time_series_analysis",
    "regression_modeling",
    "clustering_analysis"
  ],
  "runtime_requirements": {
    "cpu_cores": 2,
    "memory_gb": 4,
    "gpu_required": false,
    "max_execution_time_seconds": 600
  },
  "security_profile": {
    "isolation_level": "sandboxed",
    "network_access": false,
    "file_access": "read-only",
    "system_calls": "restricted"
  },
  "dependencies": [
    "pandas>=2.0.0",
    "numpy>=1.24.0",
    "scipy>=1.10.0",
    "matplotlib>=3.6.0",
    "seaborn>=0.12.0",
    "scikit-learn>=1.3.0"
  ],
  "entry_point": "data_analysis_adapter.py",
  "schema_version": "1.0"
}