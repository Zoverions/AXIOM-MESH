{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://axiom-mesh.io/sandbox/capsules/government/us/schemas/proposal_us.schema.json",
  "title": "US Government Proposal Schema",
  "description": "Schema for government resource allocation proposals submitted by US citizens or their agent representatives, aligned with federal and state overlays.",
  "type": "object",
  "required": [
    "title",
    "description",
    "jurisdiction",
    "requestedAmount",
    "category",
    "proposer"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Short descriptive title of the proposal",
      "minLength": 5,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the proposal including objectives and expected outcomes",
      "minLength": 50,
      "maxLength": 10000
    },
    "jurisdiction": {
      "type": "string",
      "enum": ["Federal", "State"],
      "description": "Jurisdiction scope: Federal or State"
    },
    "state": {
      "type": "string",
      "description": "If Jurisdiction is State, the 2-letter state code",
      "minLength": 2,
      "maxLength": 2
    },
    "category": {
      "type": "string",
      "description": "Category of the proposal",
      "enum": [
        "infrastructure",
        "healthcare",
        "education",
        "public_safety",
        "environment",
        "social_services",
        "technology",
        "economic_development",
        "culture",
        "other"
      ]
    },
    "requestedAmount": {
      "type": "number",
      "description": "Amount of funding requested",
      "minimum": 0.0001,
      "exclusiveMinimum": true
    },
    "token": {
      "type": "string",
      "description": "Token address for funding (0x0 for native token)",
      "pattern": "^0x[a-fA-F0-9]{40}$|^0x0$"
    },
    "proposer": {
      "type": "object",
      "required": ["address", "type"],
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$",
          "description": "Address of the proposer (citizen or agent)"
        },
        "type": {
          "type": "string",
          "enum": ["citizen", "agent", "organization"],
          "description": "Type of proposer"
        },
        "agentId": {
          "type": "string",
          "description": "If proposer is an agent, the agent identifier"
        },
        "organizationId": {
          "type": "string",
          "description": "If proposer is an organization, the organization identifier"
        }
      }
    }
  }
}
