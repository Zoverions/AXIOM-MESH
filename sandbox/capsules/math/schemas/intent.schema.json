{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "math-intent.schema.json",
  "title": "Math Intent Schema",
  "type": "object",
  "required": ["task"],
  "properties": {
    "task": {
      "type": "string",
      "enum": ["solve", "simplify", "integrate", "differentiate"]
    },
    "expression": {
      "type": "string"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "variables": { "type": "array", "items": { "type": "string" } },
        "domain": { "type": "string" }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "max_time": { "type": "number" }
      }
    }
  },
  "additionalProperties": false
}