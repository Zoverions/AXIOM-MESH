{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "edu-intent.schema.json",
  "title": "Education Intent Schema",
  "type": "object",
  "required": ["task", "student_id"],
  "properties": {
    "task": {
      "type": "string",
      "enum": ["assess_maturity", "grant_badge", "dao_proposal"]
    },
    "student_id": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "parameters": {
      "type": "object"
    }
  },
  "additionalProperties": false
}