{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ontario NFT Badge Schema",
  "description": "Schema for NFT badges aligned with Ontario education credit system and EDI principles",
  "type": "object",
  "required": ["badge_id", "student_id", "badge_type", "credit_value", "issue_date"],
  "properties": {
    "badge_id": {
      "type": "string",
      "description": "Unique identifier for the NFT badge",
      "pattern": "^nft-ont-[a-zA-Z0-9]{6,12}$"
    },
    "student_id": {
      "type": "string",
      "description": "Unique identifier for the student recipient",
      "pattern": "^stu-[a-zA-Z0-9]{3,10}$"
    },
    "badge_type": {
      "type": "string",
      "description": "Type of educational achievement badge",
      "enum": [
        "mathematics_excellence",
        "science_innovation",
        "arts_creativity",
        "civic_engagement",
        "leadership",
        "collaboration",
        "edi_champion",
        "community_service",
        "research_excellence",
        "technical_skills"
      ]
    },
    "credit_value": {
      "type": "number",
      "description": "Ontario credit value associated with this badge",
      "minimum": 0.5,
      "maximum": 2.0,
      "multipleOf": 0.5
    },
    "level": {
      "type": "integer",
      "description": "Badge level (1-5) indicating achievement depth",
      "minimum": 1,
      "maximum": 5
    },
    "issue_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when badge was issued"
    },
    "issuer_agent": {
      "type": "string",
      "description": "ID of the AI agent or institution that issued the badge"
    },
    "metadata_uri": {
      "type": "string",
      "description": "IPFS or HTTPS URI pointing to badge metadata",
      "format": "uri"
    },
    "edi_alignment": {
      "type": "object",
      "description": "EDI (Equity, Diversity, Inclusion) alignment metrics",
      "properties": {
        "equity_considered": {
          "type": "boolean",
          "description": "Whether equity factors were considered in awarding"
        },
        "diversity_celebrated": {
          "type": "boolean",
          "description": "Whether badge celebrates diverse achievements"
        },
        "inclusive_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of inclusive criteria used for badge awarding"
        }
      },
      "required": ["equity_considered", "diversity_celebrated"]
    },
    "capabilities_unlocked": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Network capabilities unlocked by this badge",
      "examples": [
        "advanced_research",
        "dao_voting",
        "mentor_access",
        "resource_library"
      ]
    },
    "parent_approved": {
      "type": "boolean",
      "description": "Whether parent advisor has approved this badge (required for students under 18)"
    },
    "blockchain_record": {
      "type": "object",
      "description": "Blockchain attestation details",
      "properties": {
        "contract_address": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$"
        },
        "transaction_hash": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{64}$"
        },
        "token_id": {
          "type": "string"
        },
        "network": {
          "type": "string",
          "enum": ["ethereum", "polygon", "optimism", "testnet"]
        }
      },
      "required": ["contract_address", "transaction_hash", "network"]
    },
    "expiry_date": {
      "type": "string",
      "format": "date-time",
      "description": "Optional expiry date for time-limited badges"
    },
    "regional_alignment": {
      "type": "string",
      "description": "Regional curriculum alignment",
      "enum": ["Ontario, Canada", "Global"]
    }
  },
  "additionalProperties": false
}
