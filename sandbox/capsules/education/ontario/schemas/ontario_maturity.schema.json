{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ontario Maturity Assessment Schema",
  "description": "Schema for maturity assessments aligned with Ontario curriculum standards and EDI principles",
  "type": "object",
  "required": ["student_id", "maturity_level", "assessment_date", "regional_alignment"],
  "properties": {
    "student_id": {
      "type": "string",
      "description": "Unique identifier for the student",
      "pattern": "^stu-[a-zA-Z0-9]{3,10}$"
    },
    "maturity_level": {
      "type": "integer",
      "description": "Maturity level (1-5) based on Ontario educational standards",
      "minimum": 1,
      "maximum": 5
    },
    "emotional_intelligence_score": {
      "type": "number",
      "description": "Emotional intelligence assessment score (0.0-10.0)",
      "minimum": 0.0,
      "maximum": 10.0
    },
    "self_directed_learning_readiness": {
      "type": "boolean",
      "description": "Whether student demonstrates readiness for self-directed learning"
    },
    "regional_alignment": {
      "type": "string",
      "description": "Regional curriculum alignment",
      "enum": ["Ontario, Canada", "Global"]
    },
    "cultural_adjustments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Cultural adjustments applied to assessment"
    },
    "edi_compliance": {
      "type": "object",
      "description": "EDI (Equity, Diversity, Inclusion) compliance metrics",
      "properties": {
        "equity_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "diversity_considered": {
          "type": "boolean"
        },
        "inclusion_measures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["equity_score", "diversity_considered"]
    },
    "assessment_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of assessment"
    },
    "assessor_agent": {
      "type": "string",
      "description": "ID of the AI agent that performed the assessment"
    },
    "parent_reviewed": {
      "type": "boolean",
      "description": "Whether parent advisor has reviewed this assessment"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Educational recommendations based on assessment"
    }
  },
  "additionalProperties": false
}
