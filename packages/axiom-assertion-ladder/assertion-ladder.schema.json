{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.local/schemas/assertion-ladder.v1.json",
  "title": "AXIOM Assertion Ladder v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ladder_id", "version", "states"],
  "properties": {
    "schema": { "const": "axiom-assertion-ladder.v1" },
    "ladder_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rank"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 0 },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "terminal": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "failure_states": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
